---
import { AUTHOR, FEATURES } from '../config';
const year = new Date().getFullYear();
const gc = FEATURES.goatcounter;
const cfOn = Boolean(FEATURES.cloudflareAnalytics?.beaconToken);
const cfHelp = 'https://developers.cloudflare.com/web-analytics/data-metrics/high-level-metrics/';
const gcSessionsHelp = 'https://www.goatcounter.com/help/sessions';
---

<footer class="site-footer">
  <div class="container">
    <p class="muted">
      &copy; {year} {AUTHOR.nameZh} ({AUTHOR.name})
      <span data-l="zh"> · 使用 </span><span data-l="en"> · Built with </span>
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
      <span class="site-stats" data-gc={gc || ''} data-cf={cfOn ? '1' : ''} hidden>
        <span data-l="zh" class="ss-cf" hidden>
          · <a class="stats-src" href={cfHelp} target="_blank" rel="noopener noreferrer">Cloudflare</a>
          累计访问 <b class="ss-pageviews">–</b> · 累计访客 <b class="ss-visits">–</b>
          <span class="stats-note">（自建累加，自 <b class="ss-since">–</b> 起；每周日 23:59 北京时间收集本周并入档；访问=每次打开/刷新，访客=CF Visit）</span>
        </span>
        <span data-l="en" class="ss-cf" hidden>
          · <a class="stats-src" href={cfHelp} target="_blank" rel="noopener noreferrer">Cloudflare</a>
          <b class="ss-pageviews">–</b> views · <b class="ss-visits">–</b> visits cumulative
          <span class="stats-note"> (self-summed since <b class="ss-since">–</b>; weekly Sun 23:59 Asia/Shanghai; views=loads, visits=CF Visit)</span>
        </span>
        <span data-l="zh" class="ss-gc" hidden>
          · <a class="stats-src" href={gcSessionsHelp} target="_blank" rel="noopener noreferrer">GoatCounter</a>
          访客约 <b class="gc-visitors">–</b>
          <span class="stats-note">（兜底；站点+IP+UA，约 8h 内同路径刷新不计）</span>
        </span>
        <span data-l="en" class="ss-gc" hidden>
          · ~<b class="gc-visitors">–</b> via
          <a class="stats-src" href={gcSessionsHelp} target="_blank" rel="noopener noreferrer">GoatCounter</a>
          <span class="stats-note"> (fallback; site+IP+UA ~8h same path)</span>
        </span>
      </span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    font-size: 0.9rem;
  }
  .site-footer p { margin: 0; }
  .site-stats { font-variant-numeric: tabular-nums; }
  .site-stats[hidden] { display: none; }
  .site-stats b { font-weight: inherit; color: inherit; }
  .site-stats .ss-cf[hidden],
  .site-stats .ss-gc[hidden] { display: none; }
  .stats-src {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .stats-note {
    color: var(--fg-muted);
    font-size: 0.85em;
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('.site-stats');
  if (!el) {
    // no-op
  } else {
    const code = el.dataset.gc || '';
    const cfOn = el.dataset.cf === '1';
    const num = (s: unknown) => (typeof s === 'string' || typeof s === 'number' ? String(s) : null);

    const showCf = (pageviews: string, visits: string, sinceLabel: string) => {
      el.querySelectorAll<HTMLElement>('.ss-pageviews').forEach((n) => {
        n.textContent = pageviews;
      });
      el.querySelectorAll<HTMLElement>('.ss-visits').forEach((n) => {
        n.textContent = visits;
      });
      el.querySelectorAll<HTMLElement>('.ss-since').forEach((n) => {
        n.textContent = sinceLabel || '–';
      });
      el.querySelectorAll<HTMLElement>('.ss-cf').forEach((n) => {
        n.hidden = false;
      });
      el.querySelectorAll<HTMLElement>('.ss-gc').forEach((n) => {
        n.hidden = true;
      });
      el.hidden = false;
    };

    const showGc = (visitors: string) => {
      el.querySelectorAll<HTMLElement>('.gc-visitors').forEach((n) => {
        n.textContent = visitors;
      });
      el.querySelectorAll<HTMLElement>('.ss-gc').forEach((n) => {
        n.hidden = false;
      });
      el.querySelectorAll<HTMLElement>('.ss-cf').forEach((n) => {
        n.hidden = true;
      });
      el.hidden = false;
    };

    const loadGc = () => {
      if (!code) return;
      fetch(`https://${code}.goatcounter.com/counter/TOTAL.json`)
        .then((r) => (r.ok ? r.json() : null))
        .catch(() => null)
        .then((d) => {
          if (!d) return;
          const visitors = num(d.count);
          if (visitors == null) return;
          showGc(visitors);
        });
    };

    fetch('/analytics/cloudflare.json')
      .then((r) => (r.ok ? r.json() : null))
      .catch(() => null)
      .then((d) => {
        if (d?.ok && d.site) {
          const pageviews = num(d.site.pageviews) ?? '0';
          const visits = num(d.site.visits) ?? '0';
          const since = typeof d.accumulateSinceLabel === 'string' ? d.accumulateSinceLabel : '–';
          showCf(pageviews, visits, since);
          return;
        }
        if (!cfOn) loadGc();
        else showCf('0', '0', '–');
      });
  }
</script>
