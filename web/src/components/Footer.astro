---
import { AUTHOR, FEATURES } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p class="muted">
      &copy; {year} {AUTHOR.nameZh} ({AUTHOR.name})
      <span data-l="zh"> · 使用 </span><span data-l="en"> · Built with </span>
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
      {FEATURES.goatcounter && (
        <span class="site-stats" data-gc={FEATURES.goatcounter} hidden>
          <span data-l="zh"> · 访问 <b class="gc-views">–</b> 次 · 访客 <b class="gc-visitors">–</b> 人</span>
          <span data-l="en"> · <b class="gc-views">–</b> views · <b class="gc-visitors">–</b> visitors</span>
        </span>
      )}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    font-size: 0.9rem;
  }
  .site-footer p { margin: 0; }
  .site-stats { font-variant-numeric: tabular-nums; }
  .site-stats[hidden] { display: none; }
  .site-stats b { font-weight: inherit; color: inherit; }
</style>

<script>
  const el = document.querySelector<HTMLElement>('.site-stats');
  const code = el?.dataset.gc;
  if (el && code) {
    const num = (s: unknown) => (typeof s === 'string' || typeof s === 'number' ? String(s) : null);
    fetch(`https://${code}.goatcounter.com/counter/TOTAL.json`)
      .then((r) => (r.ok ? r.json() : null))
      .catch(() => null)
      .then((d) => {
        if (!d) return; // "allow visitor counter" setting off, or request blocked
        const views = num(d.count);
        const visitors = num(d.count_unique);
        if (views == null && visitors == null) return;
        el.querySelectorAll<HTMLElement>('.gc-views').forEach((n) => { if (views != null) n.textContent = views; });
        el.querySelectorAll<HTMLElement>('.gc-visitors').forEach((n) => { if (visitors != null) n.textContent = visitors; });
        el.hidden = false;
      });
  }
</script>
