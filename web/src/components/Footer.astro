---
import { AUTHOR, FEATURES } from '../config';
const year = new Date().getFullYear();
const gc = FEATURES.goatcounter;
const gcSessionsHelp = 'https://www.goatcounter.com/help/sessions';
---

<footer class="site-footer">
  <div class="container">
    <p class="muted">
      &copy; {year} {AUTHOR.nameZh} ({AUTHOR.name})
      <span data-l="zh"> · 使用 </span><span data-l="en"> · Built with </span>
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
      <span class="site-stats" data-gc={gc || ''} hidden>
        <span data-l="zh" class="ss-cf" hidden>
          · Cloudflare 访问 <b class="ss-pageviews">–</b> · 访客约 <b class="ss-visits">–</b>
        </span>
        <span data-l="en" class="ss-cf" hidden>
          · Cloudflare <b class="ss-pageviews">–</b> views · ~<b class="ss-visits">–</b> visits
        </span>
        <span data-l="zh" class="ss-gc" hidden>
          · <a class="stats-src" href={gcSessionsHelp} target="_blank" rel="noopener noreferrer">GoatCounter</a>
          访客约 <b class="gc-visitors">–</b>
          <span class="stats-note">（站点+IP+UA 识别会话，约 8 小时内同一路径刷新不计；不写 cookie，IP/UA 不入库）</span>
        </span>
        <span data-l="en" class="ss-gc" hidden>
          · ~<b class="gc-visitors">–</b> visitors via
          <a class="stats-src" href={gcSessionsHelp} target="_blank" rel="noopener noreferrer">GoatCounter</a>
          <span class="stats-note"> (session = site+IP+UA, ~8h; same path not re-counted; no cookies; IP/UA not stored)</span>
        </span>
      </span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    font-size: 0.9rem;
  }
  .site-footer p { margin: 0; }
  .site-stats { font-variant-numeric: tabular-nums; }
  .site-stats[hidden] { display: none; }
  .site-stats b { font-weight: inherit; color: inherit; }
  .site-stats .ss-cf[hidden],
  .site-stats .ss-gc[hidden] { display: none; }
  .stats-src {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .stats-note {
    color: var(--fg-muted);
    font-size: 0.85em;
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('.site-stats');
  if (!el) {
    // no-op
  } else {
    const code = el.dataset.gc || '';
    const num = (s: unknown) => (typeof s === 'string' || typeof s === 'number' ? String(s) : null);

    const showCf = (pageviews: string, visits: string) => {
      el.querySelectorAll<HTMLElement>('.ss-pageviews').forEach((n) => {
        n.textContent = pageviews;
      });
      el.querySelectorAll<HTMLElement>('.ss-visits').forEach((n) => {
        n.textContent = visits;
      });
      el.querySelectorAll<HTMLElement>('.ss-cf').forEach((n) => {
        n.hidden = false;
      });
      el.querySelectorAll<HTMLElement>('.ss-gc').forEach((n) => {
        n.hidden = true;
      });
      el.hidden = false;
    };

    const showGc = (visitors: string) => {
      el.querySelectorAll<HTMLElement>('.gc-visitors').forEach((n) => {
        n.textContent = visitors;
      });
      el.querySelectorAll<HTMLElement>('.ss-gc').forEach((n) => {
        n.hidden = false;
      });
      el.querySelectorAll<HTMLElement>('.ss-cf').forEach((n) => {
        n.hidden = true;
      });
      el.hidden = false;
    };

    const loadGc = () => {
      if (!code) return;
      fetch(`https://${code}.goatcounter.com/counter/TOTAL.json`)
        .then((r) => (r.ok ? r.json() : null))
        .catch(() => null)
        .then((d) => {
          if (!d) return;
          const visitors = num(d.count);
          if (visitors == null) return;
          showGc(visitors);
        });
    };

    fetch('/analytics/cloudflare.json')
      .then((r) => (r.ok ? r.json() : null))
      .catch(() => null)
      .then((d) => {
        if (d?.ok && d.site) {
          const pageviews = num(d.site.pageviews);
          const visits = num(d.site.visits);
          // Warm-up: CF site just created → 0/0. Prefer GoatCounter until real CF traffic exists.
          if (pageviews != null && visits != null && !(pageviews === '0' && visits === '0')) {
            showCf(pageviews, visits);
            return;
          }
        }
        loadGc();
      });
  }
</script>
