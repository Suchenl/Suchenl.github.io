---
import { AUTHOR } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p class="muted">
      &copy; {year} {AUTHOR.nameZh} ({AUTHOR.name})
      <span data-l="zh"> · 使用 </span><span data-l="en"> · Built with </span>
      <a href="https://astro.build" rel="noopener">Astro</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    font-size: 0.9rem;
  }
  .site-footer p { margin: 0; }
</style>
