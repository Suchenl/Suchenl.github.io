---
import '../styles/reading-toc.css';
interface Item { depth:number; slug:string; text:string; num?:string; }
interface Props { headings:Item[]; articleSelector:string; }
const {headings,articleSelector}=Astro.props;
---
{headings.length>1 && (
  <aside class="reading-toc" data-reading-toc data-article-selector={articleSelector} aria-label="文章章节导航">
    <button class="reading-toc-toggle" type="button" aria-expanded="true" aria-label="收起或展开左侧目录" title="收起或展开目录">
      <span class="reading-toc-toggle-icon" aria-hidden="true">☰</span><span>目录</span>
    </button>
    <div class="reading-toc-panel" id="reading-toc-panel">
      <div class="reading-toc-heading">
        <div><strong>文章目录 <span class="reading-toc-count">· {headings.length} 节</span></strong><small class="reading-toc-location" aria-live="off">阅读位置 · 1 / {headings.length}</small></div>
        <button class="reading-toc-close" type="button" aria-label="收起目录">‹</button>
      </div>
      <nav class="reading-toc-links" aria-label="本页章节">
        {headings.map(h=>(
          <a class:list={['reading-toc-link',h.depth===3 && 'reading-toc-level3']} href={'#'+h.slug} data-toc-target={h.slug} title={h.text}>
            {h.num && <span class="reading-toc-index" aria-hidden="true">{h.num}</span>}
            <span>{h.text}</span>
          </a>
        ))}
      </nav>
      <button class="reading-toc-top" type="button">↑ 返回文章顶部</button>
    </div>
  </aside>
)}
<script src="../scripts/reading-toc.ts"></script>
