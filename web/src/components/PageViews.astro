---
/**
 * Per-page stats — Cloudflare first (访问=pageviews, 访客=visits).
 * GoatCounter kept as fallback only when CF JSON is missing/failed.
 */
import { FEATURES } from '../config';
const gc = FEATURES.goatcounter;
const cfOn = Boolean(FEATURES.cloudflareAnalytics?.beaconToken);
const cfHelp = 'https://developers.cloudflare.com/web-analytics/data-metrics/high-level-metrics/';
const gcSessionsHelp = 'https://www.goatcounter.com/help/sessions';
---
<span
  class="page-views"
  data-gc={gc || ''}
  data-cf={cfOn ? '1' : ''}
  hidden
>
  <span data-l="zh" class="pv-cf" hidden>
    · <a class="stats-src" href={cfHelp} target="_blank" rel="noopener noreferrer">Cloudflare</a>
    累计访问 <b class="pv-pageviews">–</b> · 累计访客 <b class="pv-visits">–</b>
    <span class="stats-note">（自 <b class="pv-since">–</b> 起累加；每周一更新）</span>
  </span>
  <span data-l="en" class="pv-cf" hidden>
    · <a class="stats-src" href={cfHelp} target="_blank" rel="noopener noreferrer">Cloudflare</a>
    <b class="pv-pageviews">–</b> views · <b class="pv-visits">–</b> visits
    <span class="stats-note"> (cumulative since <b class="pv-since">–</b>; weekly)</span>
  </span>
  <span data-l="zh" class="pv-gc" hidden>
    · <a class="stats-src" href={gcSessionsHelp} target="_blank" rel="noopener noreferrer">GoatCounter</a>
    访客约 <b class="pv-gc-count">–</b>
    <span class="stats-note">（兜底；站点+IP+UA，约 8h 内同路径刷新不计）</span>
  </span>
  <span data-l="en" class="pv-gc" hidden>
    · ~<b class="pv-gc-count">–</b> via
    <a class="stats-src" href={gcSessionsHelp} target="_blank" rel="noopener noreferrer">GoatCounter</a>
    <span class="stats-note"> (fallback; site+IP+UA, ~8h, same path)</span>
  </span>
</span>

<style>
  .page-views { font-variant-numeric: tabular-nums; }
  .page-views[hidden] { display: none; }
  .page-views b { font-weight: inherit; color: inherit; }
  .page-views .pv-cf[hidden],
  .page-views .pv-gc[hidden] { display: none; }
  .stats-src {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .stats-note {
    color: var(--fg-muted);
    font-size: 0.9em;
  }
</style>

<script is:inline>
  (function () {
    var el = document.querySelector('.page-views');
    if (!el) return;
    var code = el.getAttribute('data-gc');
    var cfOn = el.getAttribute('data-cf') === '1';

    function showCf(pageviews, visits, sinceLabel) {
      el.querySelectorAll('.pv-pageviews').forEach(function (n) {
        n.textContent = String(pageviews);
      });
      el.querySelectorAll('.pv-visits').forEach(function (n) {
        n.textContent = String(visits);
      });
      el.querySelectorAll('.pv-since').forEach(function (n) {
        n.textContent = sinceLabel || '–';
      });
      el.querySelectorAll('.pv-cf').forEach(function (n) {
        n.hidden = false;
      });
      el.querySelectorAll('.pv-gc').forEach(function (n) {
        n.hidden = true;
      });
      el.hidden = false;
    }

    function showGc(n) {
      el.querySelectorAll('.pv-gc-count').forEach(function (node) {
        node.textContent = String(n);
      });
      el.querySelectorAll('.pv-gc').forEach(function (n) {
        n.hidden = false;
      });
      el.querySelectorAll('.pv-cf').forEach(function (n) {
        n.hidden = true;
      });
      el.hidden = false;
    }

    function pathKeys() {
      var p = location.pathname;
      var list = [p];
      if (p.length > 1 && p.endsWith('/')) list.push(p.slice(0, -1));
      else if (p !== '/') list.push(p + '/');
      try {
        if (window.goatcounter && typeof window.goatcounter.get_data === 'function') {
          var gp = window.goatcounter.get_data().p;
          if (gp) list.unshift(gp);
        }
      } catch (e) {}
      return list.filter(function (x, i, a) {
        return a.indexOf(x) === i;
      });
    }

    function lookupPath(paths) {
      var keys = pathKeys();
      for (var i = 0; i < keys.length; i++) {
        var hit = paths && paths[keys[i]];
        if (hit && (hit.pageviews != null || hit.visits != null)) return hit;
      }
      return null;
    }

    function loadGc() {
      if (!code) return;
      var tries = pathKeys();
      var i = 0;
      function next() {
        if (i >= tries.length) return;
        var path = tries[i++];
        fetch('https://' + code + '.goatcounter.com/counter/' + encodeURIComponent(path) + '.json')
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (d) {
            if (d && d.count != null) showGc(d.count);
            else next();
          })
          .catch(next);
      }
      next();
    }

    fetch('/analytics/cloudflare.json')
      .then(function (r) {
        return r.ok ? r.json() : null;
      })
      .then(function (d) {
        // Primary: Cloudflare cumulative JSON whenever present.
        if (d && d.ok) {
          var since = d.accumulateSinceLabel || '–';
          var hit = lookupPath(d.paths || {});
          if (hit) showCf(hit.pageviews || 0, hit.visits || 0, since);
          else showCf(0, 0, since);
          return;
        }
        if (!cfOn) loadGc();
      })
      .catch(function () {
        if (!cfOn) loadGc();
        else showCf(0, 0, '–');
      });

    // GoatCounter lag retry — only when we are still on the GC fallback UI.
    setTimeout(function () {
      if (el.querySelector('.pv-gc:not([hidden])')) loadGc();
    }, 900);
  })();
</script>
