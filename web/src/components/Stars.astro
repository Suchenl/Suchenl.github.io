---
interface Props { repo: string }
const { repo } = Astro.props;
---
<a class="stars" href={`https://github.com/${repo}`} target="_blank" rel="noopener" aria-label={`${repo} GitHub stars`}>
  <img
    src={`https://img.shields.io/github/stars/${repo}?style=social`}
    alt="GitHub stars"
    loading="lazy"
    height="20"
  />
</a>

<style>
  .stars { display: inline-flex; line-height: 0; }
  .stars:hover { text-decoration: none; }
  .stars img { display: block; height: 20px; }
</style>
