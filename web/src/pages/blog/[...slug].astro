---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) => d.toLocaleDateString('en-CA');
---

<Base title={post.data.title} description={post.data.description} ogType="article">
  <article class="post">
    <header class="post-head">
      <h1 class="post-h1">{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        {post.data.tags.length > 0 && (
          <span class="post-tags">
            {post.data.tags.map((t) => <span class="tag-chip">{t}</span>)}
          </span>
        )}
      </div>
    </header>

    <div class="post-body">
      <Content />
    </div>

    <footer class="post-foot">
      <a href="/blog/">← <span data-l="zh">返回博客</span><span data-l="en">Back to blog</span></a>
    </footer>
  </article>
</Base>

<style>
  .post { max-width: var(--content-width); }
  .post-head { margin-bottom: 2rem; }
  .post-h1 { font-size: 2rem; margin: 0 0 0.6rem; }
  .post-meta { display: flex; align-items: center; gap: 0.7rem; color: var(--fg-muted); font-size: 0.9rem; }
  .post-meta time { font-variant-numeric: tabular-nums; }
  .post-tags { display: inline-flex; flex-wrap: wrap; gap: 0.4rem; }

  .post-body :global(h2) { font-size: 1.4rem; margin: 2rem 0 0.8rem; }
  .post-body :global(h3) { font-size: 1.15rem; margin: 1.6rem 0 0.6rem; }
  .post-body :global(p) { margin: 0.9rem 0; line-height: 1.8; }
  .post-body :global(ul), .post-body :global(ol) { margin: 0.9rem 0; padding-left: 1.4rem; line-height: 1.8; }
  .post-body :global(li) { margin: 0.3rem 0; }
  .post-body :global(img) { max-width: 100%; border-radius: 8px; }
  .post-body :global(blockquote) {
    margin: 1.2rem 0;
    padding: 0.4rem 1rem;
    border-left: 3px solid var(--accent);
    color: var(--fg-muted);
    background: var(--surface-2);
    border-radius: 0 8px 8px 0;
  }
  .post-body :global(pre) {
    background: var(--surface-2);
    padding: 1rem 1.1rem;
    border-radius: 10px;
    overflow-x: auto;
    border: 1px solid var(--border);
  }
  .post-body :global(:not(pre) > code) {
    background: var(--surface-2);
    padding: 0.15em 0.4em;
    border-radius: 5px;
    font-size: 0.9em;
  }

  .post-foot { margin-top: 3rem; padding-top: 1.2rem; border-top: 1px solid var(--border); font-weight: 700; }
</style>
