---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';
import { PUB_GROUPS } from '../../data';
---

<Base title="Publications">
  <h1 class="page-title"><Bi zh="论文" en="Publications" /></h1>
  <p class="page-intro">
    <Bi zh="按研究领域分组。* 表示共同一作。" en="Grouped by research area. * indicates equal contribution." />
  </p>

  {PUB_GROUPS.map((group) => (
    <div class="pub-group">
      <h2><span data-l="zh">{group.zh}</span><span data-l="en">{group.en}</span></h2>
      {group.papers.map((p) => (
        p.image ? (
          <div class="paper-box card">
            <div class="paper-img">
              <span class="badge">{p.venue}</span>
              <img
                src={p.image.replace(/\.png$/, '-thumb.jpg')}
                data-full={p.image}
                alt={p.titleEn}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="paper-text">
              <p>
                <span class="muted">[{p.venue}]</span>
                <a href={p.url} target="_blank" rel="noopener">
                  <span data-l="zh">{p.titleZh}</span><span data-l="en">{p.titleEn}</span>
                </a>
              </p>
              <p class="authors" set:html={p.authorsHtml} />
            </div>
          </div>
        ) : (
          <p class="other-pub">
            <span class="muted">[{p.venue}]</span>
            <a href={p.url} target="_blank" rel="noopener">
              <span data-l="zh">{p.titleZh}</span><span data-l="en">{p.titleEn}</span>
            </a><br />
            <span class="authors" set:html={p.authorsHtml} />
          </p>
        )
      ))}
    </div>
  ))}

  <div id="lightbox" class="lightbox" hidden>
    <img id="lightbox-img" src="" alt="" />
  </div>
</Base>

<style>
  .paper-box {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.2rem;
    align-items: center;
    margin-bottom: 1.2rem;
  }
  .paper-img { position: relative; }
  .paper-img .badge {
    position: absolute;
    top: 6px;
    left: 6px;
    font-size: 0.62rem;
    padding: 0.16em 0.55em;
    opacity: 0.94;
    z-index: 1;
  }
  .paper-img img {
    border-radius: 8px;
    display: block;
    width: 100%;
    cursor: zoom-in;
    transition: filter 0.15s ease;
  }
  .paper-img img:hover { filter: brightness(1.04); }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vh 4vw;
    background: rgba(0, 0, 0, 0.82);
    cursor: zoom-out;
    backdrop-filter: blur(3px);
  }
  .lightbox[hidden] { display: none; }
  .lightbox img {
    max-width: 100%;
    max-height: 92vh;
    border-radius: 8px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
  }
  .paper-text p { margin: 0.3rem 0; }
  .authors { font-size: 0.92rem; }
  .other-pub { margin: 0.9rem 0; }

  @media (max-width: 720px) {
    .paper-box { grid-template-columns: 1fr; }
  }
</style>

<script>
  const box = document.getElementById('lightbox') as HTMLElement | null;
  const boxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;

  function open(full: string, alt: string) {
    if (!box || !boxImg) return;
    boxImg.src = full;
    boxImg.alt = alt;
    box.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function close() {
    if (!box || !boxImg) return;
    box.hidden = true;
    boxImg.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLImageElement>('.paper-img img').forEach((img) => {
    img.addEventListener('click', () => open(img.dataset.full || img.src, img.alt));
  });
  box?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && box && !box.hidden) close();
  });
</script>
