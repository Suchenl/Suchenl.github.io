---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';
import Stars from '../../components/Stars.astro';
import { PUB_GROUPS } from '../../data';
import { SITE, AUTHOR } from '../../config';

---

<Base title="Publications" structuredData={{
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Publications · '+AUTHOR.name,
  url:SITE.url+'/publications/',
  mainEntity:{
    '@type':'ItemList',
    itemListElement:PUB_GROUPS.flatMap(group=>group.papers).map((paper,i)=>({
      '@type':'ListItem',
      position:i+1,
      item:{
        '@type':'ScholarlyArticle',
        name:paper.titleEn,
        url:new URL(paper.url,SITE.url).href,
        author:{'@type':'Person',name:AUTHOR.name,url:SITE.url+'/'},
        isPartOf:paper.venue==='Preprint'?undefined:{'@type':'CreativeWorkSeries',name:paper.venue}
      }
    }))
  }
}}>
  <h1 class="page-title"><Bi zh="论文" en="Publications" /></h1>
  <p class="page-intro">
    <Bi zh="按研究领域分组。* 表示共同一作。" en="Grouped by research area. * indicates equal contribution." />
  </p>

  {PUB_GROUPS.map((group) => (
    <div class="pub-group">
      <h2><span data-l="zh">{group.zh}</span><span data-l="en">{group.en}</span></h2>
      {group.papers.map((p) => (
        p.image ? (
          <div class="paper-box card">
            <div class="paper-img">
              <span class="badge">{p.venue}</span>
              <div class="paper-figure">
                <img
                  src={p.image.replace(/\.png$/, '-thumb.jpg')}
                  alt={p.titleEn}
                  loading="lazy"
                  decoding="async"
                />
                </div>
            </div>
            <div class="paper-text">
              <p>
                <span class="muted">[{p.venue}]</span>
                <a href={p.url} target="_blank" rel="noopener">
                  <span data-l="zh">{p.titleZh}</span><span data-l="en">{p.titleEn}</span>
                </a>
              </p>
              <p class="authors" set:html={p.authorsHtml} />
              {p.code && (
                <p class="paper-links">
                  <a class="repo-link" href={`https://github.com/${p.code}`} target="_blank" rel="noopener">
                    <span data-l="zh">代码</span><span data-l="en">Code</span>
                  </a>
                  <Stars repo={p.code} />
                </p>
              )}
            </div>
            <details class="pub-abstract">
              <summary><span data-l="zh">查看论文简介</span><span data-l="en">Paper at a glance</span><span class="pub-chevron" aria-hidden="true">⌄</span></summary>
              <div class="pub-abstract-body">
                {p.brief ? (
                  <>
                    {([
                      ['研究动机','Motivation',p.brief.motivationZh,p.brief.motivationEn],
                      ['核心方法','Approach',p.brief.methodZh,p.brief.methodEn],
                      ['主要发现','Findings',p.brief.resultZh,p.brief.resultEn],
                      ['证据边界','Limitations',p.brief.boundaryZh,p.brief.boundaryEn]
                    ] as const).map(([zh,en,zhText,enText])=><div class="pub-brief-row"><strong><span data-l="zh">{zh}</span><span data-l="en">{en}</span></strong><p><span data-l="zh">{zhText}</span><span data-l="en">{enText}</span></p></div>)}
                  </>
                ) : <p>内容正在整理，请参考原论文。</p>}
                </div>
            </details>
          </div>
        ) : (
          <p class="other-pub">
            <span class="muted">[{p.venue}]</span>
            <a href={p.url} target="_blank" rel="noopener">
              <span data-l="zh">{p.titleZh}</span><span data-l="en">{p.titleEn}</span>
            </a><br />
            <span class="authors" set:html={p.authorsHtml} />
          </p>
        )
      ))}
    </div>
  ))}

</Base>

<style>
  .paper-box {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.2rem;
    align-items: center;
    margin-bottom: 1.2rem;
  }
  .paper-img { position: relative; }
  .paper-img .badge {
    position: absolute;
    top: 6px;
    left: 6px;
    font-size: 0.62rem;
    padding: 0.16em 0.55em;
    opacity: 0.94;
    z-index: 1;
  }
  .paper-img img {
    border-radius: 8px;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: var(--surface-2);
    cursor: default;
    transition: filter 0.15s ease;
  }

  .paper-text p { margin: 0.3rem 0; }
  .authors { font-size: 0.92rem; }
  .other-pub { margin: 0.9rem 0; }

  .paper-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem !important;
  }
  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-ink);
    background: var(--accent-soft);
    padding: 0.2em 0.75em;
    border-radius: 999px;
    border: 1px solid transparent;
  }
  .repo-link:hover { text-decoration: none; border-color: var(--accent); }

  @media (max-width: 720px) {
    .paper-box { grid-template-columns: 1fr; }
  }
</style>

<style>.pub-abstract{grid-column:1/-1;border-top:1px solid var(--border)}.pub-abstract summary{cursor:pointer;display:flex;align-items:center;gap:.6rem;min-height:44px;padding:.6rem 0;color:var(--accent-ink);font-size:.85rem;font-weight:700}.pub-chevron{margin-left:auto}.pub-abstract[open] .pub-chevron{transform:rotate(180deg)}.pub-abstract-body{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem 1.3rem;padding:.6rem 0}.pub-brief-row strong,.pub-brief-row strong{font-size:.77rem;color:var(--fg-muted)}.pub-brief-row p,.pub-brief-row p{font-size:.85rem;line-height:1.75;margin:.3rem 0}@media(max-width:720px){.pub-abstract-body{grid-template-columns:1fr}}</style>

