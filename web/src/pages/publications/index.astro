---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';
import Stars from '../../components/Stars.astro';
import { PUB_GROUPS } from '../../data';
import { SITE, AUTHOR } from '../../config';

---

<Base title="Publications" structuredData={{
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Publications · '+AUTHOR.name,
  url:SITE.url+'/publications/',
  mainEntity:{
    '@type':'ItemList',
    itemListElement:PUB_GROUPS.flatMap(group=>group.papers).map((paper,i)=>({
      '@type':'ListItem',
      position:i+1,
      item:{
        '@type':'ScholarlyArticle',
        name:paper.titleEn,
        url:new URL(paper.url,SITE.url).href,
        author:{'@type':'Person',name:AUTHOR.name,url:SITE.url+'/'},
        isPartOf:paper.venue==='Preprint'?undefined:{'@type':'CreativeWorkSeries',name:paper.venue}
      }
    }))
  }
}}>
  <h1 class="page-title"><Bi zh="论文" en="Publications" /></h1>
  <p class="page-intro">
    <Bi zh="按研究领域分组。* 表示共同一作。" en="Grouped by research area. * indicates equal contribution." />
  </p>

  {PUB_GROUPS.map((group) => (
    <section class="pub-group" aria-label={group.zh}>
      <h2><span data-l="zh">{group.zh}</span><span data-l="en">{group.en}</span></h2>
      {group.papers.map((paper) => (
        <article class:list={['paper-entry', 'card', !paper.image && 'paper-no-image']}>
          {paper.image && (
            <div class="paper-image">
              <img
                src={paper.thumbnail || paper.image}
                alt={'论文方法示意图：' + paper.titleZh}
                width="440"
                height="248"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="paper-information">
            <div class="paper-venue">{paper.venue}</div>
            <h3>
              <a href={paper.url} target="_blank" rel="noopener noreferrer">
                <span data-l="zh">{paper.titleZh}</span>
                <span data-l="en">{paper.titleEn}</span>
              </a>
            </h3>
            <p class="authors" set:html={paper.authorsHtml} />
            {paper.code && (
              <div class="paper-links">
                <a class="repo-link" href={'https://github.com/' + paper.code} target="_blank" rel="noopener noreferrer">
                  <span data-l="zh">查看代码 ↗</span><span data-l="en">Code ↗</span>
                </a>
                <Stars repo={paper.code} />
                {paper.projectPage && <a href={paper.projectPage} target="_blank" rel="noopener noreferrer"><Bi zh="项目主页 ↗" en="Project site ↗" /></a>}
                {paper.dataset && <a href={paper.dataset} target="_blank" rel="noopener noreferrer"><Bi zh="数据集 ↗" en="Dataset ↗" /></a>}
              </div>
            )}
          </div>
          <details class="pub-abstract">
            <summary>
              <span data-l="zh">研究简介：动机、方法与发现</span>
              <span data-l="en">Research summary: motivation, method, findings</span>
              <span class="pub-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="pub-abstract-body">
              {paper.brief ? (
                <>
                  {([
                    ['研究动机','Motivation',paper.brief.motivationZh,paper.brief.motivationEn],
                    ['核心方法','Approach',paper.brief.methodZh,paper.brief.methodEn],
                    ['主要发现','Findings',paper.brief.resultZh,paper.brief.resultEn],
                    ['局限与边界','Limitations',paper.brief.boundaryZh,paper.brief.boundaryEn]
                  ] as const).map(([zh,en,zhText,enText]) => (
                    <div class="pub-brief-row">
                      <strong><span data-l="zh">{zh}</span><span data-l="en">{en}</span></strong>
                      <p><span data-l="zh">{zhText}</span><span data-l="en">{enText}</span></p>
                    </div>
                  ))}
                </>
              ) : (
                <p><Bi zh="简介正在整理，请参阅原论文。" en="Summary pending; please consult the original paper." /></p>
              )}
              {paper.briefSource && (
                <p class="pub-source">
                  <span data-l="zh">核对依据：</span><span data-l="en">Summary source: </span>
                  <a href={paper.briefSource.url} target={paper.briefSource.url.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                    <span data-l="zh">{paper.briefSource.labelZh} ↗</span>
                    <span data-l="en">{paper.briefSource.labelEn} ↗</span>
                  </a>
                </p>
              )}
            </div>
          </details>
        </article>
      ))}
    </section>
  ))}
</Base>
<style>
  .pub-group {margin:1.8rem 0 2.5rem;}
  .pub-group h2 {font-size:1.25rem;line-height:1.45;margin:0 0 1rem;}
  .paper-entry {
    display:grid;
    grid-template-columns:minmax(0, 220px) minmax(0, 1fr);
    align-items:center;
    column-gap:1.2rem;
    row-gap:.85rem;
    margin:0 0 1rem;
    padding:1.15rem 1.2rem;
    min-width:0;
  }
  .paper-image {width:100%;min-width:0;}
  .paper-image img {display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:contain;border-radius:8px;background:var(--surface-2);}
  .paper-information {min-width:0;}
  .paper-no-image .paper-information {grid-column:1/-1;}
  .paper-venue {color:var(--fg-muted);font-size:.74rem;font-weight:760;margin-bottom:.38rem;}
  .paper-information h3 {font-size:1rem;line-height:1.55;margin:0 0 .35rem;overflow-wrap:anywhere;}
  .paper-information h3 a {color:var(--fg);text-decoration:none;}
  .paper-information h3 a:hover {color:var(--accent-ink);text-decoration:underline;text-underline-offset:3px;}
  .paper-information .authors {font-size:.85rem;line-height:1.7;color:var(--fg-muted);margin:.35rem 0;}
  .paper-links {display:flex;align-items:center;gap:.65rem;flex-wrap:wrap;margin-top:.7rem;font-size:.81rem;}
  .repo-link {display:inline-flex;align-items:center;font-weight:720;color:var(--accent-ink);background:var(--accent-soft);padding:.35rem .7rem;border:1px solid transparent;border-radius:7px;}
  .repo-link:hover {border-color:var(--accent);text-decoration:none;}
  .pub-abstract {grid-column:1/-1;border-top:1px solid var(--border);min-width:0;}
  .pub-abstract summary {min-height:44px;display:flex;align-items:center;gap:.5rem;cursor:pointer;padding:.55rem 0;font-size:.84rem;font-weight:680;color:var(--accent-ink);line-height:1.55;}
  .pub-abstract summary:focus-visible {outline:2px solid var(--accent);outline-offset:3px;border-radius:4px;}
  .pub-chevron {margin-left:auto;transition:transform .15s ease;}
  .pub-abstract[open] .pub-chevron {transform:rotate(180deg);}
  .pub-abstract-body {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem 1.2rem;padding:.8rem 0 .2rem;}
  .pub-brief-row {min-width:0;}
  .pub-brief-row strong {font-size:.78rem;color:var(--fg-muted);}
  .pub-brief-row p {font-size:.85rem;line-height:1.8;margin:.25rem 0;overflow-wrap:anywhere;}
  .pub-source {grid-column:1/-1;font-size:.77rem;color:var(--fg-muted);margin:.35rem 0 0;}
  .pub-source a {text-decoration:underline;text-underline-offset:3px;}
  @media(max-width:720px) {
    .paper-entry {grid-template-columns:minmax(0,1fr);padding:.95rem;}
    .paper-image {max-width:300px;}
    .paper-information,.paper-no-image .paper-information {grid-column:1;}
    .pub-abstract {grid-column:1;}
    .pub-abstract-body {grid-template-columns:minmax(0,1fr);}
  }
  @media(prefers-reduced-motion:reduce) {.pub-chevron{transition:none;}}
</style>
