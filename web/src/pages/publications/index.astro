---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';
import Stars from '../../components/Stars.astro';
import { PUB_GROUPS } from '../../data';
import { SITE, AUTHOR } from '../../config';
---

<Base title="Publications" structuredData={{
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Publications · '+AUTHOR.name,
  url:SITE.url+'/publications/',
  mainEntity:{
    '@type':'ItemList',
    itemListElement:PUB_GROUPS.flatMap(group=>group.papers).map((paper,i)=>({
      '@type':'ListItem',
      position:i+1,
      item:{
        '@type':'ScholarlyArticle',
        name:paper.titleEn,
        url:new URL(paper.url,SITE.url).href,
        author:{'@type':'Person',name:AUTHOR.name,url:SITE.url+'/'},
        isPartOf:paper.venue==='Preprint'?undefined:{'@type':'CreativeWorkSeries',name:paper.venue}
      }
    }))
  }
}}>
  <h1 class="page-title"><Bi zh="论文" en="Publications" /></h1>
  <p class="page-intro">
    <Bi zh="按研究领域分组。* 表示共同一作。" en="Grouped by research area. * indicates equal contribution." />
  </p>

  {PUB_GROUPS.map((group) => (
    <div class="pub-group">
      <h2><span data-l="zh">{group.zh}</span><span data-l="en">{group.en}</span></h2>
      {group.papers.map((p) => (
        p.image ? (
          <div class="paper-box card">
            <div class="paper-img">
              <span class="badge">{p.venue}</span>
              <button type="button" class="paper-zoom" data-full={p.image} data-alt={p.titleEn} aria-label={'放大论文图片：' + p.titleEn}>
                <img
                  src={p.image.replace(/\.png$/, '-thumb.jpg')}
                  alt={p.titleEn}
                  loading="lazy"
                  decoding="async"
                />
                <span class="paper-zoom-hint" aria-hidden="true">放大查看 ↗</span>
              </button>
            </div>
            <div class="paper-text">
              <p>
                <span class="muted">[{p.venue}]</span>
                <a href={p.url} target="_blank" rel="noopener">
                  <span data-l="zh">{p.titleZh}</span><span data-l="en">{p.titleEn}</span>
                </a>
              </p>
              <p class="authors" set:html={p.authorsHtml} />
              {p.code && (
                <p class="paper-links">
                  <a class="repo-link" href={`https://github.com/${p.code}`} target="_blank" rel="noopener">
                    <span data-l="zh">代码</span><span data-l="en">Code</span>
                  </a>
                  <Stars repo={p.code} />
                </p>
              )}
            </div>
          </div>
        ) : (
          <p class="other-pub">
            <span class="muted">[{p.venue}]</span>
            <a href={p.url} target="_blank" rel="noopener">
              <span data-l="zh">{p.titleZh}</span><span data-l="en">{p.titleEn}</span>
            </a><br />
            <span class="authors" set:html={p.authorsHtml} />
          </p>
        )
      ))}
    </div>
  ))}

  <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="查看论文大图" hidden tabindex="-1">
    <button type="button" id="lightbox-close" class="lightbox-close" aria-label="关闭图片预览">×</button>
    <img id="lightbox-img" src="" alt="" />
    <p class="lightbox-tip">按 Esc 关闭 · 点击背景关闭</p>
  </div>
</Base>

<style>
  .paper-box {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.2rem;
    align-items: center;
    margin-bottom: 1.2rem;
  }
  .paper-img { position: relative; }
  .paper-img .badge {
    position: absolute;
    top: 6px;
    left: 6px;
    font-size: 0.62rem;
    padding: 0.16em 0.55em;
    opacity: 0.94;
    z-index: 1;
  }
  .paper-img img {
    border-radius: 8px;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: var(--surface-2);
    cursor: zoom-in;
    transition: filter 0.15s ease;
  }
  .paper-zoom { position:relative;display:block;width:100%;padding:0;border:0;background:transparent;border-radius:8px;cursor:zoom-in;text-align:left; }
  .paper-zoom:hover img { filter:brightness(1.04); }
  .paper-zoom-hint { position:absolute;bottom:8px;right:8px;background:rgba(15,16,20,.76);color:#fff;padding:.2rem .55rem;border-radius:6px;font-size:.7rem;pointer-events:none; }
  .paper-zoom:focus-visible { outline:3px solid var(--accent);outline-offset:4px; }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vh 4vw;
    background: rgba(0, 0, 0, 0.82);
    cursor: zoom-out;
    backdrop-filter: blur(3px);
  }
  .lightbox[hidden] { display: none; }
  .lightbox-close { position:absolute;right:clamp(.8rem,3vw,2rem);top:clamp(.8rem,3vw,2rem);width:48px;height:48px;cursor:pointer;font-size:2rem;border-radius:12px;border:1px solid rgba(255,255,255,.6);background:#24242d;color:white;z-index:1; }
  .lightbox-close:focus-visible {outline:3px solid white;outline-offset:3px;}
  .lightbox-tip {position:absolute;bottom:1rem;color:#fff;font-size:.8rem;text-align:center;}
  .lightbox img {
    max-width: 100%;
    max-height: 92vh;
    border-radius: 8px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
  }
  .paper-text p { margin: 0.3rem 0; }
  .authors { font-size: 0.92rem; }
  .other-pub { margin: 0.9rem 0; }

  .paper-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem !important;
  }
  .repo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-ink);
    background: var(--accent-soft);
    padding: 0.2em 0.75em;
    border-radius: 999px;
    border: 1px solid transparent;
  }
  .repo-link:hover { text-decoration: none; border-color: var(--accent); }

  @media (max-width: 720px) {
    .paper-box { grid-template-columns: 1fr; }
  }
</style>

<script>
  const box = document.getElementById('lightbox') as HTMLElement | null;
  const boxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const closeButton = document.getElementById('lightbox-close') as HTMLButtonElement | null;
  let trigger: HTMLElement | null = null;
  let previousOverflow = '';
  function open(full: string, alt: string, button: HTMLElement) {
    if (!box || !boxImg) return;
    trigger = button;
    previousOverflow = document.body.style.overflow;
    boxImg.src = full; boxImg.alt = alt;
    box.hidden = false;
    document.body.style.overflow = 'hidden';
    closeButton?.focus();
  }
  function close() {
    if (!box || !boxImg || box.hidden) return;
    box.hidden = true; boxImg.src = '';
    document.body.style.overflow = previousOverflow;
    trigger?.focus(); trigger = null;
  }
  document.querySelectorAll<HTMLButtonElement>('.paper-zoom').forEach(button=>{
    button.addEventListener('click',()=>open(button.dataset.full || '',button.dataset.alt || '',button));
  });
  closeButton?.addEventListener('click',close);
  box?.addEventListener('click',e=>{if(e.target===box) close();});
  document.addEventListener('keydown',e=>{
    if(!box || box.hidden) return;
    if(e.key==='Escape'){e.preventDefault();close();}
    if(e.key==='Tab'){
      // Only the close button is focusable within the modal.
      e.preventDefault();closeButton?.focus();
    }
  });
</script>
