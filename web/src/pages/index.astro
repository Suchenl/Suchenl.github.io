---
import Base from '../layouts/Base.astro';
import Bi from '../components/Bi.astro';
import { AUTHOR, SITE } from '../config';
import { NEWS, PUB_GROUPS } from '../data';

const interests = [
  { zh: '生成式 AI（AIGC）', en: 'Generative AI (AIGC)' },
  { zh: '计算机视觉', en: 'Computer Vision' },
  { zh: '信息隐藏', en: 'Information Hiding' },
  { zh: 'AI 安全', en: 'AI Safety' },
  { zh: 'AI + 医疗', en: 'AI for Medicine' },
];
const featured = PUB_GROUPS.flatMap(group => group.papers).filter(p => ['LAMIC', 'TAG-WM'].some(name => p.titleEn.startsWith(name)));
const hub = [
  { emoji:'📚', href:'/research/', zh:'研究知识库', en:'Research Library', descZh:'文献综述 · 术语 · 学习路线 · 研究问题', descEn:'Surveys, concepts, reading paths, questions' },
  { emoji:'📝', href:'/publications/', zh:'论文成果', en:'Publications', descZh:'公开论文与学术成果', descEn:'Published papers and scholarly work' },
  { emoji:'🛠️', href:'/projects/', zh:'项目与工具', en:'Projects & Tools', descZh:'研究实现、开源工具与演示', descEn:'Research implementations and open-source tools' },
  { emoji:'✍️', href:'/blog/', zh:'写作与笔记', en:'Writing', descZh:'技术解释、研究随笔与教程', descEn:'Explanations, research notes, tutorials' },
];
const socials = [
  { zh: '谷歌学术', en: 'Google Scholar', href: AUTHOR.links.googlescholar },
  { zh: 'GitHub', en: 'GitHub', href: AUTHOR.links.github },
  { zh: '领英', en: 'LinkedIn', href: AUTHOR.links.linkedin },
  { zh: 'ORCID', en: 'ORCID', href: AUTHOR.links.orcid },
];
---

<Base structuredData={{
  '@context':'https://schema.org',
  '@type':'ProfilePage',
  '@id':SITE.url+'/#profile',
  url:SITE.url+'/',
  name:SITE.titleZh+' · '+SITE.title,
  mainEntity:{
    '@type':'Person',
    '@id':SITE.url+'/#person',
    name:AUTHOR.name,
    alternateName:AUTHOR.nameZh,
    url:SITE.url+'/',
    image:SITE.url+AUTHOR.avatar,
    affiliation:{'@type':'EducationalOrganization',name:AUTHOR.affiliation},
    sameAs:Object.values(AUTHOR.links)
  }
}}>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-photo">
      <img src={AUTHOR.avatar} alt={AUTHOR.name} width="220" height="220" fetchpriority="high" decoding="async" />
    </div>
    <div class="hero-text">
      <p class="hero-hi"><Bi zh="你好，我是" en="Hi, I'm" /></p>
      <h1 class="hero-name">
        <span data-l="zh">{AUTHOR.nameZh}</span><span data-l="en">{AUTHOR.name}</span>
        <span class="hero-alt"><span data-l="zh">{AUTHOR.name}</span><span data-l="en">{AUTHOR.nameZh}</span></span>
      </h1>
      <p class="hero-tagline">
        <span data-l="zh">{AUTHOR.taglineZh}</span><span data-l="en">{AUTHOR.taglineEn}</span>
      </p>
      <p class="hero-interests">
        <span data-l="zh">{AUTHOR.interestsZh}</span><span data-l="en">{AUTHOR.interestsEn}</span>
      </p>
      <p class="hero-affil muted">
        <span data-l="zh">📍 {AUTHOR.affiliationZh} · {AUTHOR.locationZh}</span>
        <span data-l="en">📍 {AUTHOR.affiliation} · {AUTHOR.location}</span>
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`mailto:${AUTHOR.email}`}>
          <Bi zh="✉ 联系我" en="✉ Get in touch" />
        </a>
        {socials.map((s) => (
          <a class="btn" href={s.href} target="_blank" rel="noopener"><span data-l="zh">{s.zh}</span><span data-l="en">{s.en}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section featured-section" aria-labelledby="featured-heading">
    <div class="featured-head">
      <h2 id="featured-heading"><Bi zh="精选研究成果" en="Selected research" /></h2>
      <a href="/publications/"><Bi zh="查看全部论文 →" en="All publications →" /></a>
    </div>
    <div class="featured-grid">
      {featured.map(p => (
        <article class="featured-paper card">
          {p.image && <a href={p.url} target="_blank" rel="noopener noreferrer" aria-label={'查看论文：' + p.titleEn}>
            <img src={p.thumbnail || p.image} loading="lazy" decoding="async" width="480" height="270" alt={'方法示意：' + p.titleEn} />
          </a>}
          <div class="featured-paper-body">
            <span class="featured-venue">{p.venue}</span>
            <h3><a href={p.url} target="_blank" rel="noopener noreferrer">{p.titleEn}</a></h3>
            <p><span data-l="zh">{p.titleZh}</span><span data-l="en">{p.titleEn}</span></p>
            <div class="featured-actions">
              <a href={p.url} target="_blank" rel="noopener noreferrer"><Bi zh="阅读论文 ↗" en="Read paper ↗" /></a>
              {p.code && <a href={'https://github.com/' + p.code} target="_blank" rel="noopener noreferrer"><Bi zh="源代码 ↗" en="Code ↗" /></a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section home-hub" aria-labelledby="explore-heading">
    <h2 id="explore-heading"><Bi zh="继续探索" en="Explore more" /></h2>
    <div class="hub-grid">
      {hub.map((h) => (
        <a class="hub-card" href={h.href}>
          <div class="hub-emoji">{h.emoji}</div>
          <h3><span data-l="zh">{h.zh}</span><span data-l="en">{h.en}</span></h3>
          <p><span data-l="zh">{h.descZh}</span><span data-l="en">{h.descEn}</span></p>
        </a>
      ))}
    </div>
  </section>

  <div class="home-profile-path">
    <p><Bi zh="了解我的研究与实习经历" en="Explore my research and internship experience" /></p>
    <a href="/work/"><Bi zh="查看经历 →" en="View experience →" /></a>
  </div>
  <div class="two-col">
    <section class="section prose" id="profile">
      <Bi tag="h2" zh="👋 个人简介" en="👋 Profile" />
      <div data-l="zh">
        <p>
          我是<a href="https://www.ustc.edu.cn/" target="_blank" rel="noopener noreferrer">中国科学技术大学</a>网络空间安全学院的二年级硕士研究生，
          导师为<a href="http://staff.ustc.edu.cn/~zhangwm/" target="_blank" rel="noopener noreferrer">张卫明</a>教授与<a href="http://faculty.ustc.edu.cn/yunenghai/zh_CN/index.htm" target="_blank" rel="noopener noreferrer">俞能海</a>教授。
          此前在山东大学控制科学与工程学院获得学士学位。我的研究聚焦于人工智能、计算机视觉与安全的交叉领域。
        </p>
        <p>欢迎交流研究思路、开源工具和潜在合作。如果有共同感兴趣的问题，欢迎通过邮件联系。</p>
      </div>
      <div data-l="en">
        <p>
          I am a second-year M.S. student at the School of Cyber Science and Technology,
          <a href="https://en.ustc.edu.cn/" target="_blank" rel="noopener noreferrer">University of Science and Technology of China (USTC)</a>,
          advised by Prof. <a href="https://scholar.google.com/citations?user=eTCfl6cAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Weiming Zhang</a>
          and Prof. <a href="https://scholar.google.com/citations?user=7620QAMAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Nenghai Yu</a>.
          Previously I received my B.S. from Shandong University. My research lies at the intersection of AI, computer vision, and security.
        </p>
        <p>I'm happy to discuss research questions, open-source tools, and potential collaborations. Feel free to reach out by email.</p>
      </div>
      <div class="chips" aria-label="研究兴趣">
        {interests.map((i) => (
          <span class="tag-chip"><span data-l="zh">{i.zh}</span><span data-l="en">{i.en}</span></span>
        ))}
      </div>
    </section>

    <section class="section" id="news">
      <Bi tag="h2" zh="🔥 近况" en="🔥 News" />
      <ul class="news card">
        {NEWS.map((n) => (
          <li>
            <span class="news-date">{n.date}</span>
            <span data-l="zh" set:html={n.zh} /><span data-l="en" set:html={n.en} />
          </li>
        ))}
      </ul>
      <p class="see-all">
        <a href="/research/"><Bi zh="进入研究知识库 →" en="Explore the research library →" /></a>
      </p>
    </section>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    display: flex;
    gap: 2.6rem;
    align-items: center;
    padding: 3rem 2rem;
    margin: 1.5rem 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(600px 300px at 12% -10%, var(--bg-grad-1), transparent 60%),
      radial-gradient(500px 320px at 105% 120%, var(--bg-grad-2), transparent 55%);
    pointer-events: none;
  }
  .hero-photo { position: relative; flex: 0 0 220px; }
  .hero-photo img {
    width: 220px;
    height: 220px;
    object-fit: cover;
    border-radius: 24px;
    border: 3px solid var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .hero-text { position: relative; flex: 1 1 auto; min-width: 0; }
  .hero-hi { margin: 0 0 0.2rem; color: var(--fg-muted); font-weight: 600; font-size: 0.98rem; }
  .hero-name { font-size: 2.6rem; margin: 0 0 0.35rem; line-height: 1.08; }
  .hero-alt { font-size: 1.15rem; color: var(--fg-muted); font-weight: 600; margin-left: 0.55rem; }
  .hero-tagline {
    font-size: 1.12rem;
    font-weight: 700;
    margin: 0.1rem 0 0.3rem;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .hero-interests { margin: 0.15rem 0 0.2rem; font-size: 0.92rem; color: var(--fg-muted); font-weight: 600; }
  .hero-affil { margin: 0.2rem 0 1.1rem; font-size: 0.95rem; }

  .cta-row { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .btn {
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--fg);
    background: var(--surface);
    transition: transform 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .btn:hover {
    color: var(--fg);
    transform: translateY(-1px);
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }
  .btn-primary {
    color: #fff;
    border-color: transparent;
    background: var(--grad);
    box-shadow: var(--shadow);
  }
  .btn-primary:hover { color: #fff; filter: brightness(1.05); }

  .two-col {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .two-col .section { margin: 2.4rem 0; }

  .news { list-style: none; padding: 0.6rem 0.4rem; margin: 0; }
  .news li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
  }
  .news li + li { border-top: 1px solid var(--border); }
  :global(.news li a) {text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness:1px;}
  .news-date { font-size: 0.78rem; color: var(--accent-ink); font-weight: 700; letter-spacing: 0.02em; }
  .see-all { margin-top: 0.8rem; font-weight: 700; }
  .chips { margin-top: 1.1rem; }

  @media (max-width: 860px) {
    .two-col { grid-template-columns: 1fr; gap: 0.5rem; }
  }
  @media (max-width: 680px) {
    .hero { flex-direction: column; text-align: center; padding: 2.2rem 1.4rem; }
    .hero-photo { flex-basis: auto; }
    .hero-name { font-size: 2.1rem; }
    .cta-row { justify-content: center; }
  }
</style>

<style>
  .featured-head {display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap;margin-bottom:1.2rem;}
  .featured-head h2 {font-size:1.45rem;margin:0;}
  .featured-head>a {font-size:.9rem;font-weight:700;}
  .featured-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;}
  .featured-paper {overflow:hidden;padding:0;display:flex;flex-direction:column;}
  .featured-paper img {display:block;width:100%;height:192px;aspect-ratio:16/9;object-fit:contain;background:var(--surface-2);padding:.4rem;}
  .featured-paper-body {padding:1rem 1.25rem 1.15rem;display:flex;flex-direction:column;flex:1;}
  .featured-venue {font-size:.72rem;font-weight:780;color:var(--accent-ink);}
  .featured-paper h3 {font-size:1rem;line-height:1.45;margin:.4rem 0;}
  .featured-paper h3 a {color:var(--fg);}
  .featured-paper p {font-size:.81rem;color:var(--fg-muted);line-height:1.55;margin:.2rem 0 .8rem;}
  .featured-actions {display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:auto;font-size:.83rem;font-weight:700;}
  .home-hub {margin-top:2.4rem;}
  .home-hub>h2 {font-size:1.32rem;margin-bottom:1.1rem;}
  @media(max-width:720px){.featured-grid{grid-template-columns:1fr;}.featured-paper img{height:auto;max-height:230px;aspect-ratio:16/9;}}
</style>

<style>
  .home-profile-path {display:flex;align-items:baseline;justify-content:space-between;gap:.8rem;flex-wrap:wrap;border-bottom:1px solid var(--border);padding:.4rem 0 1rem;font-size:.86rem;}
  .home-profile-path p {margin:0;color:var(--fg-muted);}
  .home-profile-path > a {font-weight:750;}
</style>

