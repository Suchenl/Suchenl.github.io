---
import Base from '../layouts/Base.astro';
import Bi from '../components/Bi.astro';
import { AUTHOR } from '../config';
import { NEWS } from '../data';

const interests = [
  { zh: '生成式 AI（AIGC）', en: 'Generative AI (AIGC)' },
  { zh: '计算机视觉', en: 'Computer Vision' },
  { zh: '信息隐藏', en: 'Information Hiding' },
  { zh: 'AI 安全', en: 'AI Safety' },
  { zh: 'AI + 医疗', en: 'AI for Medicine' },
];

const hub = [
  { emoji: '✍️', href: '/blog/', zh: '博客', en: 'Blog', descZh: '技术笔记与思考', descEn: 'Notes & write-ups' },
  { emoji: '📝', href: '/publications/', zh: '论文', en: 'Publications', descZh: '我发表的研究工作', descEn: 'My published work' },
  { emoji: '💼', href: '/work/', zh: '经历', en: 'Experience', descZh: '实习与工作经历', descEn: 'Internships & experience' },
  { emoji: '🧠', href: '/expertise/', zh: '能力', en: 'Expertise', descZh: '各领域掌握与合作', descEn: 'Skills & collaboration' },
];

const socials = [
  { zh: '谷歌学术', en: 'Google Scholar', href: AUTHOR.links.googlescholar },
  { zh: 'GitHub', en: 'GitHub', href: AUTHOR.links.github },
  { zh: '领英', en: 'LinkedIn', href: AUTHOR.links.linkedin },
  { zh: 'ORCID', en: 'ORCID', href: AUTHOR.links.orcid },
];
---

<Base>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-photo">
      <img src={AUTHOR.avatar} alt={AUTHOR.name} width="220" height="220" />
    </div>
    <div class="hero-text">
      <p class="hero-hi"><Bi zh="你好，我是" en="Hi, I'm" /></p>
      <h1 class="hero-name">
        <span data-l="zh">{AUTHOR.nameZh}</span><span data-l="en">{AUTHOR.name}</span>
        <span class="hero-alt"><span data-l="zh">{AUTHOR.name}</span><span data-l="en">{AUTHOR.nameZh}</span></span>
      </h1>
      <p class="hero-tagline">
        <span data-l="zh">{AUTHOR.taglineZh}</span><span data-l="en">{AUTHOR.taglineEn}</span>
      </p>
      <p class="hero-interests">
        <span data-l="zh">{AUTHOR.interestsZh}</span><span data-l="en">{AUTHOR.interestsEn}</span>
      </p>
      <p class="hero-affil muted">
        <span data-l="zh">📍 {AUTHOR.affiliationZh} · {AUTHOR.locationZh}</span>
        <span data-l="en">📍 {AUTHOR.affiliation} · {AUTHOR.location}</span>
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`mailto:${AUTHOR.email}`}>
          <Bi zh="✉ 联系我" en="✉ Get in touch" />
        </a>
        {socials.map((s) => (
          <a class="btn" href={s.href} target="_blank" rel="noopener"><span data-l="zh">{s.zh}</span><span data-l="en">{s.en}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="hub-grid">
      {hub.map((h) => (
        <a class="hub-card" href={h.href}>
          <div class="hub-emoji">{h.emoji}</div>
          <h3><span data-l="zh">{h.zh}</span><span data-l="en">{h.en}</span></h3>
          <p><span data-l="zh">{h.descZh}</span><span data-l="en">{h.descEn}</span></p>
        </a>
      ))}
    </div>
  </section>

  <div class="two-col">
    <section class="section prose" id="about">
      <Bi tag="h2" zh="👋 关于我" en="👋 About Me" />
      <div data-l="zh">
        <p>
          我是<a href="http://staff.ustc.edu.cn/~zhangwm/">中国科学技术大学</a>网络空间安全学院的一年级硕士研究生，
          导师为<a href="http://staff.ustc.edu.cn/~zhangwm/">张卫明</a>教授与<a href="http://faculty.ustc.edu.cn/yunenghai/zh_CN/index.htm">俞能海</a>教授。
          此前在山东大学控制科学与工程学院获得学士学位。我的研究聚焦于人工智能、计算机视觉与安全的交叉领域。
        </p>
        <p>我乐于交流新想法与合作。如果你有大规模算力、也在寻找一个有热情的合作者一起研究有趣的问题，欢迎给我发邮件！</p>
      </div>
      <div data-l="en">
        <p>
          I am a first-year M.S. student at the School of Cyber Science and Technology,
          <a href="http://staff.ustc.edu.cn/~zhangwm/"> University of Science and Technology of China (USTC)</a>,
          advised by Prof. <a href="https://scholar.google.com/citations?user=eTCfl6cAAAAJ&hl=en">Weiming Zhang</a>
          and Prof. <a href="https://scholar.google.com/citations?user=7620QAMAAAAJ&hl=en">Nenghai Yu</a>.
          Previously I received my B.S. from Shandong University. My research lies at the intersection of AI,
          computer vision, and security.
        </p>
        <p>I love discussing new ideas and collaborations. If you have large-scale compute and are looking for a passionate collaborator, feel free to email me!</p>
      </div>
      <div class="chips">
        {interests.map((i) => (
          <span class="tag-chip"><span data-l="zh">{i.zh}</span><span data-l="en">{i.en}</span></span>
        ))}
      </div>
    </section>

    <section class="section" id="news">
      <Bi tag="h2" zh="🔥 近况" en="🔥 News" />
      <ul class="news card">
        {NEWS.map((n) => (
          <li>
            <span class="news-date">{n.date}</span>
            <span data-l="zh" set:html={n.zh} /><span data-l="en" set:html={n.en} />
          </li>
        ))}
      </ul>
      <p class="see-all">
        <a href="/publications/"><Bi zh="查看全部论文 →" en="See all publications →" /></a>
      </p>
    </section>
  </div>
</Base>

<style>
  .hero {
    position: relative;
    display: flex;
    gap: 2.6rem;
    align-items: center;
    padding: 3rem 2rem;
    margin: 1.5rem 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(600px 300px at 12% -10%, var(--bg-grad-1), transparent 60%),
      radial-gradient(500px 320px at 105% 120%, var(--bg-grad-2), transparent 55%);
    pointer-events: none;
  }
  .hero-photo { position: relative; flex: 0 0 220px; }
  .hero-photo img {
    width: 220px;
    height: 220px;
    object-fit: cover;
    border-radius: 24px;
    border: 3px solid var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .hero-text { position: relative; flex: 1 1 auto; min-width: 0; }
  .hero-hi { margin: 0 0 0.2rem; color: var(--fg-muted); font-weight: 600; font-size: 0.98rem; }
  .hero-name { font-size: 2.6rem; margin: 0 0 0.35rem; line-height: 1.08; }
  .hero-alt { font-size: 1.15rem; color: var(--fg-muted); font-weight: 600; margin-left: 0.55rem; }
  .hero-tagline {
    font-size: 1.12rem;
    font-weight: 700;
    margin: 0.1rem 0 0.3rem;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .hero-interests { margin: 0.15rem 0 0.2rem; font-size: 0.92rem; color: var(--fg-muted); font-weight: 600; }
  .hero-affil { margin: 0.2rem 0 1.1rem; font-size: 0.95rem; }

  .cta-row { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .btn {
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--fg);
    background: var(--surface);
    transition: transform 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
  }
  .btn:hover {
    color: var(--fg);
    transform: translateY(-1px);
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }
  .btn-primary {
    color: #fff;
    border-color: transparent;
    background: var(--grad);
    box-shadow: var(--shadow);
  }
  .btn-primary:hover { color: #fff; filter: brightness(1.05); }

  .two-col {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .two-col .section { margin: 2.4rem 0; }

  .news { list-style: none; padding: 0.6rem 0.4rem; margin: 0; }
  .news li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
  }
  .news li + li { border-top: 1px solid var(--border); }
  .news-date { font-size: 0.78rem; color: var(--accent-ink); font-weight: 700; letter-spacing: 0.02em; }
  .see-all { margin-top: 0.8rem; font-weight: 700; }
  .chips { margin-top: 1.1rem; }

  @media (max-width: 860px) {
    .two-col { grid-template-columns: 1fr; gap: 0.5rem; }
  }
  @media (max-width: 680px) {
    .hero { flex-direction: column; text-align: center; padding: 2.2rem 1.4rem; }
    .hero-photo { flex-basis: auto; }
    .hero-name { font-size: 2.1rem; }
    .cta-row { justify-content: center; }
  }
</style>
