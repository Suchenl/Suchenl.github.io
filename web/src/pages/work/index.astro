---

<Base title="Experience">
  <h1 class="page-title"><Bi zh="经历" en="Experience" /></h1>
  <p class="page-intro">
    <Bi zh="实习、学校科研与工作经历（未来的全职工作也会更新在此）。" en="Internships, academic research and work experience (future full-time roles will appear here too)." />
  </p>

  {sections.map((sec) => (
  <section class="section prose">
    <Bi tag="h2" zh={sec.zh} en={sec.en} />
    <ul class="timeline">
      {sec.items.map((it) => (
        <li>
          <div class="t-date"><span data-l="zh">{it.date.replace('Present', '至今')}</span><span data-l="en">{it.date}</span></div>
          <div class="t-title"><span data-l="zh">{it.roleZh}</span><span data-l="en">{it.roleEn}</span></div>
          <div class="t-org">
            {it.logo && <img class="t-logo" src={it.logo} alt="" width="22" height="22" loading="lazy" decoding="async" />}
            {it.orgUrl ? (
              <a href={it.orgUrl} target="_blank" rel="noopener"><span data-l="zh">{it.orgZh}</span><span data-l="en">{it.orgEn}</span></a>
            ) : (
              <span style="color: var(--accent-ink); font-weight: 700;"><span data-l="zh">{it.orgZh}</span><span data-l="en">{it.orgEn}</span></span>
            )}
          </div>
          {it.summaryZh && <p class="t-summary"><span data-l="zh">{it.summaryZh}</span><span data-l="en">{it.summaryEn}</span></p>}
          {it.projects && (
            <div class="t-projects">
              {it.projects.map((pr) => (
                <div class="t-project">
                  <h3 class="t-project-title">
                    <span data-l="zh">{pr.titleZh}</span><span data-l="en">{pr.titleEn}</span>
                    <span class="t-project-date"><span data-l="zh">{pr.dateZh}</span><span data-l="en">{pr.dateEn}</span></span>
                  </h3>
                  <ul>
                    {pr.items.map((p) => (
                      <li>
                        <span data-l="zh"><strong set:html={p.labelZh} />：<Fragment set:html={p.zh} /></span>
                        <span data-l="en"><strong set:html={p.labelEn} />: <Fragment set:html={p.en} /></span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
          <ul>
            <div data-l="zh">{it.pointsZh.map((p) => <li set:html={p} />)}</div>
            <div data-l="en">{it.pointsEn.map((p) => <li set:html={p} />)}</div>
          </ul>
        </li>
      ))}
    </ul>
  </section>
  ))}

  <section class="section prose">
    <Bi tag="h2" zh="🎓 教育" en="🎓 Education" />
    <ul class="timeline">
      {education.map((e) => (
        <li>
          <div class="t-date"><span data-l="zh">{e.date.replace('Present', '至今')}</span><span data-l="en">{e.date}</span></div>
          <div class="t-org t-school">
            <img class="t-logo" src={e.logo} alt="" width="22" height="22" loading="lazy" decoding="async" />
            <a href={e.url} target="_blank" rel="noopener"><span data-l="zh">{e.schoolZh}</span><span data-l="en">{e.schoolEn}</span></a>
          </div>
          <div class="t-degree"><span data-l="zh">{e.degreeZh}</span><span data-l="en">{e.degreeEn}</span></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section prose">
    <Bi tag="h2" zh="🔍 学术服务" en="🔍 Academic Service" />
    <ul>
      {service.map((s) => (
        <li><em class="muted">{s.date}</em> · <span data-l="zh">{s.zh}</span><span data-l="en">{s.en}</span></li>
      ))}
    </ul>
  </section>
</Base>
