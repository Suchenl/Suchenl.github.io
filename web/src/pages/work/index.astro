---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';

const internships = [
  {
    date: '2026.01.19 - Present',
    roleZh: '算法实习生',
    roleEn: 'Algorithm Intern',
    orgZh: '可灵 · 快手 (Kling, Kuaishou)',
    orgEn: 'Kling AI, Kuaishou',
    orgUrl: 'https://klingai.com/',
    logo: '/images/orgs/kling.png',
    pointsZh: [
      '<strong>机器人 Agent 与训练基础设施</strong>（2026.09 – 至今）：研究如何把通用多模态大模型变成可持续对话、目标驱动、能安全调用物理工具的机器人 Agent，负责 Harness 设计（动作接口、执行反馈、上下文管理）与受控评测；搭建基于 TorchTitan 的多机多卡训练栈，并复现评测 GR00T 等 VLA 基线。',
      '<strong>机器人数据引擎</strong>（2026.09 – 至今）：利用通用视频生成模型在不改变动作标签的前提下扩充机器人示范的视觉多样性，搭建“编辑 → 生成 → 质量筛选 → 重试 → 溯源”的数据生产流水线与配套评测；在仿真中用 Diffusion Policy 验证下游策略收益，并推进 Franka FR3 真机部署链路。',
      '<strong>长视频生成与视觉记忆</strong>（2026.06 – 2026.10）：搭建以“规划驱动的资产组合”为核心的长视频生产系统，按镜头、实体和世界状态决定每段生成该参考什么、排除什么。以第一作者完成 <a href="https://arxiv.org/abs/2610.35001" target="_blank" rel="noopener noreferrer">VMem-Bench</a>，系统检验视觉记忆在长视频生成中何时帮忙、何时引入过时或已离场的实体，并开源代码、数据集与项目主页。',
      '<strong>视频生成与视觉表征</strong>（2026.01 – 2026.08）：基于 Wan 系列等开源模型研究流式 / 实时视频生成与参数化记忆；从零搭建视觉 tokenizer 与自回归视觉生成的研究框架（流式数据管线、多任务训练与推理入口），探索统一视觉建模与下一帧预测；并研究前馈式动态 3D 高斯重建。',
    ],
    pointsEn: [
      '<strong>Robot agents & training infrastructure</strong> (2026.09 – present): researching how to turn general multimodal models into conversational, goal-directed robot agents that call physical tools safely—owning harness design (action interfaces, execution feedback, context management) and controlled evaluation; built a multi-node TorchTitan training stack and reproduced VLA baselines such as GR00T.',
      '<strong>Robot data engine</strong> (2026.09 – present): used general-purpose video generators to diversify the visuals of robot demonstrations while keeping recorded action labels valid, building an edit → generate → quality-screen → retry → provenance pipeline with matching evaluation; validated downstream gains with Diffusion Policy in simulation and brought up a Franka FR3 real-robot deployment path.',
      '<strong>Long-video generation & visual memory</strong> (2026.06 – 2026.10): built a long-video production system around planning-driven asset composition, deciding per shot which identities, motion and world state to reference—and which to exclude. First author of <a href="https://arxiv.org/abs/2610.35001" target="_blank" rel="noopener noreferrer">VMem-Bench</a>, a controlled study of when visual memory helps long-video generation and when it revives outdated or departed entities; code, dataset and project page are public.',
      '<strong>Video generation & visual representation</strong> (2026.01 – 2026.08): studied streaming / real-time video generation and parametric memory on open models such as Wan; built a research framework for visual tokenizers and autoregressive visual generation from scratch (streaming data pipeline, multi-task training and inference), exploring unified visual modeling and next-frame prediction; also worked on feed-forward dynamic 3D Gaussian reconstruction.',
    ],
  },
  {
    date: '2025.05 - 2025.08',
    roleZh: '算法实习生',
    roleEn: 'Algorithm Intern',
    orgZh: 'Onestory 团队',
    orgEn: 'Onestory Team',
    orgUrl: 'https://ad.yiban.io/operate/tool/1189',
    pointsZh: [
      '主导研发 <strong>LAMIC</strong>（布局感知多图合成），已集成进 Onestory 核心产品与内容创作流水线；相关论文被 <strong>AAAI 2026</strong> 接收。',
      '对 T2I / I2I 生成模型（LoRA / Flux-Kontext / EasyControl）进行微调与优化，已用于团队内容工具的线上生产。',
    ],
    pointsEn: [
      'Led <strong>LAMIC</strong> (Layout-Aware Multi-Image Composition), integrated into Onestory core products; the paper was accepted by <strong>AAAI 2026</strong>.',
      'Fine-tuned and optimized T2I / I2I generative models (LoRA / Flux-Kontext / EasyControl) for production content tools.',
    ],
  },
  {
    date: '2024.10 - 2025.05',
    roleZh: '研究助理',
    roleEn: 'Research Assistant',
    orgZh: '张卫明课题组，中国科学技术大学',
    orgEn: 'Weiming Group, USTC',
    orgUrl: 'http://staff.ustc.edu.cn/~zhangwm/index.html',
    pointsZh: [
      '研发 <strong>TAG-WM</strong>，用于生成图像的篡改定位与版权保护，成果被计算机视觉顶会 <strong>ICCV 2025</strong> 接收。',
    ],
    pointsEn: [
      'Developed <strong>TAG-WM</strong> for tamper localization and copyright protection of generative images, accepted by <strong>ICCV 2025</strong>.',
    ],
  },
];

const education = [
  {
    date: '2025.09 - Present',
    zh: '中国科学技术大学，网络空间安全学院（硕士）',
    en: 'M.S., School of Cyber Science and Technology, USTC',
  },
  {
    date: '2021.09 - 2025.06',
    zh: '山东大学，控制科学与工程学院（学士）',
    en: 'B.S., School of Control Science and Engineering, Shandong University',
  },
];

const service = [
  { date: '2026.08', zh: 'AAAI 2027 审稿人', en: 'Reviewer, AAAI 2027' },
  { date: '2025.08', zh: 'AAAI 2026 审稿人', en: 'Reviewer, AAAI 2026' },
];
---

<Base title="Experience">
  <h1 class="page-title"><Bi zh="经历" en="Experience" /></h1>
  <p class="page-intro">
    <Bi zh="实习、研究与工作经历（未来的全职工作也会更新在此）。" en="Internships, research and work experience (future full-time roles will appear here too)." />
  </p>

  <section class="section prose">
    <Bi tag="h2" zh="💼 实习" en="💼 Internships" />
    <ul class="timeline">
      {internships.map((it) => (
        <li>
          <div class="t-date"><span data-l="zh">{it.date.replace('Present', '至今')}</span><span data-l="en">{it.date}</span></div>
          <div class="t-title"><span data-l="zh">{it.roleZh}</span><span data-l="en">{it.roleEn}</span></div>
          <div class="t-org">
            {it.logo && <img class="t-logo" src={it.logo} alt="" width="22" height="22" loading="lazy" decoding="async" />}
            {it.orgUrl ? (
              <a href={it.orgUrl} target="_blank" rel="noopener"><span data-l="zh">{it.orgZh}</span><span data-l="en">{it.orgEn}</span></a>
            ) : (
              <span style="color: var(--accent-ink); font-weight: 700;"><span data-l="zh">{it.orgZh}</span><span data-l="en">{it.orgEn}</span></span>
            )}
          </div>
          <ul>
            <div data-l="zh">{it.pointsZh.map((p) => <li set:html={p} />)}</div>
            <div data-l="en">{it.pointsEn.map((p) => <li set:html={p} />)}</div>
          </ul>
        </li>
      ))}
    </ul>
  </section>

  <section class="section prose">
    <Bi tag="h2" zh="🎓 教育" en="🎓 Education" />
    <ul class="timeline">
      {education.map((e) => (
        <li>
          <div class="t-date"><span data-l="zh">{e.date.replace('Present', '至今')}</span><span data-l="en">{e.date}</span></div>
          <div class="t-title"><span data-l="zh">{e.zh}</span><span data-l="en">{e.en}</span></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section prose">
    <Bi tag="h2" zh="🔍 学术服务" en="🔍 Academic Service" />
    <ul>
      {service.map((s) => (
        <li><em class="muted">{s.date}</em> · <span data-l="zh">{s.zh}</span><span data-l="en">{s.en}</span></li>
      ))}
    </ul>
  </section>
</Base>
