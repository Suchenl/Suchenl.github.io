---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';

const internships = [
  {
    date: '2026.01.19 - Present',
    roleZh: '算法实习生',
    roleEn: 'Algorithm Intern',
    orgZh: '可灵 · 快手 (Kling, Kuaishou)',
    orgEn: 'Kling AI, Kuaishou',
    orgUrl: 'https://klingai.com/',
    logo: '/images/orgs/kling.png',
    pointsZh: [
      '<strong>机器人 Agent 与训练基础设施</strong>（2026.09 – 至今）：研究如何把通用多模态大模型变成可持续对话、目标驱动、能安全调用物理工具的机器人 Agent。主导 Harness 设计（统一动作工具、只读运动规划预览、动作前预测与真实执行反馈、长上下文管理），在 RoboTwin 中用 DeepSeek-V4.1-Flash（B200 · TP=4 · 1M 上下文）跑通多步闭环执行；生产 20,590 条交互轨迹，其中 8,503 条通过服务端一致性校验；将 27.8B 参数多模态模型的训练迁移到面向 48×B200 的 TorchTitan 栈（LoRA / 全参 × ViT 冻结 / 可训四种模式）。',
      '<strong>ManyWorlds · 机器人数据引擎</strong>（2026.08 – 2026.11）：用冻结的通用视频生成模型在保持原始动作标签不变的前提下扩充机器人示范的视觉多样性，搭建“编辑 → 生成 → 动作兼容 / 编辑完成联合筛选 → 重试 → 溯源”的生产引擎。从 25 种本体的 6,414 条源轨迹产出 <strong>80,894</strong> 条筛选后的视频–动作对（约 162 小时视频），共 129,272 个请求、放行率 62.6%、4,509 B200 GPU 时。人工审核中动作不兼容率由 23.9% 降至 3.3%；在 4 个 RoboTwin 2.0 任务上用 Diffusion Policy 验证，成功率由 41.7 / 19.2 / 0.0 提升至 56.5 / 45.5 / 18.7（Clean / Light / Mixed）。并打通 Franka FR3 双相机观测 → 远程推理 → 目标机执行器的真机链路。',
      '<strong>Montage / MemStrata · 长视频生成与视觉记忆</strong>（2026.06 – 2026.10）：搭建以“规划驱动的资产组合”为核心的长视频生产系统 Montage 及其记忆管理方法 MemStrata，按镜头、实体和世界状态决定每段生成该参考什么、排除什么。以第一作者完成 <a href="https://suchenl.github.io/VMem-Bench/" target="_blank" rel="noopener noreferrer">VMem-Bench</a>，系统检验视觉记忆在长视频生成中何时帮忙、何时引入过时或已离场的实体，并开源<a href="https://arxiv.org/abs/2610.35001" target="_blank" rel="noopener noreferrer">论文</a>、<a href="https://github.com/Suchenl/VMem-Bench" target="_blank" rel="noopener noreferrer">代码</a>与<a href="https://huggingface.co/datasets/Suchenl/VMem-Bench" target="_blank" rel="noopener noreferrer">数据集</a>。',
      '<strong>VisionTok-Gen · 视频生成与视觉表征</strong>（2026.01 – 2026.06）：基于 Wan 系列等开源模型研究流式 / 实时视频生成与参数化记忆；从零搭建视觉 tokenizer 与自回归视觉生成的研究框架 VisionTok-Gen（流式数据管线、多任务训练与推理入口，历经三版重构），探索超球面路径约束（HSPC）的统一视觉建模与下一帧预测；并研究前馈式动态 3D 高斯重建。',
    ],
    pointsEn: [
      '<strong>Robot agents & training infrastructure</strong> (2026.09 – present): researching how to turn general multimodal models into conversational, goal-directed robot agents that call physical tools safely. Lead the harness design (a unified action tool, read-only motion-planning previews, pre-action prediction with measured execution feedback, long-context management) and ran multi-step closed-loop episodes in RoboTwin with DeepSeek-V4.1-Flash (B200, TP=4, 1M context). Produced 20,590 interaction trajectories, 8,503 of which pass server-side parity checks, and migrated training of a 27.8B-parameter multimodal model to a TorchTitan stack targeting 48×B200 (LoRA / full × frozen / trainable ViT).',
      '<strong>ManyWorlds · robot data engine</strong> (2026.08 – 2026.11): uses frozen general-purpose video generators to diversify the visuals of robot demonstrations while keeping recorded actions valid, via an edit → generate → joint action-compatibility / edit-success screening → retry → provenance engine. Produced <strong>80,894</strong> screened video–action pairs (~162 h of video) from 6,414 source trajectories across 25 embodiments—129,272 requests, 62.6% release rate, 4,509 B200 GPU-hours. Human audit shows action incompatibility dropping from 23.9% to 3.3%; on four RoboTwin 2.0 tasks, Diffusion Policy success improves from 41.7 / 19.2 / 0.0 to 56.5 / 45.5 / 18.7 (Clean / Light / Mixed). Also brought up a Franka FR3 path from dual-camera observations to remote inference and the on-robot executor.',
      '<strong>Montage / MemStrata · long-video generation & visual memory</strong> (2026.06 – 2026.10): built Montage, a long-video production system around planning-driven asset composition, with its memory-management method MemStrata, deciding per shot which identities, motion and world state to reference—and which to exclude. First author of <a href="https://suchenl.github.io/VMem-Bench/" target="_blank" rel="noopener noreferrer">VMem-Bench</a>, a controlled study of when visual memory helps long-video generation and when it revives outdated or departed entities, with public <a href="https://arxiv.org/abs/2610.35001" target="_blank" rel="noopener noreferrer">paper</a>, <a href="https://github.com/Suchenl/VMem-Bench" target="_blank" rel="noopener noreferrer">code</a> and <a href="https://huggingface.co/datasets/Suchenl/VMem-Bench" target="_blank" rel="noopener noreferrer">dataset</a>.',
      '<strong>VisionTok-Gen · video generation & visual representation</strong> (2026.01 – 2026.06): studied streaming / real-time video generation and parametric memory on open models such as Wan; built VisionTok-Gen, a research framework for visual tokenizers and autoregressive visual generation, from scratch through three rewrites (streaming data pipeline, multi-task training and inference), exploring hyperspherical-path-constrained (HSPC) unified visual modeling and next-frame prediction; also worked on feed-forward dynamic 3D Gaussian reconstruction.',
    ],
  },
  {
    date: '2025.05 - 2025.08',
    roleZh: '算法实习生',
    roleEn: 'Algorithm Intern',
    orgZh: 'OneStory 团队（创壹科技）',
    orgEn: 'OneStory Team (CreateOne)',
    orgUrl: 'https://www.onestory.art/',
    logo: '/images/orgs/onestory.svg',
    pointsZh: [
      '<strong>背景</strong>：电商与影视内容制作中需要把多张参考图里的主体按指定布局合成到同一画面。现有多参考方法（如 <a href="https://github.com/bytedance/XVerse" target="_blank" rel="noopener noreferrer">XVerse</a>）在多图一致性上不足，布局控制方法（如 <a href="https://github.com/lllyasviel/ControlNet" target="_blank" rel="noopener noreferrer">ControlNet</a>、<a href="https://github.com/Xiaojiu-z/EasyControl" target="_blank" rel="noopener noreferrer">EasyControl</a>）则依赖成本较高的标注数据训练。',
      '<strong><a href="https://arxiv.org/abs/2508.00477" target="_blank" rel="noopener noreferrer">LAMIC</a>（布局感知多图合成，第一作者）</strong>：提出无需训练的方案，基于单参考 DiT 编辑模型 <a href="https://huggingface.co/black-forest-labs/FLUX.1-Kontext-dev" target="_blank" rel="noopener noreferrer">FLUX.1 Kontext</a>，以组隔离注意力（GIA）分离不同参考主体、以区域调制注意力（RMA）把主体约束到指定区域，把单参考模型零样本扩展到多参考、可控布局的合成；论文被 <strong>AAAI 2026</strong> 接收，<a href="https://github.com/Suchenl/LAMIC" target="_blank" rel="noopener noreferrer">代码</a>已开源。',
      '<strong>落地</strong>：生成质量在论文对比中超过已有 SOTA 方法，相关算法已集成进 OneStory 的 AIGC 内容生产管线，降低了布局可控多图合成的定制开发成本。',
      '<strong>模型微调</strong>：基于 <a href="https://arxiv.org/abs/2106.09685" target="_blank" rel="noopener noreferrer">LoRA</a>、<a href="https://huggingface.co/black-forest-labs/FLUX.1-Kontext-dev" target="_blank" rel="noopener noreferrer">FLUX.1 Kontext</a>、<a href="https://github.com/Xiaojiu-z/EasyControl" target="_blank" rel="noopener noreferrer">EasyControl</a> 等对文生图 / 图生图模型进行微调与优化，用于团队内容工具的线上生产。',
    ],
    pointsEn: [
      '<strong>Problem</strong>: e-commerce and film content often needs subjects from several reference images composed into one layout. Multi-reference methods (e.g., <a href="https://github.com/bytedance/XVerse" target="_blank" rel="noopener noreferrer">XVerse</a>) struggle with cross-image consistency, while layout-control methods (e.g., <a href="https://github.com/lllyasviel/ControlNet" target="_blank" rel="noopener noreferrer">ControlNet</a>, <a href="https://github.com/Xiaojiu-z/EasyControl" target="_blank" rel="noopener noreferrer">EasyControl</a>) require costly annotated training data.',
      '<strong><a href="https://arxiv.org/abs/2508.00477" target="_blank" rel="noopener noreferrer">LAMIC</a> (Layout-Aware Multi-Image Composition, first author)</strong>: a training-free approach that extends the single-reference DiT editor <a href="https://huggingface.co/black-forest-labs/FLUX.1-Kontext-dev" target="_blank" rel="noopener noreferrer">FLUX.1 Kontext</a> zero-shot to multi-reference, layout-controlled composition, using Group Isolation Attention (GIA) to separate subjects and Region-Modulated Attention (RMA) to keep each in its region. Accepted by <strong>AAAI 2026</strong>; <a href="https://github.com/Suchenl/LAMIC" target="_blank" rel="noopener noreferrer">code</a> is open source.',
      '<strong>Deployment</strong>: outperformed prior state-of-the-art methods in the paper\'s comparisons; the algorithm was integrated into OneStory\'s AIGC content pipeline, reducing custom development cost for layout-controlled multi-image composition.',
      '<strong>Model fine-tuning</strong>: fine-tuned and optimized text-to-image / image-to-image models with <a href="https://arxiv.org/abs/2106.09685" target="_blank" rel="noopener noreferrer">LoRA</a>, <a href="https://huggingface.co/black-forest-labs/FLUX.1-Kontext-dev" target="_blank" rel="noopener noreferrer">FLUX.1 Kontext</a> and <a href="https://github.com/Xiaojiu-z/EasyControl" target="_blank" rel="noopener noreferrer">EasyControl</a> for production content tools.',
    ],
  },
];

const school = [
  {
    date: '2024.10 - Present',
    roleZh: '硕士课题组研究',
    roleEn: 'M.S. Lab Research',
    orgZh: '网络空间安全学院，中国科学技术大学',
    orgEn: 'School of Cyber Science and Technology, USTC',
    orgUrl: 'https://cybersec.ustc.edu.cn/',
    logo: '/images/orgs/ustc.png',
    pointsZh: [
      '<strong><a href="https://openaccess.thecvf.com/content/ICCV2025/html/Chen_TAG-WM_Tamper-Aware_Generative_Image_Watermarking_via_Diffusion_Inversion_Sensitivity_ICCV_2025_paper.html" target="_blank" rel="noopener noreferrer">TAG-WM</a>：篡改感知的生成图像水印（第一作者，ICCV 2025）</strong>（2024.12 – 2025.03）：传统后处理水印会破坏生成图像的流形分布、增加推理开销，且只能证明来源、难以指出哪里被改。TAG-WM 在扩散采样阶段把版权水印与定位水印联合嵌入潜空间，不额外训练生成模型；再利用扩散反演对局部篡改高度敏感、对常见失真相对稳健的特性，在提取版权信息的同时定位篡改区域。在 Stable Diffusion v1.5 / v2.1 上，抗 JPEG 压缩、高斯模糊及各类内容篡改的表现超过已有方法 10% 以上；<a href="https://github.com/Suchenl/TAG-WM" target="_blank" rel="noopener noreferrer">代码</a>已开源。',
      '<strong><a href="https://arxiv.org/abs/2604.15003" target="_blank" rel="noopener noreferrer">Flow of Truth</a>：面向图生视频的主动式时序取证（第一作者）</strong>（2025.08 – 2025.11）：把图生视频理解为随时间演化的像素运动，而非逐帧独立生成；设计可学习的取证模板与模板引导的运动模块，让取证信号跟随内容运动传播，在多种开源与商业图生视频模型上验证了时序追踪效果。',
    ],
    pointsEn: [
      '<strong><a href="https://openaccess.thecvf.com/content/ICCV2025/html/Chen_TAG-WM_Tamper-Aware_Generative_Image_Watermarking_via_Diffusion_Inversion_Sensitivity_ICCV_2025_paper.html" target="_blank" rel="noopener noreferrer">TAG-WM</a>: tamper-aware generative image watermarking (first author, ICCV 2025)</strong> (2024.12 – 2025.03): post-hoc watermarks distort the generated-image manifold, add inference cost, and prove provenance without showing where an image was edited. TAG-WM jointly embeds copyright and localization marks into the diffusion latent during sampling—no generator retraining—and exploits diffusion inversion\'s sensitivity to local edits (and robustness to common distortions) to localize tampering while recovering the copyright message. On Stable Diffusion v1.5 / v2.1 it beats prior methods by over 10% under JPEG compression, Gaussian blur and content tampering; <a href="https://github.com/Suchenl/TAG-WM" target="_blank" rel="noopener noreferrer">code</a> is open source.',
      '<strong><a href="https://arxiv.org/abs/2604.15003" target="_blank" rel="noopener noreferrer">Flow of Truth</a>: proactive temporal forensics for image-to-video generation (first author)</strong> (2025.08 – 2025.11): treats image-to-video synthesis as evolving pixel motion rather than independent frames, using a learnable forensic template and a template-guided motion module so the forensic signal follows the content; validated on open-source and commercial image-to-video models.',
    ],
  },
  {
    date: '2021.09 - 2025.06',
    roleZh: '本科科研与荣誉',
    roleEn: 'Undergraduate Research & Honors',
    orgZh: '控制科学与工程学院，山东大学',
    orgEn: 'School of Control Science and Engineering, Shandong University',
    orgUrl: 'https://www.sdu.edu.cn/',
    logo: '/images/orgs/sdu.png',
    pointsZh: [
      '<strong><a href="https://www.sciencedirect.com/science/article/pii/S1746809425002101" target="_blank" rel="noopener noreferrer">DAFFNet</a>：白细胞分类的双注意力特征融合网络（共同第一作者，BSPC）</strong>：将细胞核、胞质等显式形态线索与深层语义特征通过通道 / 空间双注意力融合，并以深度监督和半监督学习训练形态分支；在 PBC、LISC、Raabin-WBC、BCCD、LDWBC、Labelled 六个数据集上准确率达 98.77% / 91.30% / 98.36% / 99.71% / 98.45% / 98.85%。',
      '<strong><a href="https://pubmed.ncbi.nlm.nih.gov/38964248/" target="_blank" rel="noopener noreferrer">肾小球疾病高光谱分类</a>（第二作者，CMPB）</strong>：结合高光谱病理图像的空间结构与光谱信息（波段筛选 + Gramian Angular Field），以 CNN 与 Vision Transformer 融合的 CVT 模型分类肾小球疾病，准确率由仅用光谱的 85.24% 提升至 94%。',
      '<strong>学业与荣誉</strong>：GPA 90.4/100（专业前 10%），推免至中国科学技术大学；获学业奖学金一等奖、山东大学优秀毕业生、优秀学生干部、优秀班长。',
    ],
    pointsEn: [
      '<strong><a href="https://www.sciencedirect.com/science/article/pii/S1746809425002101" target="_blank" rel="noopener noreferrer">DAFFNet</a>: dual-attention feature fusion for white-blood-cell classification (co-first author, BSPC)</strong>: fuses explicit nucleus / cytoplasm morphology cues with deep semantic features via channel and spatial attention, training the morphology branch with deep supervision and semi-supervised learning; reaches 98.77% / 91.30% / 98.36% / 99.71% / 98.45% / 98.85% accuracy on PBC, LISC, Raabin-WBC, BCCD, LDWBC and Labelled.',
      '<strong><a href="https://pubmed.ncbi.nlm.nih.gov/38964248/" target="_blank" rel="noopener noreferrer">Hyperspectral glomerular-disease classification</a> (second author, CMPB)</strong>: combines spatial structure and spectral signals of hyperspectral pathology images (band selection + Gramian Angular Field) in a CNN–Vision Transformer (CVT) classifier, improving accuracy from 85.24% (spectral only) to 94%.',
      '<strong>Academics & honors</strong>: GPA 90.4/100 (top 10%), recommended for admission to USTC without entrance exam; First-Class Academic Scholarship, Outstanding Graduate of Shandong University, Outstanding Student Cadre, Outstanding Class Monitor.',
    ],
  },
];

const sections = [
  { zh: '💼 实习', en: '💼 Internships', items: internships },
  { zh: '🏫 学校经历', en: '🏫 Academic Experience', items: school },
];

const education = [
  {
    date: '2025.09 - Present',
    schoolZh: '中国科学技术大学',
    schoolEn: 'University of Science and Technology of China (USTC)',
    degreeZh: '硕士 · 网络空间安全学院 · 网络空间安全专业',
    degreeEn: 'M.S. in Cyberspace Security, School of Cyber Science and Technology',
    url: 'https://www.ustc.edu.cn/',
    logo: '/images/orgs/ustc.png',
  },
  {
    date: '2021.09 - 2025.06',
    schoolZh: '山东大学',
    schoolEn: 'Shandong University',
    degreeZh: '学士 · 控制科学与工程学院 · 生物医学工程专业（自动化类）',
    degreeEn: 'B.S. in Biomedical Engineering (Automation), School of Control Science and Engineering',
    url: 'https://www.sdu.edu.cn/',
    logo: '/images/orgs/sdu.png',
  },
];

const service = [
  { date: '2026.10', zh: 'ICLR 2027 审稿人', en: 'Reviewer, ICLR 2027' },
  { date: '2026.08', zh: 'AAAI 2027 审稿人', en: 'Reviewer, AAAI 2027' },
  { date: '2025.08', zh: 'AAAI 2026 审稿人', en: 'Reviewer, AAAI 2026' },
  { date: '2024', zh: 'Biomedical Signal Processing and Control（BSPC）期刊审稿人', en: 'Reviewer, Biomedical Signal Processing and Control (BSPC)' },
];
---

<Base title="Experience">
  <h1 class="page-title"><Bi zh="经历" en="Experience" /></h1>
  <p class="page-intro">
    <Bi zh="实习、学校科研与工作经历（未来的全职工作也会更新在此）。" en="Internships, academic research and work experience (future full-time roles will appear here too)." />
  </p>

  {sections.map((sec) => (
  <section class="section prose">
    <Bi tag="h2" zh={sec.zh} en={sec.en} />
    <ul class="timeline">
      {sec.items.map((it) => (
        <li>
          <div class="t-date"><span data-l="zh">{it.date.replace('Present', '至今')}</span><span data-l="en">{it.date}</span></div>
          <div class="t-title"><span data-l="zh">{it.roleZh}</span><span data-l="en">{it.roleEn}</span></div>
          <div class="t-org">
            {it.logo && <img class="t-logo" src={it.logo} alt="" width="22" height="22" loading="lazy" decoding="async" />}
            {it.orgUrl ? (
              <a href={it.orgUrl} target="_blank" rel="noopener"><span data-l="zh">{it.orgZh}</span><span data-l="en">{it.orgEn}</span></a>
            ) : (
              <span style="color: var(--accent-ink); font-weight: 700;"><span data-l="zh">{it.orgZh}</span><span data-l="en">{it.orgEn}</span></span>
            )}
          </div>
          <ul>
            <div data-l="zh">{it.pointsZh.map((p) => <li set:html={p} />)}</div>
            <div data-l="en">{it.pointsEn.map((p) => <li set:html={p} />)}</div>
          </ul>
        </li>
      ))}
    </ul>
  </section>
  ))}

  <section class="section prose">
    <Bi tag="h2" zh="🎓 教育" en="🎓 Education" />
    <ul class="timeline">
      {education.map((e) => (
        <li>
          <div class="t-date"><span data-l="zh">{e.date.replace('Present', '至今')}</span><span data-l="en">{e.date}</span></div>
          <div class="t-org t-school">
            <img class="t-logo" src={e.logo} alt="" width="22" height="22" loading="lazy" decoding="async" />
            <a href={e.url} target="_blank" rel="noopener"><span data-l="zh">{e.schoolZh}</span><span data-l="en">{e.schoolEn}</span></a>
          </div>
          <div class="t-degree"><span data-l="zh">{e.degreeZh}</span><span data-l="en">{e.degreeEn}</span></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section prose">
    <Bi tag="h2" zh="🔍 学术服务" en="🔍 Academic Service" />
    <ul>
      {service.map((s) => (
        <li><em class="muted">{s.date}</em> · <span data-l="zh">{s.zh}</span><span data-l="en">{s.en}</span></li>
      ))}
    </ul>
  </section>
</Base>
