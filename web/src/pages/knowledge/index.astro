---
import Base from '../../layouts/Base.astro';
import { createKnowledgeNetwork } from '../../lib/knowledge-network';
import '../../styles/knowledge-network.css';

const graph = await createKnowledgeNetwork();
const byId=new Map(graph.nodes.map(node=>[node.id,node]));
const serialized=JSON.stringify(graph).replace(/</g,'\\u003c');
const areaNodes=graph.nodes.filter(node=>node.kind==='area');
const root=byId.get('knowledge:root')!;
const links=graph.edges.map(edge=>({ ...edge, fromNode:byId.get(edge.from)!,toNode:byId.get(edge.to)! }));
---
<Base title="个人知识体系" description="通过可探索的知识网络，发现已收录的公开知识、待建设的主题与下一步学习路径。">
  <div class="kn-page" id="kn-page">
    <header class="kn-intro">
      <p class="kn-eyebrow">A LIVING MAP OF KNOWLEDGE</p>
      <h1><span data-l="zh">个人知识体系</span><span data-l="en">Personal Knowledge System</span></h1>
      <p><span data-l="zh">知识不是一串孤立文章，而是一张可以持续点亮的网络。从一个问题开始，找到相关概念、真实资料与下一步学习方向。</span><span data-l="en">Knowledge is a connected, evolving map—not a list of isolated articles. Find what is published, what is missing, and what to learn next.</span></p>
    </header>
    <section class="kn-explorer" aria-labelledby="kn-title">
      <div class="kn-explorer-head">
        <div>
          <p class="kn-small-label">KNOWLEDGE ATLAS / 01</p>
          <h2 id="kn-title"><span data-l="zh">点亮知识网络</span><span data-l="en">Illuminate the knowledge map</span></h2>
          <p><span data-l="zh">实心节点表示已有公开知识，空心节点表示待建设；这不是个人能力或掌握程度评级。</span><span data-l="en">Filled nodes have public references; hollow nodes are not yet covered. Coverage never implies personal mastery.</span></p>
        </div>
        <div class="kn-stat">
          <strong>{graph.stats.ready}<span> / {graph.stats.topics}</span></strong>
          <small><span data-l="zh">已收录专题 / 规划专题</span><span data-l="en">Topics with content / planned</span></small>
        </div>
      </div>
      <div class="kn-toolbar" aria-label="Knowledge map tools">
        <label class="kn-search-wrap" for="kn-search">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.7"/></svg>
          <input id="kn-search" type="search" autocomplete="off" placeholder="搜索知识领域与主题…" />
        </label>
        <div class="kn-filters" aria-label="筛选节点">
          <button type="button" class="active" data-kn-filter="all" aria-pressed="true"><span data-l="zh">全部</span><span data-l="en">All</span></button>
          <button type="button" data-kn-filter="ready" aria-pressed="false"><span data-l="zh">已有资料</span><span data-l="en">Covered</span></button>
          <button type="button" data-kn-filter="empty" aria-pressed="false"><span data-l="zh">待建设</span><span data-l="en">Uncovered</span></button>
        </div>
      </div>
      <div class="kn-legend">
        <span><i class="kn-swatch kn-swatch-ready"></i><span data-l="zh">已有公开资料</span><span data-l="en">Has public content</span></span>
        <span><i class="kn-swatch kn-swatch-partial"></i><span data-l="zh">部分覆盖</span><span data-l="en">Partly covered</span></span>
        <span><i class="kn-swatch kn-swatch-empty"></i><span data-l="zh">待建设</span><span data-l="en">Not covered</span></span>
        <span><i class="kn-swatch kn-swatch-learned"></i><span data-l="zh">个人标记已学习</span><span data-l="en">Marked studied locally</span></span>
      </div>
      <div class="kn-layout">
        <div class="kn-map-wrap">
          <div class="kn-viewport" tabindex="0" role="region" aria-label="知识网络，可左右滚动查看，使用 Tab 选择节点">
            <svg class="kn-svg" id="kn-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1120 650" role="group" aria-label="可交互的知识领域网络">
              <defs>
                <radialGradient id="kn-glow"><stop offset="0%" stop-color="#56bcae" stop-opacity=".16"/><stop offset="100%" stop-color="#56bcae" stop-opacity="0"/></radialGradient>
              </defs>
              <circle cx={root.x} cy={root.y} r="162" fill="url(#kn-glow)" aria-hidden="true"/>
              {links.map(edge=><path
                class:list={['kn-edge',edge.kind==='related'?'kn-edge-related':'kn-edge-hierarchy']}
                data-from={edge.from} data-to={edge.to} data-edge-kind={edge.kind}
                d={edge.kind==='related'
                  ? 'M '+edge.fromNode.x+' '+edge.fromNode.y+' Q '+((edge.fromNode.x+edge.toNode.x)/2)+' '+((edge.fromNode.y+edge.toNode.y)/2-42)+' '+edge.toNode.x+' '+edge.toNode.y
                  : 'M '+edge.fromNode.x+' '+edge.fromNode.y+' L '+edge.toNode.x+' '+edge.toNode.y
                }
                fill="none" stroke-width={edge.kind==='related'?1.4:1.3}
              />)}
              {graph.nodes.map(node=><g
                class:list={['kn-node','kn-node-'+node.kind,'kn-phase-'+node.phase]}
                transform={'translate('+node.x+' '+node.y+')'}
                role="button" tabindex="0" aria-pressed="false"
                data-node-id={node.id} data-phase={node.phase}
                aria-label={node.titleZh+'；'+(node.phase==='empty'?'待建设':'有公开资料')}
              >
                <title>{node.titleZh} · {node.count} 项公开内容</title>
                {node.kind==='root'&&<circle class="kn-root-halo" r="49"/>}
                <circle class="kn-node-hit" r={node.kind==='root'?41:node.kind==='area'?29:22}/>
                <circle class="kn-node-ring" r={node.kind==='root'?28:node.kind==='area'?19:12}/>
                <circle class="kn-node-core" r={node.kind==='root'?19:node.kind==='area'?12:6.5}/>
                {node.kind==='topic'&&<circle class="kn-learned-mark" cx="11" cy="-10" r="5.2" />}
                <text class="kn-node-label" text-anchor="middle" y={node.kind==='root'?54:node.kind==='area'?41:32}>
                  <tspan data-l="zh">{node.shortZh}</tspan><tspan data-l="en">{node.shortEn}</tspan>
                </text>
                {node.kind==='area'&&<text class="kn-node-count" text-anchor="middle" y="-31">{node.count} DOCS</text>}
              </g>)}
            </svg>
          </div>
          <p class="kn-map-hint"><span data-l="zh">选择节点查看可读资料与关联方向。手机端可左右滑动地图，也可以使用下方的文字目录。</span><span data-l="en">Select a node to view sources and related topics. Swipe horizontally on mobile, or use the text index below.</span></p>
        </div>
        <aside class="kn-inspector" id="kn-inspector" aria-label="知识节点详情">
          <div class="kn-inspector-top"><span id="kn-kind">KNOWLEDGE</span><span id="kn-phase">知识图谱</span></div>
          <h3 id="kn-detail-title">个人知识体系</h3>
          <p id="kn-detail-description">按公开知识条目构建的动态专题网络。</p>
          <div class="kn-inspector-metrics">
            <div><strong id="kn-detail-count">{graph.stats.publicDocs}</strong><span data-l="zh">相关条目</span><span data-l="en">Related entries</span></div>
            <div><strong id="kn-detail-progress">—</strong><span data-l="zh">学习标记</span><span data-l="en">Study mark</span></div>
          </div>
          <div class="kn-detail-actions">
            <a id="kn-open" href="/research/"><span data-l="zh">探索研究知识库</span><span data-l="en">Explore research library</span></a>
            <button type="button" id="kn-studied" hidden><span data-l="zh">标记为已学习</span><span data-l="en">Mark as studied</span></button>
            <button type="button" id="kn-ai-prompt" hidden><span data-l="zh">复制 AI 补全任务</span><span data-l="en">Copy AI drafting task</span></button>
          </div>
          <h4 id="kn-sources-label"><span data-l="zh">推荐阅读</span><span data-l="en">Suggested reading</span></h4>
          <ul class="kn-sources" id="kn-sources"><li><a href="/research/">研究知识库</a></li></ul>
          <h4 id="kn-related-label"><span data-l="zh">知识关联</span><span data-l="en">Connections</span></h4>
          <div id="kn-connections" class="kn-connections"></div>
          <p class="kn-local-note"><span data-l="zh">学习标记只保存于当前浏览器；AI 补全需人工核验后才能公开，不会自动发布。</span><span data-l="en">Study marks stay in this browser only. AI-generated drafts require review; nothing is auto-published.</span></p>
          <textarea id="kn-prompt-fallback" readonly rows="6" hidden aria-label="复制失败时可手动选择的 AI 提示词"></textarea>
          <p id="kn-feedback" class="kn-feedback" role="status" aria-live="polite"></p>
        </aside>
      </div>
    </section>
    <section class="kn-directory" id="knowledge-directory" aria-labelledby="kn-directory-title">
      <div class="kn-directory-head">
        <div><p class="kn-small-label">EXPLORE / 02</p><h2 id="kn-directory-title"><span data-l="zh">从领域进入知识</span><span data-l="en">Explore by area</span></h2></div>
        <p><span data-l="zh">这里显示所有已定义的领域；灰色方向代表公开知识仍待建设，并非不存在相关学问。</span><span data-l="en">Uncovered means this library has no categorized public content yet—not that knowledge doesn't exist elsewhere.</span></p>
      </div>
      <div class="kn-directory-grid">
        {areaNodes.map(area=><article class="kn-area-card">
          <div class="kn-area-meta"><span class:list={['kn-area-dot','kn-area-dot-'+area.phase]}></span><small>{area.planned?'PLANNED AREA':'RESEARCH AREA'}</small><span>{area.count} <span data-l="zh">篇</span><span data-l="en">docs</span></span></div>
          <h3><span data-l="zh">{area.titleZh}</span><span data-l="en">{area.titleEn}</span></h3>
          <p><span data-l="zh">{area.descriptionZh}</span><span data-l="en">{area.descriptionEn}</span></p>
          <div class="kn-area-bottom">
            {area.href
              ? <a href={area.href}><span data-l="zh">进入领域</span><span data-l="en">Open area</span> ↗</a>
              : <button type="button" data-kn-select={area.id}><span data-l="zh">查看待建设方向</span><span data-l="en">View planned area</span> ↗</button>
            }
          </div>
        </article>)}
      </div>
    </section>
    <section class="kn-explain" aria-labelledby="kn-explain-title">
      <div><p class="kn-small-label">HOW IT GROWS / 03</p><h2 id="kn-explain-title"><span data-l="zh">从没有点亮，到真正理解</span><span data-l="en">From an uncovered topic to understanding</span></h2></div>
      <div class="kn-steps">
        <div><strong>01</strong><span data-l="zh">发现空白</span><span data-l="en">Spot a gap</span><p><span data-l="zh">选择没有资料的节点。</span><span data-l="en">Select an uncovered node.</span></p></div>
        <div><strong>02</strong><span data-l="zh">AI 辅助建设</span><span data-l="en">AI-assisted draft</span><p><span data-l="zh">明确问题、查证来源、生成待审草稿。</span><span data-l="en">Research sources and prepare a reviewable draft.</span></p></div>
        <div><strong>03</strong><span data-l="zh">审核公开</span><span data-l="en">Review and publish</span><p><span data-l="zh">人工确认后，知识资源才真正点亮。</span><span data-l="en">A topic lights up only after reviewed content is published.</span></p></div>
        <div><strong>04</strong><span data-l="zh">学习与修订</span><span data-l="en">Learn and revise</span><p><span data-l="zh">亲自理解、再检验与持续纠正。</span><span data-l="en">Study, verify and refine your understanding.</span></p></div>
      </div>
      <p class="kn-source-note"><span data-l="zh">已收录状态自动来自公开 Markdown 的领域分类；专题关系不代表因果。现有研究阅读器与论文解读入口继续保留：</span><span data-l="en">Coverage is derived from categorized public Markdown, not inferred mastery. Existing research routes remain available:</span> <a href="/research/">Research</a> · <a href="/paper-notes/">Paper Notes</a> · <a href="/questions/">Questions</a></p>
    </section>
  </div>
  <script type="application/json" id="kn-data" set:html={serialized}></script>
</Base>
<script src="../../scripts/knowledge-network.ts"></script>
