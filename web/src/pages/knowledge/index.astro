---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import taxonomy from '../../../../knowledge/taxonomy.json';
import '../../styles/knowledge-library.css';

const source = await getCollection('knowledge');
const records = source
  .filter(e => (e.data.domains || []).length > 0 || /^topics\/[^/]+\/README$/.test(e.id))
  .map(e => {
    const title=e.data.title || (e.body || '').match(/^#\s+(.+)$/m)?.[1]?.trim() || e.id;
    const topic=/^topics\/[^/]+\/README$/.test(e.id);
    const type=topic?'topic':(e.data.contentType || (e.id.startsWith('papers/')?'paper':'review'));
    const href='/research/'+(e.id.endsWith('/README')?e.id.slice(0,-7):e.id)+'/';
    const domains=e.data.domains||[];
    const labelZh:Record<string,string>={topic:'专题',review:'综述',paper:'论文解读',qa:'技术问答',exploration:'问题与探索',plan:'研究计划',glossary:'概念',path:'学习路线'};
    const labelEn:Record<string,string>={topic:'Topic',review:'Review',paper:'Paper notes',qa:'Q&A',exploration:'Exploration',plan:'Research plan',glossary:'Concept',path:'Learning path'};
    return {id:e.id,title,href,domains,type,topic,summary:e.data.summaryZh||'',
      search:[title,e.data.shortName||'',...(e.data.aliases||[]),e.data.summaryZh||'',...domains].join(' ').toLocaleLowerCase(),
      labelZh:labelZh[type]||'文章',labelEn:labelEn[type]||'Note'};
  }).sort((a,b)=>{
    const priority=(e:typeof records[number])=>e.topic?0:e.type==='review'?1:e.type==='path'?2:e.type==='qa'?3:e.type==='exploration'?4:e.type==='paper'?5:6;
    return priority(a)-priority(b)||a.title.localeCompare(b.title,'zh');
  });
const domainEntries=taxonomy.domains.map(d=>{
  const matches=records.filter(e=>e.domains.some(k=>k===d.id||k.startsWith(d.id+'/')));
  const children=d.children.map(child=>({
    name:child, slug:d.slug+'/'+child,
    count:records.filter(e=>e.domains.some(k=>k===d.id+'/'+child||k.startsWith(d.id+'/'+child+'/'))).length
  })).filter(c=>c.count>0);
  return {...d,items:matches,children};
}).filter(d=>d.items.length>0);
const firstByDomain=domainEntries.map(d=>({
  ...d,featured:d.items.filter(e=>e.topic).slice(0,3)
})); 
const typeCounts=['topic','review','paper','qa','exploration','glossary','path','plan']
  .map(k=>({type:k,count:records.filter(e=>e.type===k).length}))
  .filter(x=>x.count>0);
---
<Base title="知识库" description="浏览个人公开知识库：按领域与专题逐层查找，也可以直接搜索论文解读、概念、技术问答与研究探索。">
  <div class="kl-page" id="kl-page">
    <header class="kl-hero">
      <div class="kl-eyebrow"><span class="kl-eyebrow-dot"></span> KNOWLEDGE LIBRARY / SUCHENL</div>
      <h1><span data-l="zh">把知识整理成容易阅读的样子。</span><span data-l="en">Knowledge, made easy to explore.</span></h1>
      <p class="kl-lead">
        <span data-l="zh">从熟悉的领域开始，沿着专题目录阅读；也可以直接搜索一个问题、一篇论文或一个概念。这里展示的都是已经公开的真实内容。</span>
        <span data-l="en">Start with a field, browse its topics, or search for a question, paper, or concept. Every entry links to an existing public note.</span>
      </p>
      <div class="kl-hero-meta">
        <span><strong>{domainEntries.length}</strong> <span data-l="zh">个知识领域</span><span data-l="en">areas</span></span>
        <i aria-hidden="true"></i>
        <span><strong>{records.length}</strong> <span data-l="zh">篇已收录内容</span><span data-l="en">published notes</span></span>
        <i aria-hidden="true"></i>
        <a href="/research/"><span data-l="zh">进入研究资料库</span><span data-l="en">Research library</span> <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <section class="kl-start" aria-labelledby="kl-start-title">
      <div class="kl-section-head">
        <div><p class="kl-kicker">EXPLORE BY FIELD</p><h2 id="kl-start-title"><span data-l="zh">从领域开始</span><span data-l="en">Explore by field</span></h2></div>
        <p><span data-l="zh">只展示确有公开文章的领域。</span><span data-l="en">Only fields with published articles appear here.</span></p>
      </div>
      <div class="kl-domains">
        {firstByDomain.map((d,i)=><article class="kl-domain-card" style={'--kl-index:'+i} >
          <div class="kl-domain-top"><span class="kl-domain-icon" aria-hidden="true">{String(i+1).padStart(2,'0')}</span><span class="kl-domain-count">{d.items.length} <span data-l="zh">篇</span><span data-l="en">notes</span></span></div>
          <h3><span data-l="zh">{d.id}</span><span data-l="en">{d.en}</span></h3>
          <p><span data-l="zh">{d.description}</span><span data-l="en">{d.descriptionEn}</span></p>
          <div class="kl-domain-topics">
            {d.children.slice(0,3).map(c=><button type="button" class="kl-quick-topic" data-kl-scope={c.slug} data-kl-name-zh={c.name} data-kl-name-en={c.name}>
              <span>{c.name}</span><span class="kl-domain-topic-count">{c.count}</span>
            </button>)}
          </div>
          <div class="kl-domain-bottom">
            <button type="button" class="kl-enter" data-kl-scope={d.slug} data-kl-name-zh={d.id} data-kl-name-en={d.en}>
              <span data-l="zh">查看该领域全部内容</span><span data-l="en">Browse this field</span><span aria-hidden="true">→</span>
            </button>
          </div>
        </article>)}
      </div>
    </section>

    <section class="kl-browser" id="knowledge-browser" aria-labelledby="kl-browser-title">
      <div class="kl-section-head">
        <div><p class="kl-kicker">BROWSE & READ</p><h2 id="kl-browser-title"><span data-l="zh">知识目录</span><span data-l="en">Knowledge index</span></h2></div>
        <p><span data-l="zh">目录决定范围，卡片直接进入正文。</span><span data-l="en">Use the tree to narrow your scope, then open a note.</span></p>
      </div>
      <div class="kl-shell">
        <aside class="kl-sidebar" aria-label="知识目录树">
          <div class="kl-sidebar-title"><span data-l="zh">分类目录</span><span data-l="en">Directory</span><small>{domainEntries.length} AREAS</small></div>
          <nav class="kl-tree" aria-label="按领域与专题浏览">
            <button class="kl-tree-all is-active" type="button" data-kl-scope="all" data-kl-name-zh="全部知识" data-kl-name-en="All notes" aria-pressed="true">
              <span data-l="zh">全部知识</span><span data-l="en">All notes</span><span class="kl-tree-count">{records.length}</span>
            </button>
            {domainEntries.map((d,i)=><details class="kl-tree-domain" open={i===0}>
              <summary><span class="kl-tree-chevron" aria-hidden="true">›</span>
                <span class="kl-tree-domain-label"><span data-l="zh">{d.id}</span><span data-l="en">{d.en}</span></span>
                <small>{d.items.length}</small>
              </summary>
              <div class="kl-tree-children">
                <button type="button" data-kl-scope={d.slug} data-kl-name-zh={d.id} data-kl-name-en={d.en} aria-pressed="false">
                  <span data-l="zh">全部条目</span><span data-l="en">All in this field</span><small>{d.items.length}</small>
                </button>
                {d.children.map(c=><button type="button" data-kl-scope={c.slug} data-kl-name-zh={c.name} data-kl-name-en={c.name} aria-pressed="false">
                  <span>{c.name}</span><small>{c.count}</small>
                </button>)}
              </div>
            </details>)}
          </nav>
          <div class="kl-sidebar-foot">
            <span data-l="zh">旧专题与论文链接保持不变。</span>
            <span data-l="en">Existing topic and paper URLs are preserved.</span>
            <a href="/research/"><span data-l="zh">高级研究检索</span><span data-l="en">Advanced research search</span> ↗</a>
          </div>
        </aside>

        <div class="kl-content">
          <div class="kl-tools">
            <label class="kl-search" for="kl-search">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m16.5 16.5 5 5" stroke="currentColor" stroke-width="1.7"/></svg>
              <input id="kl-search" type="search" autocomplete="off" placeholder="搜索标题、关键词或内容简介…" />
              <kbd>/</kbd>
            </label>
            <label class="kl-type-filter">
              <span data-l="zh">类型</span><span data-l="en">Type</span>
              <select id="kl-type" aria-label="按内容类型筛选">
                <option value="all"><span>全部类型</span></option>
                <option value="topic">专题</option>
                <option value="review">综述</option>
                <option value="paper">论文解读</option>
                <option value="qa">技术问答</option>
                <option value="exploration">问题与探索</option>
                <option value="path">学习路线</option>
                <option value="glossary">概念</option>
                <option value="plan">研究计划</option>
              </select>
            </label>
          </div>
          <div class="kl-results-head">
            <div><p class="kl-results-overline">YOUR READING LIBRARY</p><h3 id="kl-current-title"><span data-l="zh">全部知识</span><span data-l="en">All notes</span></h3></div>
            <span class="kl-results-count" id="kl-results-count" role="status" aria-live="polite">{records.length} <span data-l="zh">篇</span><span data-l="en">notes</span></span>
          </div>
          <div class="kl-articles" id="kl-articles">
            {records.map((e,i)=><article class="kl-note" data-kl-id={e.id} data-kl-domains={e.domains.join('|')} data-kl-type={e.type} data-kl-search={e.search} data-kl-order={i}>
              <div class="kl-note-meta">
                <span class:list={['kl-note-kind','kl-kind-'+e.type]}><span data-l="zh">{e.labelZh}</span><span data-l="en">{e.labelEn}</span></span>
                <span class="kl-note-group">{e.domains[0]?.split('/').slice(-1)[0]||''}</span>
              </div>
              <h4><a href={e.href}>{e.title}</a></h4>
              {e.summary&&<p>{e.summary}</p>}
              <a class="kl-note-read" href={e.href} aria-label={'阅读：'+e.title}><span data-l="zh">阅读文章</span><span data-l="en">Read article</span> <span aria-hidden="true">↗</span></a>
            </article>)}
          </div>
          <div id="kl-empty" class="kl-empty" hidden>
            <strong><span data-l="zh">没有找到符合条件的内容</span><span data-l="en">No matching notes</span></strong>
            <p><span data-l="zh">试试其他关键词，或者清除筛选后浏览完整目录。</span><span data-l="en">Try another keyword or reset the filters.</span></p>
            <button type="button" id="kl-clear"><span data-l="zh">清除筛选</span><span data-l="en">Clear filters</span></button>
          </div>
          <div class="kl-more-wrap"><button type="button" id="kl-more" class="kl-more" hidden><span data-l="zh">显示更多文章</span><span data-l="en">Show more notes</span><span aria-hidden="true"> ↓</span></button></div>
        </div>
      </div>
    </section>
    <div class="kl-shortcuts">
      <span data-l="zh">其他阅读入口</span><span data-l="en">Other reading paths</span>
      <a href="/research/"><span data-l="zh">研究资料库</span><span data-l="en">Research library</span> ↗</a>
      <a href="/paper-notes/"><span data-l="zh">论文解读</span><span data-l="en">Paper notes</span> ↗</a>
      <a href="/questions/"><span data-l="zh">问题与探索</span><span data-l="en">Questions</span> ↗</a>
    </div>
  </div>
</Base>
<script src="../../scripts/knowledge-library.ts"></script>
