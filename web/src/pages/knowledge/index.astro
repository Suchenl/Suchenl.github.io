---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import taxonomy from '../../../../knowledge/taxonomy.json';
import '../../styles/knowledge-library.css';

const source = await getCollection('knowledge');
const records = source
  .filter(e => (e.data.domains || []).length > 0 || /^topics\/[^/]+\/README$/.test(e.id))
  .map(e => {
    const title=e.data.title || (e.body || '').match(/^#\s+(.+)$/m)?.[1]?.trim() || e.id;
    const topic=/^topics\/[^/]+\/README$/.test(e.id);
    const type=topic?'topic':(e.data.contentType || (e.id.startsWith('papers/')?'paper':'review'));
    const href='/research/'+(e.id.endsWith('/README')?e.id.slice(0,-7):e.id)+'/';
    const domains=e.data.domains||[];
    const labelZh:Record<string,string>={topic:'专题',review:'综述',paper:'论文解读',qa:'技术问答',exploration:'问题与探索',plan:'研究计划',glossary:'概念',path:'学习路线'};
    const labelEn:Record<string,string>={topic:'Topic',review:'Review',paper:'Paper notes',qa:'Q&A',exploration:'Exploration',plan:'Research plan',glossary:'Concept',path:'Learning path'};
    return {id:e.id,title,href,domains,type,topic,summary:e.data.summaryZh||'',
      catalogTitleZh:e.data.catalogTitleZh||'',brief:type==='paper'&&e.data.readingDepth==='note',
      aliases:[e.data.shortName||'',...(e.data.aliases||[])].filter(Boolean).join('|').toLocaleLowerCase(),
      search:[title,e.data.catalogTitleZh||'',e.data.shortName||'',...(e.data.aliases||[]),e.data.summaryZh||'',...domains].join(' ').toLocaleLowerCase(),
      labelZh:labelZh[type]||'文章',labelEn:labelEn[type]||'Note'};
  }).sort((a,b)=>{
    const priority=(e:{topic:boolean;type:string})=>e.topic?0:e.type==='review'?1:e.type==='path'?2:e.type==='qa'?3:e.type==='exploration'?4:e.type==='paper'?5:6;
    return priority(a)-priority(b)||a.title.localeCompare(b.title,'zh');
  });
const recordById=new Map(records.map(e=>[e.id,e]));
const topicEntries=source
  .filter(e=>/^topics\/[^/]+\/README$/.test(e.id))
  .map(e=>{
    const overview=recordById.get(e.id)!;
    const slug=e.id.split('/')[1];
    const raw=e.data.readingOrder||[];
    const seen=new Set<string>();
    const order=raw.map((step,i)=>{
      const note=recordById.get(step.ref);
      if(!note)throw new Error('Missing actual note '+step.ref+' referenced by '+e.id);
      if(seen.has(step.ref)||step.ref===e.id)throw new Error('Duplicate/cyclic topic reading step '+step.ref+' in '+e.id);
      seen.add(step.ref);
      return {...step,index:i+1,note};
    });
    return {...overview,slug,order};
  });
const domainEntries=taxonomy.domains.map(d=>{
  const matches=records.filter(e=>e.domains.some(k=>k===d.id||k.startsWith(d.id+'/')));
  const children=d.children.map(child=>({
    name:child, slug:d.slug+'/'+child,
    topics:topicEntries.filter(t=>t.domains.includes(d.id+'/'+child)),
    count:records.filter(e=>e.domains.some(k=>k===d.id+'/'+child||k.startsWith(d.id+'/'+child+'/'))).length
  })).filter(c=>c.count>0);
  return {...d,items:matches,children};
}).filter(d=>d.items.length>0);
---
<Base title="知识库" description="浏览个人公开知识库：按领域与专题逐层查找，也可以直接搜索论文解读、概念、技术问答与研究探索。">
  <div class="kl-page" id="kl-page">
    <header class="kl-hero">
      <div class="kl-eyebrow"><span class="kl-eyebrow-dot"></span> KNOWLEDGE LIBRARY / SUCHENL</div>
      <h1><span data-l="zh">个人知识库</span><span data-l="en">Knowledge Library</span></h1>
      <p class="kl-lead">
        <span data-l="zh">按左侧领域目录查找知识，在右侧筛选专题、论文解读或问题，直接进入正文。所有文章都来自同一份公开知识库。</span>
        <span data-l="en">Use the directory to browse fields, filter papers or questions, and open the original note directly. One library, one reading path.</span>
      </p>
      <div class="kl-hero-meta">
        <span><strong>{domainEntries.length}</strong> <span data-l="zh">个知识领域</span><span data-l="en">areas</span></span>
        <i aria-hidden="true"></i>
        <span><strong>{records.length}</strong> <span data-l="zh">篇已收录内容</span><span data-l="en">published notes</span></span>
        <i aria-hidden="true"></i>
        <span><span data-l="zh">领域与内容类型在同一页面筛选</span><span data-l="en">One place for fields and content types</span></span>
      </div>
    </header>

    <section class="kl-browser" id="knowledge-browser" aria-labelledby="kl-browser-title">
      <div class="kl-section-head">
        <div><p class="kl-kicker">BROWSE & READ</p><h2 id="kl-browser-title"><span data-l="zh">浏览与阅读</span><span data-l="en">Browse & Read</span></h2></div>
        <p><span data-l="zh">左侧选领域，右侧筛选和阅读；不切换目录页面。</span><span data-l="en">Browse and filter in place. Articles open in the reader.</span></p>
      </div>
      <div class="kl-shell">
        <aside class="kl-sidebar" aria-label="知识目录树">
          <div class="kl-sidebar-title"><span data-l="zh">分类目录</span><span data-l="en">Directory</span><small>{domainEntries.length} AREAS</small></div>
          <nav class="kl-tree" aria-label="按领域与专题浏览">
            <button class="kl-tree-all is-active" type="button" data-kl-scope="all" data-kl-name-zh="全部知识" data-kl-name-en="All notes" aria-pressed="true">
              <span data-l="zh">全部知识</span><span data-l="en">All notes</span><span class="kl-tree-count">{records.length}</span>
            </button>
            {domainEntries.map((d,i)=><details class="kl-tree-domain" open={i===0}>
              <summary><span class="kl-tree-chevron" aria-hidden="true">›</span>
                <span class="kl-tree-domain-label"><span data-l="zh">{d.id}</span><span data-l="en">{d.en}</span></span>
                <small>{d.items.length}</small>
              </summary>
              <div class="kl-tree-children">
                <button type="button" data-kl-scope={d.slug} data-kl-domain-id={d.id} data-kl-name-zh={d.id} data-kl-name-en={d.en} aria-pressed="false">
                  <span data-l="zh">全部条目</span><span data-l="en">All in this field</span><small>{d.items.length}</small>
                </button>
                {d.children.map(c=><div class="kl-tree-subarea">
                  <button type="button" data-kl-scope={c.slug} data-kl-domain-id={d.id} data-kl-child-id={c.name} data-kl-name-zh={c.name} data-kl-name-en={c.name} aria-pressed="false">
                    <span>{c.name}</span><small>{c.count}</small>
                  </button>
                  {c.topics.length>0&&<div class="kl-tree-topics">
                    {c.topics.map(topic=><button type="button" class="kl-tree-topic" data-kl-scope={'topic:'+topic.slug}
                      data-kl-topic={topic.slug} data-kl-domain-id={d.id} data-kl-child-id={c.name}
                      data-kl-name-zh={topic.catalogTitleZh||topic.title} data-kl-name-en={topic.title} aria-pressed="false"
                      title={topic.title}>
                      <span class="kl-topic-branch" aria-hidden="true">↳</span>
                      <span class="kl-topic-label"><span data-l="zh">{topic.catalogTitleZh||topic.title}</span><span data-l="en">{topic.title}</span></span>
                      <small>{topic.order.length} <span data-l="zh">步</span><span data-l="en">steps</span></small>
                    </button>)}
                  </div>}
                </div>)}
              </div>
            </details>)}
          </nav>
          <div class="kl-sidebar-foot">
            <span data-l="zh">旧专题与论文链接保持不变。</span>
            <span data-l="en">Existing topic and paper URLs are preserved.</span>
            <a href="/research/"><span data-l="zh">需要论文对比等高级工具？</span><span data-l="en">Need advanced paper tools?</span> ↗</a>
          </div>
        </aside>

        <div class="kl-content">
          <div class="kl-tools">
            <label class="kl-search" for="kl-search">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m16.5 16.5 5 5" stroke="currentColor" stroke-width="1.7"/></svg>
              <input id="kl-search" type="search" autocomplete="off" placeholder="搜索标题、关键词或内容简介…" />
              <kbd>/</kbd>
            </label>
            <label class="kl-type-filter">
              <span data-l="zh">类型</span><span data-l="en">Type</span>
              <select id="kl-type" aria-label="按内容类型筛选">
                <option value="all">全部类型</option>
                <option value="topic">专题</option>
                <option value="review">综述</option>
                <option value="paper">论文解读</option>
                <option value="qa">技术问答</option>
                <option value="exploration">问题与探索</option>
                <option value="path">学习路线</option>
                <option value="glossary">概念</option>
                <option value="plan">研究计划</option>
              </select>
            </label>
          </div>
          <div class="kl-results-head">
            <div><p class="kl-results-overline" id="kl-location"><span data-l="zh">知识库 / 全部知识</span><span data-l="en">Library / All notes</span></p><h3 id="kl-current-title"><span data-l="zh">全部知识</span><span data-l="en">All notes</span></h3></div>
            <span class="kl-results-count" id="kl-results-count" role="status" aria-live="polite">{records.length} <span data-l="zh">篇</span><span data-l="en">notes</span></span>
          </div>
          <div id="kl-topic-quickstart" class="kl-topic-quickstart" hidden aria-label="本方向已收录的学习专题">
            {domainEntries.flatMap(d=>d.children.filter(c=>c.topics.length>0).map(c=><section
              data-kl-subarea-topics={c.slug} class="kl-topic-quickstart-group">
              <div class="kl-quickstart-heading">
                <div><span class="kl-quickstart-kicker"><span data-l="zh">推荐从专题开始</span><span data-l="en">START WITH A TOPIC</span></span>
                  <h3><span data-l="zh">{c.name} · 已有 {c.topics.length} 个专题</span><span data-l="en">{c.name} · {c.topics.length} topics</span></h3>
                </div>
                <p><span data-l="zh">专题根据真实文章整理了阅读顺序。可以先看全貌，再决定是否深入。</span><span data-l="en">Each published topic contains an authored reading sequence. Start with its overview.</span></p>
              </div>
              <div class="kl-topic-entry-grid">
                {c.topics.map(t=><article class="kl-topic-entry">
                  <div class="kl-topic-entry-meta"><span data-l="zh">知识专题</span><span data-l="en">TOPIC</span><span>{t.order.length} <span data-l="zh">步阅读</span><span data-l="en">steps</span></span></div>
                  <h4><span data-l="zh">{t.catalogTitleZh||t.title}</span><span data-l="en">{t.title}</span></h4>
                  {t.summary&&<p>{t.summary}</p>}
                  <button type="button" data-kl-open-topic={'topic:'+t.slug}><span data-l="zh">按顺序阅读</span><span data-l="en">Explore reading order</span><span aria-hidden="true"> →</span></button>
                </article>)}
              </div>
            </section>))}
          </div>
          {topicEntries.map(topic=><section class="kl-topic-guide" data-kl-topic-guide={topic.slug} data-kl-refs={topic.order.map(step=>step.ref).join('|')} hidden aria-label={'专题学习路线：'+topic.title}>
            <div class="kl-topic-guide-head">
              <p class="kl-kicker"><span data-l="zh">专题导读 · 建议阅读顺序</span><span data-l="en">TOPIC GUIDE · SUGGESTED READING</span></p>
              <h3><span data-l="zh">{topic.catalogTitleZh||topic.title}</span><span data-l="en">{topic.title}</span></h3>
              <p>{topic.summary}</p>
              <a href={topic.href} class="kl-topic-start"><span data-l="zh">先读专题总览</span><span data-l="en">Read topic overview first</span> <span aria-hidden="true">↗</span></a>
            </div>
            {topic.order.length>0&&<div class="kl-topic-route">
              <div class="kl-topic-route-title"><strong><span data-l="zh">然后按问题逐步深入</span><span data-l="en">Continue through the topic</span></strong><span>{topic.order.length} <span data-l="zh">个真实阅读条目</span><span data-l="en">published notes</span></span></div>
              <ol class="kl-topic-steps">
                {topic.order.slice(0,4).map(step=><li class="kl-topic-step">
                  <span class="kl-step-index">{String(step.index).padStart(2,'0')}</span>
                  <div><small>{step.stage}</small><a href={step.note.href}><span data-l="zh">{step.note.catalogTitleZh||step.note.title}</span><span data-l="en">{step.note.title}</span></a><p>{step.why}</p></div>
                </li>)}
              </ol>
              {topic.order.length>4&&<details class="kl-topic-more">
                <summary><span data-l="zh">继续查看后续 {topic.order.length-4} 步</span><span data-l="en">Show remaining {topic.order.length-4} steps</span></summary>
                <ol class="kl-topic-steps" start={5}>
                  {topic.order.slice(4).map(step=><li class="kl-topic-step">
                    <span class="kl-step-index">{String(step.index).padStart(2,'0')}</span>
                    <div><small>{step.stage}</small><a href={step.note.href}><span data-l="zh">{step.note.catalogTitleZh||step.note.title}</span><span data-l="en">{step.note.title}</span></a><p>{step.why}</p></div>
                  </li>)}
                </ol>
              </details>}
              <p class="kl-route-caveat"><span data-l="zh">这是根据已公开内容整理的推荐顺序，并非强制前置条件；没有为尚不存在的知识添加条目。</span><span data-l="en">A suggested order based on existing public notes, not a mandatory prerequisite graph. No unwritten topics are included.</span></p>
            </div>}
          </section>)}
                    <div class="kl-supplement-head" id="kl-supplement-head" hidden>
            <strong><span data-l="zh">路线之外的补充资料</span><span data-l="en">Additional notes beyond the route</span></strong>
            <p><span data-l="zh">这些已收录文章尚未编排进上面的推荐顺序，仍可以直接阅读。</span><span data-l="en">Published notes not yet included in this topic's suggested reading order.</span></p>
          </div>
          <div class="kl-articles" id="kl-articles" aria-label="知识文章列表">
            {records.map((e,i)=><article class="kl-note" data-kl-id={e.id} data-kl-domains={e.domains.join('|')} data-kl-type={e.type} data-kl-search={e.search} data-kl-title={(e.catalogTitleZh||e.title).toLocaleLowerCase()} data-kl-aliases={e.aliases} data-kl-order={i}>
              <div class="kl-note-meta">
                <span class:list={['kl-note-kind','kl-kind-'+e.type]}><span data-l="zh">{e.labelZh}</span><span data-l="en">{e.labelEn}</span></span>
                <span class="kl-note-group">{e.domains[0]?.split('/').slice(-1)[0]||''}</span>
                {e.brief&&<span class="kl-brief"><span data-l="zh">概要性笔记</span><span data-l="en">Brief overview</span></span>}
              </div>
              <h4><a href={e.href}><span data-l="zh">{e.catalogTitleZh||e.title}</span><span data-l="en">{e.title}</span></a></h4>
              {e.catalogTitleZh&&e.catalogTitleZh!==e.title&&<p class="kl-original-title">{e.title}</p>}
              {e.summary&&<p class="kl-summary">{e.summary}</p>}
              <a class="kl-note-read" href={e.href} aria-label={'阅读：'+e.title}><span data-l="zh">阅读文章</span><span data-l="en">Read article</span> <span aria-hidden="true">↗</span></a>
            </article>)}
          </div>
          <div id="kl-empty" class="kl-empty" hidden>
            <strong><span data-l="zh">没有找到符合条件的内容</span><span data-l="en">No matching notes</span></strong>
            <p><span data-l="zh">试试其他关键词，或者清除筛选后浏览完整目录。</span><span data-l="en">Try another keyword or reset the filters.</span></p>
            <button type="button" id="kl-clear"><span data-l="zh">清除筛选</span><span data-l="en">Clear filters</span></button>
          </div>
          <div class="kl-more-wrap"><button type="button" id="kl-more" class="kl-more" hidden><span data-l="zh">显示更多文章</span><span data-l="en">Show more notes</span><span aria-hidden="true"> ↓</span></button></div>
        </div>
      </div>
    </section>
  </div>
</Base>
<script src="../../scripts/knowledge-library.ts"></script>
