---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('papers');
const papers = entries
  .map((e) => {
    const parts = e.id.split('/');
    parts.pop(); // drop the file slug
    const folder = e.data.folder ?? parts.join('/');
    return {
      title: e.data.title,
      authors: e.data.authors,
      year: e.data.year ?? null,
      venue: e.data.venue ?? '',
      folder,
      tags: e.data.tags,
      status: e.data.status,
      rating: e.data.rating ?? 0,
      links: e.data.links ?? {},
      abstract: e.data.abstract ?? '',
      added: e.data.added ? e.data.added.toISOString().slice(0, 10) : '',
    };
  })
  .sort((a, b) => (b.added > a.added ? 1 : -1));
---

<Base title="Reading" noindex={true}>
  <h1 class="page-title"><Bi zh="文献库" en="Reading" /></h1>
  <p class="page-intro">
    <Bi
      zh="我在读 / 读过的论文库（非本人发表）。像文件夹一样按主题组织——左侧选目录，右侧看论文，顶部可搜索。当前为示例数据。"
      en="Papers I'm reading / have read (not my own). Organized in folders — pick a folder on the left, browse on the right, search up top. Sample data for now."
    />
  </p>

  <div class="lit" id="lit">
    <input id="lit-search" class="lit-search" type="search" placeholder="搜索标题 / 作者 / 标签…  Search…" />
    <div class="lit-main">
      <aside class="lit-tree" id="lit-tree"></aside>
      <div class="lit-results">
        <div class="lit-crumb" id="lit-crumb"></div>
        <div id="lit-body"></div>
      </div>
    </div>
  </div>

  <script type="application/json" id="papers-json" set:html={JSON.stringify(papers)}></script>
</Base>

<script>
  const raw = document.getElementById('papers-json')?.textContent || '[]';
  const ALL: any[] = JSON.parse(raw);

  const state = { sel: '', q: '' };
  const expanded = new Set<string>(['']);

  const esc = (s: string) => (s || '').replace(/[&<>"]/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const primaryLink = (p: any) => p.links.arxiv || p.links.pdf || p.links.project || p.links.code || '';
  const statusLabel: Record<string, string> = { 'to-read': '想读', reading: '在读', read: '已读' };
  const stars = (n: number) => (n > 0 ? '★'.repeat(n) + '☆'.repeat(5 - n) : '');

  // ── folder tree (counts include descendants) ──
  type Node = { name: string; path: string; count: number; children: Map<string, Node> };
  function buildTree(): Node {
    const root: Node = { name: 'All', path: '', count: ALL.length, children: new Map() };
    for (const p of ALL) {
      if (!p.folder) continue;
      let cur = root;
      let acc = '';
      for (const seg of p.folder.split('/')) {
        acc = acc ? acc + '/' + seg : seg;
        if (!cur.children.has(seg)) cur.children.set(seg, { name: seg, path: acc, count: 0, children: new Map() });
        cur = cur.children.get(seg)!;
        cur.count++;
      }
    }
    return root;
  }

  function renderNode(n: Node, depth: number): string {
    const hasKids = n.children.size > 0;
    const isOpen = expanded.has(n.path);
    const sel = state.sel === n.path ? 'sel' : '';
    const caret = hasKids ? `<span class="caret ${isOpen ? 'open' : ''}" data-toggle="${esc(n.path)}">▸</span>` : `<span class="caret-sp"></span>`;
    let html = `<div class="tnode ${sel}" data-path="${esc(n.path)}" style="padding-left:${depth * 12 + 6}px">
      ${caret}<span class="tname">${esc(n.name === 'All' ? '全部 All' : n.name)}</span><span class="tcount">${n.count}</span>
    </div>`;
    if (hasKids && isOpen) {
      html += [...n.children.values()]
        .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
        .map((c) => renderNode(c, depth + 1)).join('');
    }
    return html;
  }

  function renderTree() {
    const root = buildTree();
    const host = document.getElementById('lit-tree') as HTMLElement;
    host.innerHTML = renderNode(root, 0);
    host.querySelectorAll('[data-path]').forEach((el) => el.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).dataset.toggle !== undefined) return; // caret handles itself
      state.sel = (el as HTMLElement).dataset.path || '';
      expanded.add(state.sel);
      render();
    }));
    host.querySelectorAll('[data-toggle]').forEach((el) => el.addEventListener('click', (e) => {
      e.stopPropagation();
      const p = (el as HTMLElement).dataset.toggle || '';
      if (expanded.has(p)) expanded.delete(p); else expanded.add(p);
      render();
    }));
  }

  // ── list ──
  function currentList(): any[] {
    const q = state.q.trim().toLowerCase();
    if (q) {
      return ALL.filter((p) =>
        (p.title + ' ' + p.authors.join(' ') + ' ' + p.abstract + ' ' + p.venue + ' ' + p.tags.join(' ') + ' ' + p.folder)
          .toLowerCase().includes(q));
    }
    if (!state.sel) return ALL;
    return ALL.filter((p) => p.folder === state.sel || p.folder.startsWith(state.sel + '/'));
  }

  function row(p: any) {
    const l = primaryLink(p);
    const title = l ? `<a href="${esc(l)}" target="_blank" rel="noopener">${esc(p.title)}</a>` : esc(p.title);
    const meta = esc([p.venue, p.year, p.folder].filter(Boolean).join(' · '));
    return `<div class="row">
      <div class="row-main">
        <div class="row-title">${title}</div>
        <div class="row-sub muted">${esc(p.authors.join(', '))}</div>
        <div class="row-abs muted">${esc(p.abstract)}</div>
        <div class="row-tags">${p.tags.map((t: string) => `<span class="tag-chip">${esc(t)}</span>`).join('')}</div>
      </div>
      <div class="row-meta">
        <span class="st st-${p.status}">${statusLabel[p.status] || p.status}</span>
        <span class="stars">${stars(p.rating)}</span>
        <span class="muted rmeta">${meta}</span>
      </div>
    </div>`;
  }

  function render() {
    renderTree();
    const list = currentList();
    const crumb = document.getElementById('lit-crumb') as HTMLElement;
    if (state.q.trim()) crumb.innerHTML = `<span class="muted">搜索 “${esc(state.q.trim())}” · ${list.length} 篇</span>`;
    else crumb.innerHTML = `<span class="cpath">${esc(state.sel || '全部 All')}</span><span class="muted"> · ${list.length} 篇</span>`;
    const body = document.getElementById('lit-body') as HTMLElement;
    body.innerHTML = list.length
      ? `<div class="view-list">${list.map(row).join('')}</div>`
      : `<div class="lit-empty muted">这里还没有论文 · Nothing here yet</div>`;
  }

  document.getElementById('lit-search')!.addEventListener('input', (e) => {
    state.q = (e.target as HTMLInputElement).value; render();
  });
  render();
</script>

<style is:global>
  /* Namespaced under #lit so styles reach JS-injected nodes. */
  #lit .lit-search {
    width: 100%; font: inherit; font-size: 0.95rem; margin-bottom: 0.9rem;
    padding: 0.6rem 1rem; border: 1px solid var(--border); border-radius: 999px;
    background: var(--surface); color: var(--fg); box-shadow: var(--shadow-sm);
  }
  #lit .lit-search:focus { outline: none; border-color: var(--accent); }

  #lit .lit-main { display: grid; grid-template-columns: 250px 1fr; gap: 1.1rem; align-items: start; }

  /* folder tree */
  #lit .lit-tree {
    position: sticky; top: 74px; align-self: start;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
    box-shadow: var(--shadow-sm); padding: 0.4rem; max-height: calc(100vh - 90px); overflow-y: auto;
  }
  #lit .tnode {
    display: flex; align-items: center; gap: 0.35rem;
    padding: 0.34rem 0.5rem; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;
  }
  #lit .tnode:hover { background: var(--surface-2); }
  #lit .tnode.sel { background: var(--accent-soft); color: var(--accent-ink); }
  #lit .caret { font-size: 0.7rem; color: var(--fg-muted); transition: transform 0.12s ease; width: 12px; display: inline-block; }
  #lit .caret.open { transform: rotate(90deg); }
  #lit .caret-sp { width: 12px; display: inline-block; }
  #lit .tname { flex: 1 1 auto; }
  #lit .tcount { font-size: 0.72rem; color: var(--fg-muted); background: var(--surface-2); padding: 0 0.45em; border-radius: 999px; }
  #lit .tnode.sel .tcount { background: var(--surface); }

  /* results */
  #lit .lit-crumb { font-size: 0.85rem; margin: 0.2rem 0 0.8rem 0.2rem; }
  #lit .cpath { font-weight: 800; }
  #lit .view-list { display: grid; gap: 0.55rem; }
  #lit .row {
    display: flex; justify-content: space-between; gap: 1.2rem;
    padding: 0.9rem 1.1rem; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); box-shadow: var(--shadow-sm);
  }
  #lit .row:hover { border-color: var(--border-strong); }
  #lit .row-main { min-width: 0; }
  #lit .row-title { font-weight: 700; }
  #lit .row-sub { font-size: 0.85rem; margin-top: 0.12rem; }
  #lit .row-abs { font-size: 0.85rem; margin-top: 0.3rem; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #lit .row-tags { margin-top: 0.45rem; }
  #lit .row-meta { flex: 0 0 auto; text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem; white-space: nowrap; }
  #lit .rmeta { font-size: 0.76rem; max-width: 220px; white-space: normal; }

  #lit .st { font-size: 0.72rem; font-weight: 700; padding: 0.12em 0.6em; border-radius: 999px; }
  #lit .st-read { color: #fff; background: linear-gradient(120deg, #16a34a, #22c55e); }
  #lit .st-reading { color: #8a6d00; background: #fff4cc; }
  #lit .st-to-read { color: var(--fg-muted); background: var(--surface-2); }
  @media (prefers-color-scheme: dark) { #lit .st-reading { color: #ffd874; background: #2a2410; } }
  #lit .stars { color: #f5a623; font-size: 0.82rem; letter-spacing: 1px; }
  #lit .lit-empty { padding: 2rem; text-align: center; }

  @media (max-width: 820px) {
    #lit .lit-main { grid-template-columns: 1fr; }
    #lit .lit-tree { position: static; max-height: 260px; }
    #lit .row { flex-direction: column; }
    #lit .row-meta { text-align: left; align-items: flex-start; flex-direction: row; flex-wrap: wrap; }
  }
</style>
