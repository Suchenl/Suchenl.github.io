---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

type PaperMeta = {
  title?: string;
  authors?: string[];
  year?: number;
  venue?: string;
  categories?: string[];
  tags?: string[];
  status?: 'to-read' | 'reading' | 'read' | 'untracked';
  rating?: number;
  summaryZh?: string;
  abstract?: string;
  added?: string | Date;
};
const entries = await getCollection('knowledge');
const body = (e: (typeof entries)[number]) => e.body || '';
const heading = (e: (typeof entries)[number]) => body(e).match(/^#\s+(.+)$/m)?.[1]?.trim() || e.id.split('/').pop() || e.id;
const meta = (e: (typeof entries)[number]) => e.data as PaperMeta;
const getYear = (id: string) => Number(id.match(/20\d{2}/)?.[0] || 0);
const paperNotes = entries.filter(e => /^papers\/20\d{2}\//.test(e.id));
const reviews = entries.filter(e => e.id.includes('/reviews/'));
const glossaries = entries.filter(e => e.id.startsWith('glossary/') && !e.id.endsWith('README'));
const ideas = entries.filter(e => e.id.startsWith('research/') && !e.id.endsWith('README'));
const papers = paperNotes.map(e => {
  const m = meta(e);
  return {
    kind: 'paper',
    id: e.id,
    href: '/research/' + e.id + '/',
    title: m.title || heading(e),
    summary: m.summaryZh || m.abstract || '',
    authors: m.authors || [],
    year: m.year || getYear(e.id),
    venue: m.venue || '',
    categories: m.categories?.length ? m.categories : ['其他研究'],
    tags: m.tags || [],
    status: m.status || 'untracked',
    rating: m.rating || 0,
    searchText: body(e).slice(0, 14000),
    added: m.added ? String(m.added) : '',
  };
});
const other = [
  ...reviews.map(e => ({ kind: 'reviews', id: e.id, href: '/research/' + e.id + '/', title: heading(e), summary: '研究脉络、方法比较、实验证据和开放问题', searchText: body(e).slice(0, 14000) })),
  ...glossaries.map(e => ({ kind: 'glossary', id: e.id, href: '/research/' + e.id + '/', title: heading(e), summary: '概念定义、公式与反例', searchText: body(e).slice(0, 14000) })),
  ...ideas.map(e => ({ kind: 'ideas', id: e.id, href: '/research/' + e.id + '/', title: heading(e), summary: '研究假设、反例与实验设计', searchText: body(e).slice(0, 14000) })),
];
const items = [...papers, ...other];
const serialized = JSON.stringify(items).replace(/</g, '\\u003c');
---

<Base title="研究知识库" description="按研究方向组织的论文阅读、中文解读、主题综述、术语与研究问题。">
  <h1 class="page-title">研究知识库</h1>
  <p class="page-intro">像整理文件夹一样整理研究：按方向浏览论文，也能直接阅读笔记、综述、术语和研究思路。正文以中文为主，论文原标题保留英文。</p>
  <div class="lit" id="lit">
    <label class="sr-only" for="lit-search">搜索知识库</label>
    <input id="lit-search" class="lit-search" type="search" placeholder="搜索论文、作者、方向、术语或研究问题…" autocomplete="off" />
    <div class="lit-main">
      <aside class="lit-tree" id="lit-tree" aria-label="研究目录"></aside>
      <section class="lit-results" aria-label="内容列表">
        <div class="lit-crumb" id="lit-crumb"></div>
        <div class="lit-filters" id="lit-filters" aria-label="论文阅读状态">
          <button type="button" data-status="all" class="active">全部</button>
          <button type="button" data-status="to-read">想读</button>
          <button type="button" data-status="reading">在读</button>
          <button type="button" data-status="read">已读</button>
          <button type="button" data-status="untracked">未标记</button>
        </div>
        <div id="lit-body"></div>
      </section>
    </div>
  </div>
  <p class="muted" style="margin-top:1.6rem;font-size:.84rem">全部条目维护在 <a href="https://github.com/Suchenl/Suchenl.github.io/tree/main/knowledge" target="_blank" rel="noopener">GitHub / knowledge</a>；一篇论文只有一份 Markdown，可被多个主题引用。</p>
  <script type="application/json" id="research-items-json" set:html={serialized}></script>
</Base>

<script>
  type Item = {
    kind: string; id: string; href: string; title: string; summary: string;
    authors?: string[]; year?: number; venue?: string; categories?: string[];
    tags?: string[]; status?: string; rating?: number; searchText?: string; added?: string;
  };
  type Folder = { name: string; path: string; count: number; children: Map<string, Folder> };
  const ALL: Item[] = JSON.parse(document.getElementById('research-items-json')?.textContent || '[]');
  const state = { selected: 'papers', query: '', status: 'all' };
  const expanded = new Set<string>(['papers']);
  const statusLabel: Record<string, string> = { 'to-read': '想读', reading: '在读', read: '已读', untracked: '未标记' };
  const labels: Record<string, string> = { papers: '全部论文', reviews: '主题综述', glossary: '术语词典', ideas: '研究思路' };
  const escapeHtml = (s: string) => String(s || '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c] as string));

  function makeTree(): Folder[] {
    const result: Folder[] = ['papers', 'reviews', 'glossary', 'ideas'].map(k => ({
      name: labels[k], path: k, count: ALL.filter(p => k === 'papers' ? p.kind === 'paper' : p.kind === k).length, children: new Map(),
    }));
    const root = result[0];
    for (const p of ALL.filter(p => p.kind === 'paper')) {
      for (const category of p.categories || []) {
        let parent = root;
        let partial = '';
        for (const segment of category.split('/').filter(Boolean)) {
          partial = partial ? partial + '/' + segment : segment;
          if (!parent.children.has(segment)) {
            parent.children.set(segment, { name: segment, path: 'cat:' + partial, count: 0, children: new Map() });
          }
          parent = parent.children.get(segment)!;
        }
      }
    }
    const countChildren = (node: Folder) => {
      for (const child of node.children.values()) {
        const category = child.path.slice(4);
        child.count = ALL.filter(p => p.kind === 'paper' && (p.categories || []).some(c => c === category || c.startsWith(category + '/'))).length;
        countChildren(child);
      }
    };
    countChildren(root);
    return result;
  }
  const roots = makeTree();
  function treeNode(n: Folder, depth: number): string {
    const children = [...n.children.values()].sort((a,b) => b.count - a.count || a.name.localeCompare(b.name, 'zh'));
    const hasChildren = children.length > 0;
    const open = expanded.has(n.path);
    const active = state.selected === n.path ? ' sel' : '';
    const arrow = hasChildren
      ? '<button type="button" class="caret' + (open ? ' open' : '') + '" data-toggle="' + escapeHtml(n.path) + '" aria-label="展开或折叠 ' + escapeHtml(n.name) + '">▸</button>'
      : '<span class="caret-sp"></span>';
    let result = '<div class="tnode' + active + '" data-path="' + escapeHtml(n.path) + '" style="padding-left:' + (depth * 12 + 6) + 'px">'
      + arrow + '<span class="tname">' + escapeHtml(n.name) + '</span><span class="tcount">' + n.count + '</span></div>';
    if (hasChildren && open) result += children.map(c => treeNode(c, depth + 1)).join('');
    return result;
  }
  function renderTree() {
    const host = document.getElementById('lit-tree')!;
    host.innerHTML = roots.map(n => treeNode(n, 0)).join('');
    host.querySelectorAll<HTMLElement>('[data-path]').forEach(el => el.addEventListener('click', event => {
      if ((event.target as HTMLElement).closest('[data-toggle]')) return;
      state.selected = el.dataset.path || 'papers';
      expanded.add(state.selected);
      state.status = 'all';
      state.query = '';
      (document.getElementById('lit-search') as HTMLInputElement).value = '';
      render();
    }));
    host.querySelectorAll<HTMLElement>('[data-toggle]').forEach(el => el.addEventListener('click', event => {
      event.stopPropagation();
      const key = el.dataset.toggle || '';
      if (expanded.has(key)) expanded.delete(key); else expanded.add(key);
      renderTree();
    }));
  }
  function filteredItems(): Item[] {
    let values: Item[];
    const q = state.query.trim().toLowerCase();
    if (q) {
      values = ALL.filter(p => [p.title, p.summary, p.id, p.searchText || '', (p.authors || []).join(' '), (p.tags || []).join(' '), (p.categories || []).join(' ')].join(' ').toLowerCase().includes(q));
    } else if (state.selected === 'papers') {
      values = ALL.filter(p => p.kind === 'paper');
    } else if (state.selected.startsWith('cat:')) {
      const category = state.selected.slice(4);
      values = ALL.filter(p => p.kind === 'paper' && (p.categories || []).some(c => c === category || c.startsWith(category + '/')));
    } else {
      values = ALL.filter(p => p.kind === state.selected);
    }
    if (state.status !== 'all') values = values.filter(p => p.kind !== 'paper' || p.status === state.status);
    const kindOrder = (k: string) => ({ reviews: 0, paper: 1, glossary: 2, ideas: 3 }[k] ?? 4);
    return values.sort((a,b) => kindOrder(a.kind) - kindOrder(b.kind) || (b.year || 0) - (a.year || 0) || a.title.localeCompare(b.title));
  }
  function itemRow(p: Item): string {
    const isPaper = p.kind === 'paper';
    const subtitle = isPaper
      ? [p.venue, p.year, (p.categories || [])[0]].filter(Boolean).join(' · ')
      : labels[p.kind] || '研究资料';
    const chips = isPaper ? (p.tags || []).slice(0, 5).map(t => '<span class="tag-chip">' + escapeHtml(t) + '</span>').join('') : '';
    const rating = p.rating && p.rating > 0 ? '★'.repeat(p.rating) + '☆'.repeat(Math.max(0,5-p.rating)) : '';
    return '<article class="row">'
      + '<div class="row-main"><div class="row-title"><a href="' + escapeHtml(p.href) + '">' + escapeHtml(p.title) + '</a></div>'
      + '<div class="row-sub muted">' + escapeHtml(subtitle) + '</div>'
      + (p.summary ? '<div class="row-abs muted">' + escapeHtml(p.summary) + '</div>' : '')
      + (chips ? '<div class="row-tags">' + chips + '</div>' : '')
      + '</div><div class="row-meta">'
      + (isPaper ? '<span class="st st-' + escapeHtml(p.status || 'untracked') + '">' + statusLabel[p.status || 'untracked'] + '</span>' : '')
      + (rating ? '<span class="stars">' + rating + '</span>' : '')
      + '<span class="muted rmeta">' + (isPaper ? '查看笔记 →' : '阅读内容 →') + '</span></div></article>';
  }
  function render() {
    renderTree();
    const data = filteredItems();
    const name = state.selected.startsWith('cat:') ? state.selected.slice(4).replaceAll('/', ' / ') : labels[state.selected] || '研究目录';
    const label = state.query.trim() ? '搜索 “' + escapeHtml(state.query.trim()) + '”' : escapeHtml(name);
    document.getElementById('lit-crumb')!.innerHTML = '<span class="cpath">' + label + '</span><span class="muted"> · ' + data.length + ' 条</span>';
    document.getElementById('lit-body')!.innerHTML = data.length ? '<div class="view-list">' + data.map(itemRow).join('') + '</div>' : '<div class="lit-empty muted">暂无匹配内容</div>';
    const showingPapers = state.query.trim() || state.selected === 'papers' || state.selected.startsWith('cat:');
    (document.getElementById('lit-filters') as HTMLElement).hidden = !showingPapers;
    document.querySelectorAll<HTMLButtonElement>('[data-status]').forEach(button => {
      button.classList.toggle('active', button.dataset.status === state.status);
    });
  }
  document.getElementById('lit-search')!.addEventListener('input', e => {
    state.query = (e.target as HTMLInputElement).value;
    state.status = 'all';
    render();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-status]').forEach(button => button.addEventListener('click', () => {
    state.status = button.dataset.status || 'all';
    render();
  }));
  const folder = new URLSearchParams(window.location.search).get('folder');
  if (folder) {
    const valid = folder === 'papers' || ['reviews','glossary','ideas'].includes(folder) || (folder.startsWith('cat:') && ALL.some(p => p.categories?.some(c => c === folder.slice(4) || c.startsWith(folder.slice(4) + '/'))));
    if (valid) {
      state.selected = folder;
      if (folder.startsWith('cat:')) {
        let partial = '';
        for (const segment of folder.slice(4).split('/')) {
          partial = partial ? partial + '/' + segment : segment;
          expanded.add('cat:' + partial);
        }
        expanded.add('papers');
      }
    }
  }
  render();
</script>
<style is:global>
  /* Namespaced under #lit so styles reach JS-injected nodes. */
  #lit .lit-search {
    width: 100%; font: inherit; font-size: 0.95rem; margin-bottom: 0.9rem;
    padding: 0.6rem 1rem; border: 1px solid var(--border); border-radius: 999px;
    background: var(--surface); color: var(--fg); box-shadow: var(--shadow-sm);
  }
  #lit .lit-search:focus { outline: none; border-color: var(--accent); }

  #lit .lit-main { display: grid; grid-template-columns: 250px 1fr; gap: 1.1rem; align-items: start; }

  /* folder tree */
  #lit .lit-tree {
    position: sticky; top: 74px; align-self: start;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
    box-shadow: var(--shadow-sm); padding: 0.4rem; max-height: calc(100vh - 90px); overflow-y: auto;
  }
  #lit .tnode {
    display: flex; align-items: center; gap: 0.35rem;
    padding: 0.34rem 0.5rem; border-radius: 8px; cursor: pointer; font-size: 0.9rem; font-weight: 600;
  }
  #lit .tnode:hover { background: var(--surface-2); }
  #lit .tnode.sel { background: var(--accent-soft); color: var(--accent-ink); }
  #lit .caret { font-size: 0.7rem; color: var(--fg-muted); transition: transform 0.12s ease; width: 12px; display: inline-block; }
  #lit .caret.open { transform: rotate(90deg); }
  #lit .caret-sp { width: 12px; display: inline-block; }
  #lit .tname { flex: 1 1 auto; }
  #lit .tcount { font-size: 0.72rem; color: var(--fg-muted); background: var(--surface-2); padding: 0 0.45em; border-radius: 999px; }
  #lit .tnode.sel .tcount { background: var(--surface); }

  /* results */
  #lit .lit-crumb { font-size: 0.85rem; margin: 0.2rem 0 0.8rem 0.2rem; }
  #lit .cpath { font-weight: 800; }
  #lit .view-list { display: grid; gap: 0.55rem; }
  #lit .row {
    display: flex; justify-content: space-between; gap: 1.2rem;
    padding: 0.9rem 1.1rem; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface); box-shadow: var(--shadow-sm);
  }
  #lit .row:hover { border-color: var(--border-strong); }
  #lit .row-main { min-width: 0; }
  #lit .row-title { font-weight: 700; }
  #lit .row-sub { font-size: 0.85rem; margin-top: 0.12rem; }
  #lit .row-abs { font-size: 0.85rem; margin-top: 0.3rem; line-height: 1.5;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #lit .row-tags { margin-top: 0.45rem; }
  #lit .row-meta { flex: 0 0 auto; text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem; white-space: nowrap; }
  #lit .rmeta { font-size: 0.76rem; max-width: 220px; white-space: normal; }

  #lit .st { font-size: 0.72rem; font-weight: 700; padding: 0.12em 0.6em; border-radius: 999px; }
  #lit .st-read { color: #fff; background: linear-gradient(120deg, #16a34a, #22c55e); }
  #lit .st-reading { color: #8a6d00; background: #fff4cc; }
  #lit .st-to-read { color: var(--fg-muted); background: var(--surface-2); }
  @media (prefers-color-scheme: dark) { #lit .st-reading { color: #ffd874; background: #2a2410; } }
  #lit .stars { color: #f5a623; font-size: 0.82rem; letter-spacing: 1px; }
  #lit .lit-empty { padding: 2rem; text-align: center; }

  @media (max-width: 820px) {
    #lit .lit-main { grid-template-columns: 1fr; }
    #lit .lit-tree { position: static; max-height: 260px; }
    #lit .row { flex-direction: column; }
    #lit .row-meta { text-align: left; align-items: flex-start; flex-direction: row; flex-wrap: wrap; }
  }
</style>

<style is:global>
  #lit .lit-filters { display:flex;flex-wrap:wrap;gap:.4rem;margin:0 0 1rem; }
  #lit .lit-filters[hidden] { display:none; }
  #lit .lit-filters button { border:1px solid var(--border);background:var(--surface);color:var(--fg-muted);border-radius:999px;padding:.28rem .75rem;font:inherit;font-size:.77rem;cursor:pointer; }
  #lit .lit-filters button.active { background:var(--accent-soft);color:var(--accent-ink);border-color:var(--accent); }
  #lit .tnode .caret { flex: 0 0 12px; border:0; padding:0; margin:0; background:transparent; cursor:pointer; text-align:left; }
  #lit .tnode .caret:hover { color:var(--accent-ink); }
  #lit .row-main a { color:var(--fg); }
  #lit .row-main a:hover { color:var(--accent-ink); }
  #lit .st-untracked { background:var(--surface-2);color:var(--fg-muted); }
  .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0; }
</style>
