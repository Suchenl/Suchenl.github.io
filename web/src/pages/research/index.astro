    document.getElementById('lit-body')!.innerHTML = data.length ? '<div class="view-list">' + data.slice(0,state.visibleLimit).map(itemRow).join('') + '</div>' : '<div class="lit-empty">没有匹配内容。试试其他关键词或清除筛选条件。</div>';
