    const id=el.dataset.compareId || '';
    if(compareIds.has(id))compareIds.delete(id);
    else if(compareIds.size<3)compareIds.add(id);
    else {compareStatus.textContent='最多比较 3 篇，请先取消一篇';return;}
    render();
  });
