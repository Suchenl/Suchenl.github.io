<style is:global>
  #lit .lit-context {margin:.05rem 0 1.15rem;padding:.9rem 1rem;border-radius:12px;border:1px solid var(--border);background:var(--surface-2);}
  #lit .lit-context-title {display:flex;gap:.6rem;align-items:baseline;flex-wrap:wrap;font-size:.84rem;font-weight:760;margin:0 0 .75rem;}
  #lit .lit-context-title span {font-size:.75rem;color:var(--fg-muted);font-weight:450;}
  #lit .lit-context-links {display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:.55rem;}
  #lit .lit-context-links a {background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:.65rem .75rem;min-width:0;display:flex;flex-direction:column;gap:.22rem;color:var(--fg);text-decoration:none;}
  #lit .lit-context-links a:hover {border-color:var(--accent);}
  #lit .lit-context-kind {color:var(--accent-ink);font-size:.69rem;font-weight:780;}
  #lit .lit-context-links strong {font-size:.83rem;font-weight:700;line-height:1.5;overflow-wrap:anywhere;}
  #lit .lit-context-summary {color:var(--fg-muted);font-size:.73rem;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
</style>

<style is:global>
  /* UX audit: one generous interactive target per tree row, not a tiny disclosure hitbox. */
  #lit .lit-tree .tnode {display:block;padding:0;margin:1px 0;cursor:default;}
  #lit .lit-tree .tnode-select {display:flex;align-items:center;box-sizing:border-box;width:100%;min-height:44px;gap:.55rem;padding-right:.7rem;border-radius:9px;text-align:left;cursor:pointer;}
  #lit .lit-tree .tnode-select:hover {background:var(--surface-2);}
  #lit .lit-tree .tnode.sel .tnode-select {background:var(--accent-soft);color:var(--accent-ink);}
  #lit .lit-tree .tnode-select:focus-visible {outline:2px solid var(--accent);outline-offset:-2px;}
  #lit .lit-tree .caret, #lit .lit-tree .caret-sp {display:inline-flex;align-items:center;justify-content:center;flex:0 0 16px;width:16px;height:24px;pointer-events:none;color:var(--fg-muted);}
  #lit .lit-tree .caret {transform:rotate(0deg);transition:transform .12s ease;}
  #lit .lit-tree .caret.open {transform:rotate(90deg);}
  #lit .lit-tree .tnode .tname {flex:1;min-width:0;font-size:.83rem;line-height:1.4;}
  #lit .lit-tree .tnode .tcount {flex-shrink:0;line-height:1.6;padding:0 .45rem;}
  @media (prefers-reduced-motion:reduce) { #lit .lit-tree .caret {transition:none;} }
</style>

<style is:global>
  /* Full item discovery: cards remain semantically articles with real links. */
  #lit .view-list .row {position:relative;isolation:isolate;}
  #lit .view-list .row-title a::after {content:"";position:absolute;inset:0;}
  #lit .view-list .row-meta a {position:relative;z-index:2;}
  #lit .view-list .row:focus-within {border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft);}
  #lit .view-list .row-title a:focus-visible {outline:none;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:4px;}
</style>

<style is:global>
  /* On smaller screens, the directory is an explicit, accessible disclosure. */
  #lit .lit-mobile-folder-toggle {display:none;}
  #lit .lit-more {padding:1.15rem 0 .2rem;text-align:center;}
  #lit .lit-more[hidden] {display:none;}
  #lit #lit-more-button {padding:.65rem 1.3rem;min-height:44px;border:1px solid var(--border-strong);border-radius:10px;background:var(--surface);color:var(--fg);font:inherit;font-size:.83rem;font-weight:650;cursor:pointer;}
