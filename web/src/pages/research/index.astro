  @media (max-width:700px) {
    #lit .lit-mobile-folder-toggle {display:flex;align-items:center;justify-content:space-between;gap:1rem;width:100%;min-height:46px;margin:0 0 .55rem;padding:.75rem .9rem;background:var(--surface);border:1px solid var(--border);border-radius:10px;color:var(--fg);font:inherit;font-weight:710;cursor:pointer;text-align:left;}
    #lit .lit-mobile-folder-toggle[aria-expanded="true"] span:last-child {transform:rotate(180deg);}
    #lit .lit-sidebar {display:none;}
