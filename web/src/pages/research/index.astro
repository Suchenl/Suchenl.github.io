---
import Base from '../../layouts/Base.astro';
import SectionNav from '../../components/SectionNav.astro';
import '../../styles/research-library.css';
import { getCollection, render } from 'astro:content';
import { contentTypes, domainCatalog, domainMatches } from '../../lib/research-taxonomy';

type PaperMeta = {
  title?: string;
  contentType?: string;
  domains?: string[];
  shortName?: string;
  aliases?: string[];
  authors?: string[];
  year?: number;
  venue?: string;
  categories?: string[];
  tags?: string[];
  status?: 'to-read' | 'reading' | 'read' | 'untracked';
  rating?: number;
  summaryZh?: string;
  abstract?: string;
  added?: string | Date;
  links?: { arxiv?: string; pdf?: string; project?: string; code?: string };
};
const entries = await getCollection('knowledge');
const body = (e: (typeof entries)[number]) => e.body || '';
const heading = (e: (typeof entries)[number]) => body(e).match(/^#\s+(.+)$/m)?.[1]?.trim() || e.id.split('/').pop() || e.id;
const meta = (e: (typeof entries)[number]) => e.data as PaperMeta;
const getYear = (id: string) => Number(id.match(/20\d{2}/)?.[0] || 0);
const paperNotes = entries.filter(e => /^papers\/20\d{2}\//.test(e.id));
const reviews = entries.filter(e => e.id.includes('/reviews/'));
const topicHubs = entries.filter(e => e.id.startsWith('topics/') && e.id.endsWith('/README') && e.id.split('/').length === 3);
const glossaries = entries.filter(e => e.id.startsWith('glossary/') && !e.id.endsWith('README'));
const ideas = entries.filter(e => e.id.startsWith('research/') && !e.id.endsWith('README'));
const paths = entries.filter(e => e.id.startsWith('paths/'));
const termGroups = await Promise.all(glossaries.map(async e => {
  const { headings } = await render(e);
  const sections = (e.body || '').split(/^##\s+/m).slice(1);
  return headings.filter(h => h.depth === 2).map((h,i) => {
    const section = sections[i] || '';
    const description = section.split('\n').slice(1).join(' ')
      .replace(/`[^`]+`/g, ' ').replace(/\[([^\]]+)]\([^)]+\)/g, '$1')
      .replace(/[*_~#>|]/g, ' ').replace(/\s+/g,' ').trim().slice(0,155);
    return {
      kind: 'term', id: e.id + '#' + h.slug, href: '/research/' + e.id + '/#' + h.slug,
      title: h.text, summary: description,
      categories: meta(e).categories || [],
      domains: meta(e).domains || [],
      searchText: h.text + ' ' + description,
    };
  });
}));
const glossaryTerms = termGroups.flat();
const papers = paperNotes.map(e => {
  const m = meta(e);
  const embeddedTags = body(e).match(/^[-*]\s+\*\*标签\*\*[:：]\s*(.+)$/m)?.[1]?.split(/\s*[\/、,，|]\s*/).filter(Boolean) || [];
  const embeddedSource = body(e).match(/https?:\/\/(?:arxiv\.org|proceedings\.mlr\.press|aclanthology\.org|openreview\.net|huggingface\.co\/papers)[^\s)>\]]*/)?.[0] || '';
  return {
    kind: m.contentType || 'paper',
    id: e.id,
    href: '/research/' + e.id + '/',
    title: m.title || heading(e),
    shortName: m.shortName || '',
    aliases: m.aliases || [],
    summary: m.summaryZh || m.abstract || '',
    external: Object.values(m.links || {}).find(v => typeof v === 'string' && /^https?:\/\//.test(v)) || embeddedSource,
    noteDepth: body(e).length > 750 ? '详细笔记' : '简要笔记',
    authors: m.authors || [],
    year: m.year || getYear(e.id),
    venue: m.venue || '',
    categories: m.categories || [],
    domains: m.domains || [],
    tags: m.tags?.length ? m.tags : embeddedTags,
    status: m.status || 'untracked',
    rating: m.rating || 0,
    searchText: [m.shortName || '', ...(m.aliases || []), body(e).slice(0,14000)].join(' '),
    added: m.added ? (m.added instanceof Date ? m.added.toISOString().slice(0, 10) : String(m.added)) : '',
  };
});
// Every knowledge object has one contentType and multiple cross-disciplinary domains.
// Glossary headings remain deep-linkable in search, but do not inflate domain counts.
const docItem = (e: (typeof entries)[number]) => {
  const m = meta(e);
  return {
    kind: m.contentType || (e.id.startsWith('paths/') ? 'path' : e.id.startsWith('glossary/') ? 'glossary' : 'review'),
    id: e.id, href: '/research/' + e.id + '/',
    title: m.title || heading(e),
    summary: m.summaryZh || '',
    categories: m.categories || [],
    domains: m.domains || [],
    searchText: body(e).slice(0, 14000),
  };
};
const other = [...topicHubs, ...paths, ...reviews, ...glossaries, ...ideas].map(docItem);
const items = [...papers, ...other, ...glossaryTerms];
const countType = (kind: string) => items.filter(item => item.kind === kind).length;
const areas = domainCatalog.map(area => ({
  ...area,
  count: entries.filter(e => domainMatches((e.data as {domains?:string[]}).domains,area.id)).length,
  topics: topicHubs.filter(e => domainMatches((e.data as {domains?:string[]}).domains,area.id)).slice(0,2).map(e => ({
    href:'/research/'+e.id.slice(0,-'/README'.length)+'/',
    name:(e.data as {shortName?:string;title?:string}).shortName || (e.data as {title?:string}).title || e.id,
  })),
}));
const serialized = JSON.stringify(items).replace(/</g, '\\u003c');
---

<Base title="研究知识库" description="从领域和技术专题出发，阅读概念、论文、技术综述与未解决的研究问题。">
  <SectionNav section="research" active="overview" />
  <section class="lit-intro">
    <p class="lit-eyebrow">PERSONAL RESEARCH LIBRARY</p>
    <h1 class="page-title">研究知识库</h1>
    <p class="page-intro">以研究问题为线索，理解基础概念、技术路线与实验证据。可以从领域与专题逐层阅读，也可以检索全部论文、综述和研究问题。</p>
  </section>
  <section class="research-areas" aria-labelledby="research-areas-heading">
    <div class="research-areas-heading">
      <div><p class="lit-eyebrow">RESEARCH AREAS</p><h2 id="research-areas-heading">从研究领域开始</h2></div>
      <p>知识领域与内容类型分开组织；同一篇文章可能属于多个领域，但正文只维护一份。</p>
    </div>
    <div class="research-areas-grid">
      {areas.map((area,i) => (
        <article class="research-area-card">
          <div class="research-area-top"><span class="research-area-number">{String(i+1).padStart(2,'0')}</span><span class="research-area-count">{area.count} 项内容</span></div>
          <h3><a href={'/research/domains/'+area.slug+'/'}><span data-l="zh">{area.id}</span><span data-l="en">{area.en}</span> <span aria-hidden="true">↗</span></a></h3>
          <p><span data-l="zh">{area.description}</span><span data-l="en">{area.descriptionEn}</span></p>
          {area.topics.length > 0 && <div class="research-area-topics"><span class="research-area-topics-label">技术专题</span>{area.topics.map(t=><a href={t.href}>{t.name} →</a>)}</div>}
        </article>
      ))}
    </div>
  </section>
  <section class="research-entryways" aria-label="按内容类型探索研究">
    <a href="/paper-notes/"><strong>论文解读</strong><span>从概念、机制到原始证据 →</span></a>
    <a href="/questions/"><strong>问题与探索</strong><span>持续追问的开放研究问题 →</span></a>
    <a href="#all-knowledge"><strong>完整知识索引</strong><span>跨领域检索、筛选和比较 →</span></a>
  </section>
  <section class="research-index-head" id="all-knowledge" aria-labelledby="research-index-title">
    <p class="lit-eyebrow">ALL KNOWLEDGE</p><h2 id="research-index-title">全部知识与检索</h2>
    <p>按领域、内容类型和关键词交叉筛选。论文阅读状态及对比功能保持独立可用。</p>
    <div class="lit-shortcuts" aria-label="按知识类型筛选">
      <button type="button" data-type="all"><strong>{papers.length + other.length}</strong><span>全部内容</span></button>
      {contentTypes.map(type => (
        <button type="button" data-type={type.id}><strong>{countType(type.id)}</strong><span>{type.label}</span></button>
      ))}
    </div>
  </section>
  <section id="lit-continue" class="lit-continue" hidden aria-label="继续上次学习">
    <span class="lit-continue-caption">继续上次学习 <small>仅保存在当前浏览器</small></span>
    <a id="lit-continue-link" href="/research/">查看上次阅读的位置 →</a>
    <button type="button" id="lit-continue-dismiss" aria-label="隐藏继续学习提示">×</button>
  </section>
  <div class="lit" id="lit">
    <div class="lit-search-wrap">
      <span class="lit-search-icon" aria-hidden="true">⌕</span>
      <label class="sr-only" for="lit-search">搜索研究知识库</label>
      <input id="lit-search" class="lit-search" type="search" placeholder="搜索论文标题、内容、作者、关键词、术语…" autocomplete="off" />
      <button type="button" id="lit-clear" hidden>清除</button>
      <kbd>/</kbd>
    </div>
    <div class="lit-main">
      <button type="button" class="lit-mobile-folder-toggle" id="lit-mobile-folder-toggle" aria-expanded="false" aria-controls="lit-sidebar">
        <span id="lit-mobile-active">浏览研究领域：全部内容</span><span aria-hidden="true">⌄</span>
      </button>
      <aside class="lit-sidebar" id="lit-sidebar" aria-label="研究领域目录">
        <div class="lit-side-head"><strong>研究目录</strong><button id="lit-expand" type="button">展开全部</button></div>
        <nav class="lit-tree" id="lit-tree" aria-label="研究方向"></nav>
        <p class="lit-side-hint">同一篇文章可归属多个领域，但正文只维护一份。</p>
      </aside>
      <section class="lit-results" aria-label="研究条目">
        <div class="lit-heading">
          <div class="lit-crumb" id="lit-crumb" aria-live="polite"></div>
          <label class="lit-sort-label" for="lit-sort">排序
            <select id="lit-sort">
              <option value="year">推荐阅读顺序</option>
              <option value="added">收藏时间</option>
              <option value="rating">我的评分</option>
              <option value="title">标题 A–Z</option>
            </select>
          </label>
        </div>
        <section class="lit-compare-bar" aria-label="论文对比">
          <span id="lit-compare-status" aria-live="polite">选择 2–3 篇论文进行横向比较</span>
          <a id="lit-compare-link" href="/research/compare/" aria-disabled="true">开始比较</a>
          <button type="button" id="lit-compare-clear">清除选择</button>
        </section>
        <div id="lit-context"></div>
        <div class="lit-filters" id="lit-filters" aria-label="筛选阅读状态">
          <button type="button" data-status="all" class="active">全部论文</button>
          <button type="button" data-status="to-read">想读</button>
          <button type="button" data-status="reading">在读</button>
          <button type="button" data-status="read">已读</button>
          <button type="button" data-status="untracked">未标记</button>
        </div>
        <div id="lit-body"></div>
        <div id="lit-more" class="lit-more" hidden>
          <button type="button" id="lit-more-button">加载更多</button>
        </div>
      </section>
    </div>
  </div>
  <p class="lit-source-note">内容使用 Markdown 维护于 <a href="https://github.com/Suchenl/Suchenl.github.io/tree/main/knowledge" target="_blank" rel="noopener noreferrer">GitHub / knowledge</a>。阅读状态代表你的实际阅读进度，不会因为 AI 写过笔记就自动标记为「已读」。</p>
  <script type="application/json" id="research-items-json" set:html={serialized}></script>
</Base>

<script src="../../scripts/research-library.ts"></script>
