---
import Base from '../../layouts/Base.astro';
import '../../styles/research-reader.css';
import { getCollection, render } from 'astro:content';
import { buildKnowledgeGraph, readingSteps } from '../../lib/research-graph';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data as {
  title?: string; summaryZh?: string; categories?: string[];
  status?: string; rating?: number;
  links?: { arxiv?: string; pdf?: string; code?: string; project?: string };
};
const hasHeading = /^#\s+/m.test(entry.body || '');
const title = data.title || (entry.body || '').match(/^#\s+(.+)$/m)?.[1]?.trim() || entry.id.split('/').pop() || '研究笔记';
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const isPaper = entry.id.startsWith('papers/');
const source = 'https://github.com/Suchenl/Suchenl.github.io/blob/main/knowledge/' + entry.id + '.md';
const editSource = 'https://github.com/Suchenl/Suchenl.github.io/edit/main/knowledge/' + entry.id + '.md';
const category = data.categories?.[0];
const folderHref = category ? '/research/?folder=' + encodeURIComponent('cat:' + category) : '/research/';
const statusLabel: Record<string, string> = { 'to-read': '想读', reading: '在读', read: '已读', untracked: '未标记' };
const outLinks = Object.entries(data.links || {}).filter((pair): pair is [string, string] => typeof pair[1] === 'string' && /^https?:\/\//.test(pair[1]));
const sourceLabels: Record<string, string> = { arxiv: 'arXiv', pdf: 'PDF', project: '项目主页', code: '代码' };
const isLearningPath = entry.id.startsWith('paths/');
const kind = isLearningPath ? '学习路线' : isPaper ? '论文笔记' : entry.id.startsWith('glossary/') ? '术语解释' : entry.id.startsWith('research/') ? '研究设想' : '主题综述';
const prose = (entry.body || '').replace(/^---[\s\S]*?---\s*/, '').replace(/`{3}[\s\S]*?`{3}/g, '');
const minutes = Math.max(1, Math.ceil((prose.match(/[\u3400-\u9fff]/g) || []).length / 350 + (prose.match(/[A-Za-z]+/g) || []).length / 200));
const canShowToc = toc.length > 1;
const graphEntries = await getCollection('knowledge');
const graph = buildKnowledgeGraph(graphEntries);
const typedRelations = ((entry.data as { related?: {ref:string;type:string;note:string}[] }).related || [])
  .map(relation=>({...relation,node:graph.nodes.get(relation.ref)}))
  .filter(x=>x.node);
const semanticLabels:Record<string,string> = {
  compares:'方法对比', extends:'后续改进', requires:'前置知识', questions:'值得质疑', supports:'支持证据',
};
const inbound = graph.incomingFor(entry.id).filter(n => n.kind !== 'other');
const outbound = graph.outgoingFor(entry.id).filter(n => n.kind !== 'other');
const routeNeighbors = graph.pathsFor(entry.id).map(pathNode => {
  const pathRecord = (graphEntries).find(e => e.id === pathNode.id);
  const items = pathRecord ? readingSteps(pathRecord) : [];
  const index = items.findIndex(x => x.ref === entry.id);
  return index < 0 ? null : {
    title: pathNode.title, href: pathNode.href, current: index + 1, total: items.length,
    previous: index > 0 ? graph.nodes.get(items[index - 1].ref) : null,
    next: index + 1 < items.length ? graph.nodes.get(items[index + 1].ref) : null,
  };
}).filter((item): item is NonNullable<typeof item> => item !== null);
const steps = readingSteps(entry).map((step, i) => ({
  index: i,
  ...step,
  node: graph.nodes.get(step.ref)!,
}));
const navShortcuts = toc.filter(h => h.depth === 2 && /(一句话|核心|问题|方法|实验|局限|分析|结论|对比|研究|证据|学习目标)/.test(h.text)).slice(0, 5);

const allPaperEntries = isPaper ? await getCollection('knowledge') : [];
const relatedPapers = category ? allPaperEntries.filter(e => {
  if (e.id === entry.id || !e.id.startsWith('papers/')) return false;
  const cats = (e.data as { categories?: string[] }).categories || [];
  return cats.some(c => c === category);
}).slice(0, 3).map(e => ({
  href: '/research/' + e.id + '/',
  title: (e.data as { title?: string }).title || (e.body || '').match(/^#\s+(.+)$/m)?.[1] || e.id,
})) : [];
---

<Base title={title} description={data.summaryZh || '研究知识库 · ' + title}>
  <div class="rkd-page" id="research-reader" data-document-id={entry.id} data-document-title={title}>
    <div class="rkd-progress" id="reading-progress" aria-hidden="true"></div>
    <nav class="rkd-breadcrumb" aria-label="位置">
      <a href="/research/">Research</a><span aria-hidden="true">/</span>
      {isPaper && category ? <a href={folderHref}>{category.replaceAll('/', ' / ')}</a> : <span>{kind}</span>}
    </nav>
    <header class="rkd-head">
      <div class="rkd-kicker">{kind} <span aria-hidden="true">·</span> 约 {minutes} 分钟阅读</div>
      <h1>{title}</h1>
      {data.summaryZh && <p class="rkd-description">{data.summaryZh}</p>}
      {isPaper && (
        <div class="rkd-meta">
          {(data.categories || []).map(cat => <a href={'/research/?folder=' + encodeURIComponent('cat:' + cat)}>{cat.replaceAll('/', ' / ')}</a>)}
          {data.status && <span>阅读状态：{statusLabel[data.status] || data.status}</span>}
          {data.rating && data.rating > 0 && <span>评分 {data.rating}/5</span>}
        </div>
      )}
      <div class="rkd-sources">
        {outLinks.map(([name, url]) => <a href={url} target="_blank" rel="noopener noreferrer">{sourceLabels[name] || name} ↗</a>)}
        <a href={editSource} target="_blank" rel="noopener noreferrer">编辑 Markdown ↗</a>
      </div>
    </header>

    <div class="rkd-reading-tools" role="group" aria-label="阅读设置">
      <span class="rkd-tool-label">阅读设置</span>
      <button type="button" data-font="down" aria-label="缩小正文字号">A−</button>
      <button type="button" data-font="up" aria-label="放大正文字号">A+</button>
      <span class="rkd-tool-divider" aria-hidden="true"></span>
      <button type="button" id="rkd-focus" aria-pressed="false">专注阅读</button>
      <button type="button" id="rkd-copy-link">复制链接</button>
      <button type="button" id="rkd-resume" hidden>继续上次读到的章节</button>
      <span class="rkd-tool-note" aria-live="polite" id="rkd-tool-note"></span>
    </div>

    {navShortcuts.length > 1 && !isLearningPath && (
      <nav class="rkd-quick" aria-label="快速定位">
        <span>快速定位</span>
        {navShortcuts.map(h => <a href={'#' + h.slug}>{h.text}</a>)}
      </nav>
    )}
    {canShowToc && (
      <details class="rkd-mobile-toc">
        <summary>本页目录 · {toc.length} 节</summary>
        <nav aria-label="移动端文章目录">
          {toc.map(h => <a class={h.depth === 3 ? 'rkd-toc-sub' : ''} href={'#' + h.slug}>{h.text}</a>)}
        </nav>
      </details>
    )}

    <div class:list={['rkd-layout', !canShowToc && 'rkd-no-toc']}>
      <article class="rkd-article" id="reader-article">
        <div class="rkd-prose">
          <Content />
          {!isLearningPath && (
            <details class="rkd-recall">
              <summary>学完以后，我能否回答这些问题？</summary>
              <ol>
                {isPaper && <li>这篇论文真正优化的目标是什么？训练信号从哪里获得？</li>}
                {isPaper && <li>它的核心机制相对基线新增了什么？主要收益在什么条件下成立？</li>}
                {isPaper && <li>哪些结论有实验支持，哪些迁移到我的研究还需要验证？</li>}
                {entry.id.includes('/reviews/') && <li>这里比较的方法路线，本质差别是什么？</li>}
                {entry.id.includes('/reviews/') && <li>每条路线最有力的证据与争议分别是什么？</li>}
                {entry.id.includes('/reviews/') && <li>如果重新设计一个消融实验，应先检验哪条假设？</li>}
                {entry.id.startsWith('glossary/') && <li>我能不用原文复述这些概念的定义吗？</li>}
                {entry.id.startsWith('glossary/') && <li>能举出满足定义的例子与常见反例吗？</li>}
                {entry.id.startsWith('glossary/') && <li>哪些概念容易混淆？分界条件在哪里？</li>}
                {entry.id.startsWith('research/') && <li>这里最重要、尚未验证的研究假设是什么？</li>}
                {entry.id.startsWith('research/') && <li>什么实验结果会直接否定这个假设？</li>}
                {entry.id.startsWith('research/') && <li>哪些现有工作已覆盖部分设想？哪些能力仍需证据？</li>}
              </ol>
              <p>建议不看正文先回答，再回到相关章节核对。这里不自动判定「已读」。</p>
            </details>
          )}
          {isLearningPath && steps.length > 0 && (
            <section class="rkd-learning-path" aria-label="循序学习任务">
              <div class="rkd-learning-heading">
                <div><h2 id="learning-steps">按顺序学习</h2><p>每步都有明确目标，建议先复述关键概念，再继续下一步。</p></div>
                <div class="rkd-learning-count" role="status" aria-live="polite" id="path-count">0 / {steps.length} 步</div>
              </div>
              <progress id="path-progress" value="0" max={steps.length} aria-label="本机学习路线完成进度">0</progress>
              <div class="rkd-step-list">
                {steps.map((step) => (
                  <div class="rkd-step" data-step-index={step.index}>
                    <label class="rkd-step-check">
                      <input type="checkbox" data-learning-step={step.index} aria-label={'已学习：' + step.node.title}/>
                      <span class="rkd-step-number">{step.index + 1}</span>
                    </label>
                    <div class="rkd-step-content">
                      <span class="rkd-step-stage">{step.stage || '学习步骤'} · {step.node.kind === 'glossary' ? '术语' : step.node.kind === 'review' ? '综述' : step.node.kind === 'paper' ? '论文' : '研究问题'}</span>
                      <a href={step.node.href}>{step.node.title} →</a>
                      <p>{step.why}</p>
                    </div>
                  </div>
                ))}
              </div>
              <p class="rkd-path-privacy">这里的勾选仅保存在当前浏览器，不会改动 GitHub 论文状态，也不会跨设备同步。</p>
            </section>
          )}
        </div>
        {typedRelations.length > 0 && (
          <section class="rkd-related rkd-semantic" aria-label="有类型的研究关联">
            <h2>重要研究关联</h2>
            {typedRelations.map(r=>(
              <div class="rkd-semantic-item">
                <span>{semanticLabels[r.type] || r.type}</span>
                <a href={r.node!.href}>{r.node!.title} →</a>
                <p>{r.note}</p>
              </div>
            ))}
            <p class="rkd-path-privacy">关联类型由知识库编辑者维护，不使用相似度猜测或自动归因。</p>
          </section>
        )}
        {isLearningPath === false && outbound.length > 0 && (
          <section class="rkd-related rkd-relations">
            <h2>本文引用的知识资料 <span>{outbound.length}</span></h2>
            <div class="rkd-relation-links">
              {outbound.slice(0, 8).map(n => <a href={n.href}><small>{n.kind === 'paper' ? '论文' : n.kind === 'glossary' ? '术语' : n.kind === 'review' ? '综述' : n.kind === 'path' ? '路线' : '研究'}</small>{n.title}</a>)}
            </div>
            {outbound.length > 8 && <details class="rkd-relation-more"><summary>展开其余 {outbound.length - 8} 项</summary><div class="rkd-relation-links">{outbound.slice(8).map(n => <a href={n.href}>{n.title}</a>)}</div></details>}
          </section>
        )}
        {inbound.length > 0 && (
          <section class="rkd-related rkd-relations">
            <h2>哪些内容链接到这里 <span>{inbound.length}</span></h2>
            <div class="rkd-relation-links">
              {inbound.map(n => <a href={n.href}><small>{n.kind === 'path' ? '学习路线' : n.kind === 'review' ? '综述' : n.kind === 'glossary' ? '术语' : n.kind === 'paper' ? '论文' : '研究问题'}</small>{n.title}</a>)}
            </div>
            <p class="rkd-path-privacy">根据本知识库的 Markdown 链接和学习步骤自动生成，不代表正式学术引用。</p>
          </section>
        )}
        {routeNeighbors.length > 0 && (
          <section class="rkd-route-neighbors" aria-label="学习路线前后步骤">
            {routeNeighbors.map(route => (
              <div class="rkd-route-neighbor">
                <p><a href={route.href}>{route.title}</a> · 第 {route.current}/{route.total} 步</p>
                <div class="rkd-route-actions">
                  {route.previous ? <a href={route.previous.href}>← 上一步：{route.previous.title}</a> : <span>这是路线起点</span>}
                  {route.next ? <a href={route.next.href}>下一步：{route.next.title} →</a> : <span>已经到达路线终点</span>}
                </div>
              </div>
            ))}
          </section>
        )}
        {relatedPapers.length > 0 && (
          <section class="rkd-related">
            <h2>同一研究方向的论文</h2>
            {relatedPapers.map(item => <a href={item.href}>{item.title} ↗</a>)}
          </section>
        )}
        <div class="rkd-foot">
          <a id="research-return" href={isPaper ? folderHref : '/research/'}>← 返回研究目录</a>
          <a href={editSource} target="_blank" rel="noopener noreferrer">编辑或完善笔记 ↗</a>
        </div>
      </article>

      {canShowToc && (
        <aside class="rkd-aside">
          <div class="rkd-outline">
            <div class="rkd-outline-title">本页目录</div>
            <nav aria-label="文章目录">
              {toc.map(h => <a class={h.depth === 3 ? 'rkd-toc-sub' : ''} href={'#' + h.slug}>{h.text}</a>)}
            </nav>
            <button type="button" class="rkd-top-shortcut" id="rkd-top-outline">↑ 回到顶部</button>
          </div>
        </aside>
      )}
    </div>
    <button type="button" id="rkd-back-top" aria-label="回到顶部">↑</button>
  </div>
</Base>

<script src="../../scripts/research-reader.ts"></script>
