---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data as {
  title?: string; summaryZh?: string; categories?: string[];
  status?: string; rating?: number;
  links?: { arxiv?: string; pdf?: string; code?: string; project?: string };
};
const hasHeading = /^#\s+/m.test(entry.body || '');
const title = data.title || (entry.body || '').match(/^#\s+(.+)$/m)?.[1]?.trim() || entry.id.split('/').pop() || '研究笔记';
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const isPaper = entry.id.startsWith('papers/');
const source = 'https://github.com/Suchenl/Suchenl.github.io/blob/main/knowledge/' + entry.id + '.md';
const category = data.categories?.[0];
const folderHref = category ? '/research/?folder=' + encodeURIComponent('cat:' + category) : '/research/';
const statusLabel: Record<string, string> = { 'to-read': '想读', reading: '在读', read: '已读', untracked: '未标记' };
const outLinks = Object.entries(data.links || {}).filter((pair): pair is [string, string] => typeof pair[1] === 'string' && /^https?:\/\//.test(pair[1]));
const sourceLabels: Record<string, string> = { arxiv: 'arXiv', pdf: 'PDF', project: '项目主页', code: '代码' };
const relatedReviews = isPaper ? (await getCollection('knowledge'))
  .filter(e => e.id.includes('/reviews/') && (e.body || '').includes(entry.id + '.md'))
  .map(e => ({
    href: '/research/' + e.id + '/',
    title: (e.data as { title?: string }).title || (e.body || '').match(/^#\s+(.+)$/m)?.[1] || e.id,
  })) : [];
---

<Base title={title} description={'研究知识库 · ' + title}>
  <div class="rkd-crumb">
    <a href={isPaper ? folderHref : "/research/"}>← 研究知识库</a>
    <span>/</span>
    <span>{isPaper ? '论文解读' : entry.id.startsWith('glossary/') ? '术语' : entry.id.startsWith('research/') ? '研究问题' : '主题综述'}</span>
  </div>
  <div class="rkd-shell">
    <article class="rkd-article">
      <div class="rkd-copy"><a href={source} target="_blank" rel="noopener">GitHub 上查看与编辑 Markdown ↗</a></div>
      {isPaper && (
        <div class="rkd-metadata">
          {category && <a href={folderHref}>{category.replaceAll('/', ' / ')}</a>}
          {data.status && <span>{statusLabel[data.status] || data.status}</span>}
          {data.rating && data.rating > 0 && <span>评分：{data.rating}/5</span>}
        </div>
      )}
      {!hasHeading && <h1>{title}</h1>}
      {!hasHeading && data.summaryZh && <p class="rkd-summary">{data.summaryZh}</p>}
      {outLinks.length > 0 && (
        <div class="rkd-externals">
          {outLinks.map(([kind, url]) => <a href={url} target="_blank" rel="noopener noreferrer">{sourceLabels[kind] || kind} ↗</a>)}
        </div>
      )}
      <Content />
      {relatedReviews.length > 0 && (
        <section class="rkd-related">
          <h2>关联主题综述</h2>
          {relatedReviews.map(review => <p><a href={review.href}>{review.title} →</a></p>)}
        </section>
      )}
      <div class="rkd-end"><a href={isPaper ? folderHref : "/research/"}>← 返回研究目录</a></div>
    </article>
    {toc.length > 1 && (
      <aside class="rkd-sidebar">
        <div class="rkd-sticky">
          <div class="rkd-toc-head">本文目录</div>
          <nav aria-label="本文目录">
            {toc.map(h => <a class={h.depth === 3 ? 'rkd-toc-sub' : ''} href={'#' + h.slug}>{h.text}</a>)}
          </nav>
        </div>
      </aside>
    )}
  </div>
</Base>

<style>
  .rkd-metadata { display:flex;gap:.65rem;flex-wrap:wrap;margin:.8rem 0 1rem;color:var(--fg-muted);font-size:.81rem; }
  .rkd-metadata a { font-weight:700; }
  .rkd-metadata span { padding:.15rem .55rem;background:var(--surface-2);border-radius:999px; }
  .rkd-summary { color:var(--fg-muted);font-size:1.02rem; }
  .rkd-externals { display:flex;flex-wrap:wrap;gap:.7rem;margin:1rem 0; }
  .rkd-externals a { display:inline-flex;padding:.3rem .65rem;border-radius:10px;background:var(--accent-soft);font-size:.82rem;font-weight:650; }
  .rkd-related { margin-top:2.5rem;padding-top:.5rem;border-top:1px solid var(--border); }
  .rkd-crumb { display: flex; gap: .5rem; align-items: center; margin: 1.4rem 0; color: var(--fg-muted); font-size: .86rem; }
  .rkd-crumb a { color: var(--accent-ink); font-weight: 700; }
  .rkd-shell { display: grid; grid-template-columns: minmax(0,1fr) 214px; gap: 2.5rem; align-items: start; }
  .rkd-article { min-width: 0; background: var(--surface); border-radius: 16px; border: 1px solid var(--border); padding: clamp(1.1rem,3vw,2.5rem); margin-bottom: 3.5rem; overflow-wrap: anywhere; }
  .rkd-copy { display: flex; justify-content: flex-end; padding-bottom: .7rem; border-bottom: 1px solid var(--border); }
  .rkd-copy a { color: var(--fg-muted); font-size: .74rem; }
  .rkd-article :global(h1) { margin: 1.5rem 0 1.4rem; font-size: clamp(1.4rem,2.5vw,2rem); line-height: 1.3; }
  .rkd-article :global(h2) { margin: 2.1rem 0 .9rem; padding-bottom: .45rem; font-size: 1.28rem; border-bottom: 1px solid var(--border); scroll-margin-top: 80px; }
  .rkd-article :global(h3) { font-size: 1.03rem; margin: 1.45rem 0 .7rem; scroll-margin-top: 80px; }
  .rkd-article :global(p),.rkd-article :global(li) { line-height: 1.9; }
  .rkd-article :global(a) { text-decoration: underline; text-underline-offset: .2em; }
  .rkd-article :global(blockquote) { border-left: 3px solid var(--accent); background: var(--surface-2); margin: 1.2rem 0; padding: .65rem 1rem; color: var(--fg-muted); }
  .rkd-article :global(blockquote p) { margin: .25rem 0; }
  .rkd-article :global(table) { width: 100%; border-collapse: collapse; font-size: .84rem; margin: 1.2rem 0; display: block; overflow-x: auto; }
  .rkd-article :global(th),.rkd-article :global(td) { border-bottom: 1px solid var(--border); padding: .65rem .8rem; text-align: left; min-width: 90px; }
  .rkd-article :global(th) { background: var(--surface-2); font-weight: 800; }
  .rkd-article :global(pre) { margin: 1rem 0; font-size: .84rem; }
  .rkd-article :global(.katex-display) { overflow-x: auto; padding: .4rem 0; }
  .rkd-article :global(ul),.rkd-article :global(ol) { padding-left: 1.35rem; }
  .rkd-article :global(hr) { border: 0; border-top: 1px solid var(--border); margin: 2rem 0; }
  .rkd-end { padding-top: 1.7rem; margin-top: 2rem; border-top: 1px solid var(--border); font-size: .86rem; }
  .rkd-sidebar { min-width: 0; }
  .rkd-sticky { position: sticky; top: 88px; max-height: calc(100vh - 110px); overflow: auto; }
  .rkd-toc-head { font-size: .76rem; color: var(--fg-muted); font-weight: 800; letter-spacing: .03em; margin: .2rem 0 .7rem; }
  .rkd-sidebar nav { display: grid; gap: .15rem; border-left: 1px solid var(--border); padding-left: .75rem; }
  .rkd-sidebar nav a { display: block; border-radius: 5px; padding: .34rem .15rem; color: var(--fg-muted); font-size: .75rem; line-height: 1.55; }
  .rkd-sidebar nav a:hover { color: var(--accent-ink); }
  .rkd-sidebar nav a.rkd-toc-sub { padding-left: .8rem; font-size: .71rem; }
  @media (max-width:900px) { .rkd-shell { grid-template-columns: minmax(0,1fr); } .rkd-sidebar { display: none; } }
</style>
