---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data as {
  title?: string; summaryZh?: string; categories?: string[];
  status?: string; rating?: number;
  links?: { arxiv?: string; pdf?: string; code?: string; project?: string };
};
const hasHeading = /^#\s+/m.test(entry.body || '');
const title = data.title || (entry.body || '').match(/^#\s+(.+)$/m)?.[1]?.trim() || entry.id.split('/').pop() || '研究笔记';
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const isPaper = entry.id.startsWith('papers/');
const source = 'https://github.com/Suchenl/Suchenl.github.io/blob/main/knowledge/' + entry.id + '.md';
const editSource = 'https://github.com/Suchenl/Suchenl.github.io/edit/main/knowledge/' + entry.id + '.md';
const category = data.categories?.[0];
const folderHref = category ? '/research/?folder=' + encodeURIComponent('cat:' + category) : '/research/';
const statusLabel: Record<string, string> = { 'to-read': '想读', reading: '在读', read: '已读', untracked: '未标记' };
const outLinks = Object.entries(data.links || {}).filter((pair): pair is [string, string] => typeof pair[1] === 'string' && /^https?:\/\//.test(pair[1]));
const sourceLabels: Record<string, string> = { arxiv: 'arXiv', pdf: 'PDF', project: '项目主页', code: '代码' };
const relatedReviews = isPaper ? (await getCollection('knowledge'))
  .filter(e => e.id.includes('/reviews/') && (e.body || '').includes(entry.id + '.md'))
  .map(e => ({
    href: '/research/' + e.id + '/',
    title: (e.data as { title?: string }).title || (e.body || '').match(/^#\s+(.+)$/m)?.[1] || e.id,
  })) : [];
const kind = isPaper ? '论文笔记' : entry.id.startsWith('glossary/') ? '术语解释' : entry.id.startsWith('research/') ? '研究设想' : '主题综述';
const prose = (entry.body || '').replace(/^---[\s\S]*?---\s*/, '').replace(/`{3}[\s\S]*?`{3}/g, '');
const minutes = Math.max(1, Math.ceil((prose.match(/[\u3400-\u9fff]/g) || []).length / 350 + (prose.match(/[A-Za-z]+/g) || []).length / 200));
const canShowToc = toc.length > 1;
const allPaperEntries = isPaper ? await getCollection('knowledge') : [];
const relatedPapers = category ? allPaperEntries.filter(e => {
  if (e.id === entry.id || !e.id.startsWith('papers/')) return false;
  const cats = (e.data as { categories?: string[] }).categories || [];
  return cats.some(c => c === category);
}).slice(0, 3).map(e => ({
  href: '/research/' + e.id + '/',
  title: (e.data as { title?: string }).title || (e.body || '').match(/^#\s+(.+)$/m)?.[1] || e.id,
})) : [];
---

<Base title={title} description={data.summaryZh || '研究知识库 · ' + title}>
  <div class="rkd-page" id="research-reader">
    <div class="rkd-progress" id="reading-progress" aria-hidden="true"></div>
    <nav class="rkd-breadcrumb" aria-label="位置">
      <a href="/research/">Research</a><span aria-hidden="true">/</span>
      {isPaper && category ? <a href={folderHref}>{category.replaceAll('/', ' / ')}</a> : <span>{kind}</span>}
    </nav>
    <header class="rkd-head">
      <div class="rkd-kicker">{kind} <span aria-hidden="true">·</span> 约 {minutes} 分钟阅读</div>
      <h1>{title}</h1>
      {data.summaryZh && <p class="rkd-description">{data.summaryZh}</p>}
      {isPaper && (
        <div class="rkd-meta">
          {(data.categories || []).map(cat => <a href={'/research/?folder=' + encodeURIComponent('cat:' + cat)}>{cat.replaceAll('/', ' / ')}</a>)}
          {data.status && <span>阅读状态：{statusLabel[data.status] || data.status}</span>}
          {data.rating && data.rating > 0 && <span>评分 {data.rating}/5</span>}
        </div>
      )}
      <div class="rkd-sources">
        {outLinks.map(([name, url]) => <a href={url} target="_blank" rel="noopener noreferrer">{sourceLabels[name] || name} ↗</a>)}
        <a href={editSource} target="_blank" rel="noopener noreferrer">编辑 Markdown ↗</a>
      </div>
    </header>

    <div class="rkd-reading-tools" role="group" aria-label="阅读设置">
      <span class="rkd-tool-label">阅读设置</span>
      <button type="button" data-font="down" aria-label="缩小正文字号">A−</button>
      <button type="button" data-font="up" aria-label="放大正文字号">A+</button>
      <span class="rkd-tool-divider" aria-hidden="true"></span>
      <button type="button" id="rkd-focus" aria-pressed="false">专注阅读</button>
      <button type="button" id="rkd-copy-link">复制链接</button>
      <span class="rkd-tool-note" aria-live="polite" id="rkd-tool-note"></span>
    </div>

    {canShowToc && (
      <details class="rkd-mobile-toc">
        <summary>本页目录 · {toc.length} 节</summary>
        <nav aria-label="移动端文章目录">
          {toc.map(h => <a class={h.depth === 3 ? 'rkd-toc-sub' : ''} href={'#' + h.slug}>{h.text}</a>)}
        </nav>
      </details>
    )}

    <div class:list={['rkd-layout', !canShowToc && 'rkd-no-toc']}>
      <article class="rkd-article" id="reader-article">
        <div class="rkd-prose">
          <Content />
        </div>
        {relatedReviews.length > 0 && (
          <section class="rkd-related">
            <h2>关联主题综述</h2>
            {relatedReviews.map(item => <a href={item.href}>{item.title} ↗</a>)}
          </section>
        )}
        {relatedPapers.length > 0 && (
          <section class="rkd-related">
            <h2>同一研究方向的论文</h2>
            {relatedPapers.map(item => <a href={item.href}>{item.title} ↗</a>)}
          </section>
        )}
        <div class="rkd-foot">
          <a id="research-return" href={isPaper ? folderHref : '/research/'}>← 返回研究目录</a>
          <a href={editSource} target="_blank" rel="noopener noreferrer">编辑或完善笔记 ↗</a>
        </div>
      </article>

      {canShowToc && (
        <aside class="rkd-aside">
          <div class="rkd-outline">
            <div class="rkd-outline-title">本页目录</div>
            <nav aria-label="文章目录">
              {toc.map(h => <a class={h.depth === 3 ? 'rkd-toc-sub' : ''} href={'#' + h.slug}>{h.text}</a>)}
            </nav>
            <button type="button" class="rkd-top-shortcut" id="rkd-top-outline">↑ 回到顶部</button>
          </div>
        </aside>
      )}
    </div>
    <button type="button" id="rkd-back-top" aria-label="回到顶部">↑</button>
  </div>
</Base>

<script>
  const reader = document.getElementById('research-reader') as HTMLElement | null;
  if (reader) {
    // A research page can be visited directly or through any of the paper's classifications.
    const params = new URLSearchParams(window.location.search);
    const from = params.get('from');
    const back = document.getElementById('research-return') as HTMLAnchorElement | null;
    const validFrom = from && /^(papers|reviews|glossary|ideas|cat:[^?#]+)$/.test(from);
    if (back) {
      const ret = new URL('/research/',window.location.origin);
      if (validFrom && from !== 'papers') ret.searchParams.set('folder',from);
      const q=params.get('q'),status=params.get('status'),sort=params.get('sort');
      if(q)ret.searchParams.set('q',q.slice(0,300));
      if(status && ['read','reading','to-read','untracked'].includes(status))ret.searchParams.set('status',status);
      if(sort && ['year','added','rating','title'].includes(sort))ret.searchParams.set('sort',sort);
      back.href=ret.pathname+ret.search;
    }
    const safeStored = (key: string) => {
      try { return localStorage.getItem(key); } catch { return null; }
    };
    const save = (key: string, value: string) => {
      try { localStorage.setItem(key, value); } catch { /* disabled storage */ }
    };
    const note = document.getElementById('rkd-tool-note');
    const sizes = [15, 16, 17, 18, 19, 20];
    let size = Number(safeStored('research-font-size') || '17');
    if (!sizes.includes(size)) size = 17;
    const setSize = (n: number) => {
      size = Math.max(15, Math.min(20, n));
      reader.style.setProperty('--reader-font', size + 'px');
      save('research-font-size', String(size));
      if (note) note.textContent = '正文 ' + size + 'px';
    };
    setSize(size);
    document.querySelectorAll<HTMLButtonElement>('[data-font]').forEach(button => {
      button.addEventListener('click', () => setSize(size + (button.dataset.font === 'up' ? 1 : -1)));
    });
    const focusButton = document.getElementById('rkd-focus');
    const setFocus = (enabled: boolean) => {
      reader.classList.toggle('focus-mode', enabled);
      focusButton?.setAttribute('aria-pressed', String(enabled));
      if (focusButton) focusButton.textContent = enabled ? '显示目录' : '专注阅读';
      save('research-focus-mode', enabled ? '1' : '0');
    };
    setFocus(safeStored('research-focus-mode') === '1');
    focusButton?.addEventListener('click', () => setFocus(!reader.classList.contains('focus-mode')));
    document.getElementById('rkd-copy-link')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (note) note.textContent = '链接已复制';
      } catch {
        if (note) note.textContent = '复制失败，请使用浏览器地址栏复制';
      }
    });
    document.getElementById('rkd-top-outline')?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    const backTop = document.getElementById('rkd-back-top');
    backTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    const progress = document.getElementById('reading-progress');
    const updateProgress = () => {
      const travel = document.documentElement.scrollHeight - window.innerHeight;
      const pct = travel > 0 ? Math.min(100, Math.max(0, window.scrollY / travel * 100)) : 100;
      if (progress) progress.style.width = pct + '%';
      backTop?.classList.toggle('visible', window.scrollY > 520);
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
    const mobileToc = document.querySelector<HTMLDetailsElement>('.rkd-mobile-toc');
    mobileToc?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { mobileToc.open = false; }));
    const anchors = Array.from(document.querySelectorAll<HTMLAnchorElement>('.rkd-outline nav a'));
    const targetById = anchors.map(a => ({ anchor: a, target: document.getElementById(decodeURIComponent(a.hash.slice(1))) })).filter(x => x.target);
    if (targetById.length) {
      const updateActive = () => {
        let active = targetById[0].anchor;
        for (const x of targetById) {
          if (x.target && x.target.getBoundingClientRect().top < 170) active = x.anchor;
        }
        anchors.forEach(a => {
          a.classList.toggle('is-current', a === active);
          if (a === active) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current');
        });
      };
      window.addEventListener('scroll', updateActive, { passive: true });
      updateActive();
    }
  }
</script>

<style>
  .rkd-page { --reader-font:17px; max-width:1100px; margin:0 auto 5rem; min-width:0; }
  .rkd-progress { position:fixed;z-index:55;top:61px;left:0;height:3px;width:0;background:var(--accent);pointer-events:none;transition:width .08s linear; }
  .rkd-breadcrumb { display:flex;gap:.65rem;align-items:center;flex-wrap:wrap;margin:1.6rem 0 2.2rem;color:var(--fg-muted);font-size:.83rem; }
  .rkd-breadcrumb a { color:var(--fg-muted); }
  .rkd-breadcrumb a:hover { color:var(--accent-ink); }
  .rkd-head { max-width:790px;margin:0 0 1.7rem; }
  .rkd-kicker { color:var(--accent-ink);font-size:.76rem;font-weight:750;letter-spacing:.035em;margin-bottom:.8rem; }
  .rkd-head h1 { font-size:clamp(1.65rem,3vw,2.22rem);line-height:1.36;letter-spacing:-.027em;margin:.2rem 0 1.05rem;overflow-wrap:anywhere; }
  .rkd-description { color:var(--fg-muted);font-size:1.04rem;line-height:1.85;margin:0 0 1.1rem; }
  .rkd-meta { display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;font-size:.79rem;color:var(--fg-muted); }
  .rkd-meta span,.rkd-meta a { display:inline-block;background:var(--surface-2);border-radius:7px;padding:.15rem .55rem;color:var(--fg-muted); }
  .rkd-meta a:hover {color:var(--accent-ink);}
  .rkd-sources { display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.2rem;font-size:.83rem;font-weight:650; }
  .rkd-sources a { text-decoration:none; }
  .rkd-reading-tools { display:flex;gap:.25rem;align-items:center;flex-wrap:wrap;background:var(--surface);border:1px solid var(--border);border-radius:12px;margin:1.5rem 0 1.8rem;padding:.45rem .65rem; }
  .rkd-tool-label { font-size:.77rem;color:var(--fg-muted);padding:0 .55rem; }
  .rkd-reading-tools button { border:0;border-radius:7px;padding:.42rem .65rem;background:transparent;color:var(--fg);font:inherit;font-size:.82rem;font-weight:650;cursor:pointer; }
  .rkd-reading-tools button:hover { background:var(--surface-2);color:var(--accent-ink); }
  .rkd-reading-tools button[aria-pressed="true"] { background:var(--accent-soft);color:var(--accent-ink); }
  .rkd-tool-divider { height:17px;width:1px;background:var(--border);margin:0 .25rem; }
  .rkd-tool-note { margin-left:auto;padding:0 .35rem;color:var(--fg-muted);font-size:.73rem; }
  .rkd-layout { display:grid;grid-template-columns:minmax(0,800px) minmax(0,210px);gap:clamp(1rem,3vw,2.75rem);align-items:start; }
  .rkd-layout.rkd-no-toc { display:block;max-width:820px; }
  .rkd-article { min-width:0; }
  .rkd-prose { min-width:0;max-width:100%;font-size:var(--reader-font);line-height:1.91;letter-spacing:.008em;overflow-wrap:break-word; }
  .rkd-prose :global(h1:first-child) { display:none; }
  .rkd-prose :global(p) { margin:1.05em 0;line-height:1.91; }
  .rkd-prose :global(h2) { font-size:1.42em;line-height:1.4;margin:2.6em 0 .9em;padding-bottom:.55em;border-bottom:1px solid var(--border);scroll-margin-top:88px;letter-spacing:-.015em; }
  .rkd-prose :global(h3) { font-size:1.13em;line-height:1.45;margin:2.15em 0 .8em;scroll-margin-top:88px;letter-spacing:-.01em; }
  .rkd-prose :global(h4) { margin:1.7em 0 .65em;scroll-margin-top:88px; }
  .rkd-prose :global(ul),.rkd-prose :global(ol) {padding-left:1.45em;}
  .rkd-prose :global(li) {margin:.45em 0;line-height:1.85;}
  .rkd-prose :global(li > p) {margin:.4em 0;}
  .rkd-prose :global(strong) {font-weight:700;}
  .rkd-prose :global(a) {text-decoration:underline;text-underline-offset:3px;text-decoration-color:color-mix(in srgb,var(--accent-ink) 38%,transparent);}
  .rkd-prose :global(a:hover) {text-decoration-color:var(--accent-ink);}
  .rkd-prose :global(blockquote) {margin:1.45rem 0;padding:.6rem 1rem;border-left:3px solid var(--accent);background:var(--surface-2);color:var(--fg-muted);border-radius:0 8px 8px 0;}
  .rkd-prose :global(blockquote p) {margin:.45em 0;}
  .rkd-prose :global(code:not(pre code)) { font-size:.86em;white-space:break-spaces; }
  .rkd-prose :global(pre) { max-width:100%;overflow-x:auto;margin:1.45rem 0;border:1px solid var(--border);border-radius:10px;font-size:.85em;line-height:1.62; }
  .rkd-prose :global(table) { display:block;width:max-content;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:1.6rem 0;font-size:.87em;line-height:1.65; }
  .rkd-prose :global(th),.rkd-prose :global(td) { padding:.65rem .8rem;min-width:95px;border-bottom:1px solid var(--border);text-align:left;vertical-align:top; }
  .rkd-prose :global(th) { background:var(--surface-2);font-weight:700; }
  .rkd-prose :global(.katex-display) { max-width:100%;overflow-x:auto;overflow-y:hidden;margin:1.4rem 0;padding:.65rem .35rem; }
  .rkd-prose :global(.katex) { font-size:1.01em; }
  .rkd-prose :global(hr) {border:0;border-top:1px solid var(--border);margin:2.4rem 0;}
  .rkd-aside { min-width:0; }
  .rkd-outline { position:sticky;top:90px;max-height:calc(100vh - 115px);overflow-y:auto;padding:0 .15rem .5rem .85rem; }
  .rkd-outline-title { font-size:.75rem;font-weight:750;letter-spacing:.04em;color:var(--fg-muted);margin:.25rem 0 .9rem; }
  .rkd-outline nav { display:flex;flex-direction:column;gap:2px;border-left:1px solid var(--border); }
  .rkd-outline nav a { color:var(--fg-muted);font-size:.78rem;line-height:1.6;padding:.35rem .55rem;border-left:2px solid transparent;margin-left:-1px;word-break:break-word; }
  .rkd-outline nav a:hover { color:var(--fg); }
  .rkd-outline nav a.is-current {color:var(--accent-ink);border-left-color:var(--accent);font-weight:700;}
  .rkd-outline nav a.rkd-toc-sub { padding-left:1.35rem;font-size:.745rem; }
  .rkd-top-shortcut {border:0;background:transparent;color:var(--fg-muted);padding:.8rem .1rem;font-size:.75rem;cursor:pointer;}
  .rkd-related {display:flex;flex-direction:column;gap:.65rem;border-top:1px solid var(--border);margin-top:3rem;padding-top:1.4rem;}
  .rkd-related h2 {font-size:1.04rem;margin:0 0 .3rem;}
  .rkd-related a {font-size:.9rem;line-height:1.55;}
  .rkd-foot {display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;border-top:1px solid var(--border);padding-top:1.6rem;margin-top:3rem;font-size:.87rem;}
  #rkd-back-top { position:fixed;right:1.25rem;bottom:1.4rem;width:40px;height:40px;border:1px solid var(--border);border-radius:12px;background:var(--surface);color:var(--fg);font:inherit;box-shadow:var(--shadow-sm);cursor:pointer;opacity:0;pointer-events:none;visibility:hidden;transition:opacity .16s ease; }
  #rkd-back-top.visible {opacity:1;pointer-events:auto;visibility:visible;}
  .rkd-mobile-toc {display:none;}
  .focus-mode .rkd-layout {display:block;max-width:800px;margin:0 auto;}
  .focus-mode .rkd-head {margin-left:auto;margin-right:auto;}
  .focus-mode .rkd-aside {display:none;}
  .focus-mode .rkd-mobile-toc {display:none;}
  @media (max-width:900px) {
    .rkd-layout {display:block;max-width:800px;margin:0 auto;}
    .rkd-aside {display:none;}
    .rkd-head {max-width:800px;}
    .rkd-mobile-toc {display:block;border:1px solid var(--border);border-radius:10px;background:var(--surface);margin:1rem 0 1.5rem;}
    .rkd-mobile-toc summary {cursor:pointer;padding:.7rem 1rem;font-size:.84rem;font-weight:650;}
    .rkd-mobile-toc nav {display:flex;flex-direction:column;gap:0;padding:.35rem 1rem 1rem;border-top:1px solid var(--border);max-height:45vh;overflow:auto;}
    .rkd-mobile-toc nav a {font-size:.83rem;padding:.35rem 0;line-height:1.55;}
    .rkd-mobile-toc nav a.rkd-toc-sub {padding-left:1rem;color:var(--fg-muted);}
  }
  @media (max-width:540px) {
    .rkd-breadcrumb {margin:1.1rem 0 1.5rem;}
    .rkd-head h1 {font-size:1.65rem;}
    .rkd-reading-tools {gap:.1rem;}
    .rkd-tool-label {display:none;}
    .rkd-tool-note {width:100%;margin:0 0 0 .3rem;}
    .rkd-prose {line-height:1.85;}
    .rkd-prose :global(h2) {font-size:1.3em;}
    #rkd-back-top {right:.7rem;bottom:1rem;}
  }
  @media (prefers-reduced-motion:reduce) { .rkd-progress,#rkd-back-top {transition:none;} }
</style>
