---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';
import Stars from '../../components/Stars.astro';
import { PROJECTS } from '../../data/projects';
import { PUB_GROUPS } from '../../data';
const researchHighlights = PUB_GROUPS.flatMap(g => g.papers).filter(p => p.code && ['LAMIC','TAG-WM'].some(name => p.titleEn.startsWith(name)));
---

<Base title="Projects">
  <h1 class="page-title"><Bi zh="项目" en="Projects" /></h1>
  <p class="page-intro">
    <Bi
      zh="我的公开项目与开源工具，持续维护更新。"
      en="Research projects and open-source tools I build and maintain."
    />
  </p>

  <section class="proj-section">
    <h2><Bi zh="公开研究实现" en="Public research implementations" /></h2>
    <p class="muted"><Bi zh="仅展示已公开的论文、代码和实验资源，不收录尚未公开的研究项目。" en="Only publicly released papers and code are listed; private research remains private." /></p>
    <div class="research-proj-grid">
      {researchHighlights.map(p=>(
        <article class="card research-proj">
          {p.image && <a href={p.url} target="_blank" rel="noopener noreferrer"><img src={p.image.replace(/\.png$/, '-thumb.jpg')} loading="lazy" decoding="async" alt={'方法示意：' + p.titleEn} /></a>}
          <div><span class="featured-venue">{p.venue}</span><h3>{p.titleEn}</h3><p class="muted"><span data-l="zh">{p.titleZh}</span><span data-l="en">{p.titleEn}</span></p>
            <div class="proj-links"><a href={p.url} target="_blank" rel="noopener noreferrer"><Bi zh="论文 ↗" en="Paper ↗" /></a>
            {p.code && <a href={'https://github.com/'+p.code} target="_blank" rel="noopener noreferrer"><Bi zh="代码 ↗" en="Code ↗" /></a>}</div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="proj-section">
    <h2><Bi zh="开源工具与开发项目" en="Open-source tools" /></h2>
    <p class="muted"><Bi zh="下方标签描述可以直接使用的功能，不再堆砌技术栈缩写。" en="Labels describe what each tool does, rather than generic tech-stack buzzwords." /></p>
    <div class="proj-grid">
    {PROJECTS.map((p) => (
      <div class="proj card">
        <div class="proj-head">
          {p.icon ? (
            <img class="proj-icon" src={p.icon} alt={`${p.name} logo`} loading="lazy" width="32" height="32" />
          ) : (
            <span class="proj-emoji">{p.emoji}</span>
          )}
          <h3 class="proj-name">{p.name}</h3>
          <Stars repo={p.repo} />
        </div>
        <p class="proj-desc"><span data-l="zh">{p.descZh}</span><span data-l="en">{p.descEn}</span></p>
        <div class="proj-tags">
          {p.featuresZh.map((t) => <span class="tag-chip" data-l="zh">{t}</span>)}
          {p.featuresEn.map((t) => <span class="tag-chip" data-l="en">{t}</span>)}
        </div>
        <div class="proj-links">
          <a class="repo-link" href={`https://github.com/${p.repo}`} target="_blank" rel="noopener">
            <span data-l="zh">代码仓库</span><span data-l="en">Repository</span>
          </a>
          {p.url && (
            <a class="demo-link" href={p.url} target="_blank" rel="noopener">
              <span data-l="zh">{p.url.includes('bilibili.com') ? '演示视频 →' : '在线体验 →'}</span><span data-l="en">{p.url.includes('bilibili.com') ? 'Demo video →' : 'Live demo →'}</span>
            </a>
          )}
        </div>
      </div>
    ))}
    </div>
  </section>
</Base>

<style>
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }
  .proj { padding: 1.2rem 1.4rem; display: flex; flex-direction: column; }
  .proj-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; }
  .proj-emoji { font-size: 1.5rem; line-height: 1; }
  .proj-icon {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .proj-name { margin: 0; font-size: 1.1rem; flex: 1; }
  .proj-desc { margin: 0 0 0.7rem; color: var(--fg-muted); font-size: 0.92rem; }
  .proj-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.9rem; }
  .proj-links { margin-top: auto; display: flex; align-items: center; gap: 1rem; }
  .repo-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent-ink);
    background: var(--accent-soft);
    padding: 0.24em 0.85em;
    border-radius: 999px;
    border: 1px solid transparent;
  }
  .repo-link:hover { text-decoration: none; border-color: var(--accent); }
  .demo-link { font-size: 0.82rem; font-weight: 700; }
</style>

<style>
  .proj-section {margin:2rem 0 2.7rem;}
  .proj-section>h2 {font-size:1.3rem;margin-bottom:.45rem;}
  .proj-section>p {margin:.3rem 0 1rem;font-size:.85rem;}
  .research-proj-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;}
  .research-proj {display:flex;flex-direction:column;gap:.7rem;}
  .research-proj img {display:block;width:100%;height:160px;object-fit:contain;background:var(--surface-2);border-radius:8px;}
  .research-proj h3 {font-size:1rem;line-height:1.5;margin:.35rem 0;}
  .research-proj p {font-size:.82rem;line-height:1.6;}
  .research-proj .proj-links {margin-top:.7rem;font-size:.85rem;}
  .featured-venue {font-size:.76rem;font-weight:700;color:var(--accent-ink);}
  @media(max-width:720px){.research-proj-grid{grid-template-columns:1fr;}.research-proj img{height:auto;max-height:210px;}}
</style>
