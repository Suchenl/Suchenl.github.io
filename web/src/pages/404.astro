---
import Base from '../layouts/Base.astro';
import Bi from '../components/Bi.astro';
---

<Base title="404" noindex={true}>
  <section class="nf">
    <p class="nf-code">404</p>
    <h1 class="nf-title"><Bi zh="页面走丢了" en="Page not found" /></h1>
    <p class="nf-desc">
      <Bi
        zh="你要找的页面不存在，或者已经被移动了。"
        en="The page you're looking for doesn't exist or has moved."
      />
    </p>
    <div class="nf-actions">
      <a class="btn btn-primary" href="/"><Bi zh="← 返回首页" en="← Back home" /></a>
      <a class="btn" href="/blog/"><Bi zh="去博客看看" en="Read the blog" /></a>
    </div>
  </section>
</Base>

<style>
  .nf { text-align: center; padding: 5rem 0 6rem; }
  .nf-code {
    font-size: clamp(4rem, 16vw, 8rem);
    font-weight: 900;
    line-height: 1;
    margin: 0;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.03em;
  }
  .nf-title { font-size: 1.6rem; margin: 0.6rem 0 0.4rem; }
  .nf-desc { color: var(--fg-muted); margin: 0 0 1.6rem; }
  .nf-actions { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; }
</style>
