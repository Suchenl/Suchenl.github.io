---
import Base from '../../layouts/Base.astro';
import Bi from '../../components/Bi.astro';
import { getPublicQuestions } from '../../lib/public-questions';

const questions = await getPublicQuestions();
---

<Base title="好奇的问题与探索" description="技术兴趣与研究问题：文献证据、路线对比、个人判断和仍值得探索的方向。">
  <header class="questions-header">
    <p class="questions-eyebrow">QUESTIONS & INTERESTS · CURIOSITY-DRIVEN EXPLORATION</p>
    <h1 class="page-title"><Bi zh="我好奇的问题与探索" en="Questions & Explorations" /></h1>
    <p class="questions-intro"><Bi zh="这里记录我持续好奇的技术兴趣与研究问题：已有工作走到哪里、不同路线怎样权衡，以及我更认可什么。兴趣综述不意味着原创声明，研究设想也不是已验证结论。" en="Technical interests and research questions: prior work, trade-offs, and current perspectives. An interest survey is not a novelty claim, and proposed ideas are not established findings." /></p>
  </header>
  <p class="question-scope"><Bi zh="精选开放研究问题，不重复收录技术问答和论文笔记。完整材料统一在 Research。" en="A curated selection of ongoing research questions; technical Q&A and paper notes live only in Research." /></p>
  <section class="question-list" aria-label="公开的研究兴趣与问题">
    {questions.map((q, i) => (
      <article class="question-entry card">
        <div class="question-top">
          <span class="question-num">{q.kind === 'interest' ? 'INTEREST' : 'QUESTION'} {String(i + 1).padStart(2, '0')}</span>
          <span class="question-state">{q.kind === 'interest' ? <Bi zh="兴趣专题" en="Interest survey" /> : <Bi zh="持续探索" en="Exploring" />}</span>
          <span class="question-domain">{q.domain.split("/").join(" / ")}</span>
        </div>
        <h2><a href={q.href}><span data-l="zh">{q.titleZh}</span><span data-l="en">{q.titleEn}</span></a></h2>
        <p><span data-l="zh">{q.summaryZh}</span><span data-l="en">{q.summaryEn}</span></p>
        <div class="question-bottom">
          <span>{q.kind === 'interest' ? <Bi zh="技术路线综述 · 个人判断" en="Technical survey · personal perspective" /> : <Bi zh="研究疑问 · 不是结论" en="Open question · not a finding" />}</span>
          <a href={q.href}>{q.kind === 'interest' ? <Bi zh="阅读技术路线、文献与思考 →" en="Read survey and perspectives →" /> : <Bi zh="阅读问题、文献与实验构想 →" en="Read evidence and experiments →" />}</a>
        </div>
      </article>
    ))}
  </section>
  <p class="question-note"><Bi zh="完整引用和研究过程只维护在研究知识库的对应 Markdown 中，避免重复更新。" en="Detailed evidence is maintained in one canonical Research Library note." /></p>
</Base>
<style>
  .questions-header { max-width: 830px; margin: 2.5rem 0 2.1rem; }
  .questions-eyebrow { color: var(--accent-ink); font-size: .76rem; font-weight: 780; letter-spacing: .09em; margin: 0; }
  .questions-header .page-title { margin: .55rem 0 .8rem; }
  .questions-intro { font-size: .97rem; line-height: 1.85; color: var(--fg-muted); }
  .question-list { display: grid; gap: 1.1rem; }
  .question-entry { padding: clamp(1.1rem, 3vw, 1.7rem); border-left: 3px solid var(--accent); }
  .question-top { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem .8rem; font-size: .74rem; color: var(--fg-muted); }
  .question-num { color: var(--accent-ink); font-weight: 800; letter-spacing: .075em; }
  .question-state { background: var(--accent-soft); padding: .09rem .55rem; border-radius: 99px; color: var(--accent-ink); font-weight: 720; }
  .question-scope {font-size:.88rem;color:var(--fg-muted);margin:-.4rem 0 1.5rem;}
  .question-domain {color:var(--fg-muted);font-size:.76rem;}
  .question-entry h2 { font-size: clamp(1.12rem, 2.3vw, 1.4rem); line-height: 1.48; margin: .8rem 0 .65rem; }
  .question-entry h2 a { color: var(--fg); }
  .question-entry h2 a:hover { color: var(--accent-ink); }
  .question-entry p { color: var(--fg-muted); line-height: 1.8; font-size: .92rem; margin: 0 0 1rem; }
  .question-bottom { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .6rem; padding-top: .8rem; border-top: 1px solid var(--border); font-size: .82rem; }
  .question-bottom span { color: var(--fg-muted); }
  .question-bottom a { font-weight: 740; }
  .question-note { color: var(--fg-muted); font-size: .81rem; margin: 1.3rem 0 3rem; }
</style>
