---
import '../styles/global.css';
import '../styles/reader.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, FEATURES } from '../config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = SITE.description, noindex = false, ogImage = '/images/og-cover.jpg', ogType = 'website', structuredData } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.titleZh} ${SITE.title}` : `${SITE.titleZh} ${SITE.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const ogImageURL = new URL(ogImage, Astro.site ?? SITE.url);
const safeStructuredData = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang={SITE.defaultLang} data-lang={SITE.defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="theme-color" content="#5b5bd6" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={`${SITE.titleZh} ${SITE.title}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {safeStructuredData && <script type="application/ld+json" set:html={safeStructuredData} />}
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <script is:inline>
      // Set language before paint to avoid a flash of the wrong language.
      (function () {
        try {
          var l = localStorage.getItem('lang') || 'zh';
          document.documentElement.setAttribute('data-lang', l);
          document.documentElement.setAttribute('lang', l === 'zh' ? 'zh-CN' : 'en');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-to-content" href="#main-content">跳到正文 / Skip to content</a>
    <Header />
    <main class="container" id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {FEATURES.goatcounter && !noindex && (
      <script
        data-goatcounter={`https://${FEATURES.goatcounter}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
    {FEATURES.cloudflareAnalytics?.beaconToken && !noindex && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: FEATURES.cloudflareAnalytics.beaconToken })}
      ></script>
    )}
  </body>
</html>
